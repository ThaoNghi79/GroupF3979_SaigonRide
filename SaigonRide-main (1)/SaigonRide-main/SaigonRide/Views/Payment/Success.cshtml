@model SaigonRide.Models.Rental
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Payment Success</title>
    <link rel="stylesheet" href="~/css/saigonride-ui.css" />
</head>
<body>
<div class="success-page">
    <div class="sr-page-label">Payment Success - Desktop</div>
    <section class="success-card">
        <div class="success-icon">✓</div>
        <h1>Payment Successful!</h1>
        <p>Thank you for riding with SaigonRide</p>
        <div class="success-grid">
            <div class="receipt-box">
                <h2>▣ Receipt Detail</h2>
                <p><span>Rental ID</span><b>#RIDE-@Model.RentalId.ToString("0000")</b></p>
                <p><span>Vehicle</span><b>@Model.Vehicle?.VehicleName</b></p>
                <p><span>Duration</span><b>@Model.StartTime.ToString("h:mm tt") to @(Model.EndTime?.ToString("h:mm tt")) @Model.DurationMinutes mins</b></p>
                <p><span>Base Fare</span><b>@Model.BaseFare.ToString("N0") VND</b></p>
                <p><span>Discount (15%)</span><b class="red">-@Model.DiscountAmount.ToString("N0") VND</b></p>
                <p><span>Total Amount</span><b class="purple">@Model.FinalFare.ToString("N0") VND</b></p>
                <p><span>Payment</span><b>@Model.Payment?.Method</b></p>
            </div>
            <div class="journey-box">
                <h2>📍 Your journey</h2>
                <div class="map-card">Start Point · · · · · · · @Model.DestinationStation?.StationName</div>
                <div class="eco-note">🚲 Awesome! You saved 0.5kg of CO2 today.</div>
                <div class="rating-box">How was your ride?<br /><span>★★★★☆</span></div>
            </div>
        </div>
        <div class="success-actions"><a href="/Rental/MyTrip">View My Rental</a><a href="/Rental/Rent">Return Home</a></div>
    </section>
</div>
</body>
</html>
