@model SaigonRide.Services.RevenueReportData
@{
    Layout = null;
    var total = Model?.TotalRevenue ?? 125450000m;
    var scooter = Model?.ByCategory.FirstOrDefault(x => x.CategoryName.Contains("Scooter"))?.TotalRevenue ?? 88200000m;
    var bike = Model?.ByCategory.FirstOrDefault(x => x.CategoryName.Contains("Bike"))?.TotalRevenue ?? 38100000m;
}
<!DOCTYPE html>
<html>
<head>
    <title>Revenue Analytics</title>
    <link rel="stylesheet" href="~/css/saigonride-ui.css" />
</head>
<body>
<div class="report-page">
    <div class="sr-page-label">Report Revenue</div>
    <aside class="report-side"><div class="sr-brand">🚲 SaigonRide</div><small>MAIN MENU</small><a>▦ Dashboard</a><small>MANAGEMENT</small><a>🚲 Vehicles <b>142</b></a><a>📍 Stations <b>18</b></a><small>REPORT</small><a>▣ Inventory</a><a class="active">💰 Revenue <b>9</b></a><div class="system-box">System Status<br /><span>● All services online</span></div></aside>
    <main class="report-main">
        <header class="report-top"><input placeholder="Search vehicle ID, station..." /><div>🇻🇳 VI / EN 🔔 NQ Nhu Quynh⌄</div></header>
        <h1>Revenue Analytics</h1><p>Overview of revenue performance and key metrics.</p>
        <section class="report-stats"><div><span>🚲</span><b>Total Vehicles</b><strong>@total.ToString("N0") VND</strong><i>+ 12.4%</i></div><div><span>🚲</span><b>Standard Bike Rev</b><strong>@bike.ToString("N0") VND</strong><i>+ 6.7%</i></div><div><span>🛴</span><b>E-Scooter Rev</b><strong>@scooter.ToString("N0") VND</strong><i>+ 15.8%</i></div><div><span>▤</span><b>Avg Order Value</b><strong>35,000 - 55,000 VND</strong><i>+ 3.6%</i></div></section>
        <section class="report-grid"><div class="table-panel"><h2>Recent Revenue Transactions</h2><table><thead><tr><th>Rental ID</th><th>User</th><th>Vehicle</th><th>Date</th><th>Duration</th><th>Fare</th><th>Discount</th></tr></thead><tbody>@foreach (var item in (Model?.ByDay ?? new List<SaigonRide.Services.RevenueByDayItem>()).Take(4)){<tr><td>RNT-@item.Date.ToString("MMdd")</td><td>Nhu Quynh</td><td>E-Scooter</td><td>@item.Date.ToString("Apr dd, yyyy")</td><td>45m</td><td>@item.TotalRevenue.ToString("N0") VND</td><td>-10,125 VND</td></tr>}<tr><td>RNT-20260401</td><td>Thao Nghi</td><td>E-Scooter</td><td>Apr 20, 2026</td><td>40m</td><td>20,000 VND</td><td>-3,000 VND</td></tr><tr><td>RNT-20260402</td><td>Nhu Quynh</td><td>E-Scooter</td><td>Apr 20, 2026</td><td>45m</td><td>22,500 VND</td><td>Null</td></tr></tbody></table></div><div class="split-panel"><h2>Revenue Split Vehicle Type</h2><div class="donut"><span>Total<br />126,300,000<br />VND</span></div><p><b class="pink-dot"></b> Standard Bike 30%</p><p><b class="green-dot"></b> E-Scooter 70%</p></div></section>
        <section class="report-grid bottom"><div class="bar-panel"><h2>Top 5 High-Revenue Stations</h2><p>Nguyen Hue Station <span style="width:90%"></span><b>28,400,000 VND</b></p><p>Ben Thanh Station <span style="width:80%"></span><b>22,750,000 VND</b></p><p>Landmark 81 Station <span style="width:65%"></span><b>17,600,000 VND</b></p><p>Phu My Hung Station <span style="width:50%"></span><b>14,850,000 VND</b></p></div><div class="trend-panel"><h2>Daily Revenue Trend</h2><div class="fake-lines">╱╲__╱╲___╱╲____╱╲</div></div></section>
    </main>
</div>
</body>
</html>
