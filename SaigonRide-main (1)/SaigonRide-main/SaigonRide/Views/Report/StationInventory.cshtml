@model IEnumerable<SaigonRide.Services.StationInventoryReportItem>
@{
    ViewData["Title"] = "Station Inventory & Capacity";
    ViewData["Page"] = "inventory";

    var list      = Model.ToList();
    int total     = list.Count;
    int balanced  = list.Count(s => s.IsBalanced);
    int lowInv    = list.Count(s => s.IsLowInventory);
    int overloaded= list.Count(s => s.IsOverloaded);
    var districts = list.Select(s => s.Location).Distinct().OrderBy(x => x).ToList();
}

@section Styles {
<style>
  /* Page title row — no banner */
  .page-title-row { display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:18px; }
  .page-title-row h1 { font-size:22px;font-weight:800;color:var(--text-main); }
  .page-title-row .sub { font-size:13px;color:var(--text-muted);margin-top:3px;font-weight:500; }
  .title-actions { display:flex;gap:10px; }
  .btn-outline { display:inline-flex;align-items:center;gap:7px;padding:9px 17px;border-radius:10px;border:1.5px solid var(--border);background:white;font-size:13px;font-weight:600;font-family:inherit;color:var(--text-main);cursor:pointer;transition:all 0.15s; }
  .btn-outline:hover { border-color:var(--primary); }
  .btn-outline-red { display:inline-flex;align-items:center;gap:7px;padding:9px 17px;border-radius:10px;border:1.5px solid rgba(229,90,126,0.5);background:white;font-size:13px;font-weight:600;font-family:inherit;color:#E55A7E;cursor:pointer;transition:all 0.15s; }
  .btn-outline-red:hover { background:#fde8f0; }

  /* KPI cards — 4 columns, equal height, all info aligned */
  .kpi-row { display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:16px; }
  .kpi-card {
    background:white; border:1px solid rgba(201,184,245,0.25);
    border-radius:14px; padding:16px 18px;
    display:flex; gap:14px; align-items:flex-start;
    min-height:120px;
  }
  .kpi-card.kpi-purple { background:linear-gradient(135deg,rgba(201,184,245,0.18),rgba(201,184,245,0.06)); border-color:rgba(201,184,245,0.45); }
  .kpi-card.kpi-green  { background:linear-gradient(135deg,rgba(52,199,123,0.12),rgba(52,199,123,0.04)); border-color:rgba(52,199,123,0.35); }
  .kpi-card.kpi-orange { background:linear-gradient(135deg,rgba(243,156,90,0.14),rgba(243,156,90,0.05)); border-color:rgba(243,156,90,0.4); }
  .kpi-card.kpi-red    { background:linear-gradient(135deg,rgba(229,90,126,0.12),rgba(229,90,126,0.04)); border-color:rgba(229,90,126,0.35); }

  .kpi-icon-wrap { width:52px;height:52px;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:28px; }
  .kpi-body { flex:1;min-width:0; }
  .kpi-label { font-size:12px;font-weight:700;margin-bottom:2px; }
  .kpi-purple .kpi-label { color:var(--primary-text); }
  .kpi-green  .kpi-label { color:#1b8d54; }
  .kpi-orange .kpi-label { color:#b86d2a; }
  .kpi-red    .kpi-label { color:#b73a5a; }
  .kpi-value { font-size:28px;font-weight:800;color:var(--text-main);line-height:1.1;letter-spacing:-0.5px;margin:2px 0 4px; }
  .kpi-sub   { font-size:11.5px;color:var(--text-muted);font-weight:600; }
  .kpi-discount { display:inline-block;font-size:10px;padding:2px 7px;border-radius:6px;background:rgba(243,156,90,0.2);color:#b86d2a;font-weight:700;margin-top:5px;line-height:1.4; }
  .kpi-trend { display:flex;align-items:center;gap:6px;font-size:11px;font-weight:700;margin-top:6px; }
  .trend-up { color:#1b8d54; }
  .trend-dn { color:#F39C5A; }
  .kpi-bar-wrap { flex:1;height:3px;background:rgba(201,184,245,0.18);border-radius:2px;overflow:hidden;max-width:60px; }
  .kpi-bar-fill { height:100%; }

  /* Chart + filter row */
  .chart-row { display:grid;grid-template-columns:1.85fr 1fr;gap:14px;margin-bottom:16px; }
  .chart-card { background:white;border:1px solid rgba(201,184,245,0.22);border-radius:16px;padding:18px 20px; }
  .chart-title { font-size:14px;font-weight:800;color:var(--text-main); }
  .chart-sub { font-size:11.5px;color:var(--text-muted);margin-top:2px;font-weight:500; }

  /* Custom bar chart — đậm màu hơn */
  .chart-area { display:grid;grid-template-columns:28px 1fr 110px;gap:8px;margin-top:14px;align-items:stretch; }
  .y-axis { display:flex;flex-direction:column;justify-content:space-between;height:200px;font-size:10px;color:var(--text-muted);text-align:right;padding-top:2px;padding-bottom:14px; }
  .chart-inner { position:relative; }
  .chart-bars {
    position:relative;height:200px;
    border-bottom:1px solid rgba(201,184,245,0.3);
  }
  /* Dashed threshold lines */
  .chart-bars::before {
    content:'';position:absolute;left:0;right:0;height:1px;top:20%;
    background-image:repeating-linear-gradient(to right,rgba(229,90,126,0.7) 0 5px,transparent 5px 10px);
  }
  .chart-bars::after {
    content:'';position:absolute;left:0;right:0;height:1px;top:80%;
    background-image:repeating-linear-gradient(to right,rgba(243,156,90,0.7) 0 5px,transparent 5px 10px);
  }
  .bars-grid { display:grid;grid-template-columns:repeat(10,1fr);gap:5px;height:100%;align-items:end;padding:0 4px; }
  /* Thanh đỏ đậm hơn */
  .bar-red { border-radius:4px 4px 0 0; background:linear-gradient(180deg,#E55A7E,#c73a5e); box-shadow:inset 0 -2px 0 rgba(0,0,0,0.08); }
  /* Thanh cam đậm hơn */
  .bar-amber { border-radius:4px 4px 0 0; background:linear-gradient(180deg,#F39C5A,#d4783a); box-shadow:inset 0 -2px 0 rgba(0,0,0,0.08); }
  .x-axis { display:grid;grid-template-columns:repeat(10,1fr);gap:5px;margin-top:6px;padding:0 4px;font-size:9.5px;color:var(--text-main);text-align:center; }
  .x-axis div { line-height:1.2;word-wrap:break-word; }

  .legend { display:flex;flex-direction:column;gap:6px;padding-top:4px; }
  .leg-item { display:flex;align-items:flex-start;gap:6px;font-size:11px;font-weight:600;color:var(--text-main);line-height:1.3; }
  .leg-sw { width:14px;height:10px;border-radius:3px;flex-shrink:0;margin-top:1px; }

  /* Filter card */
  .filter-card { background:white;border:1px solid rgba(201,184,245,0.22);border-radius:16px;padding:18px 20px; }
  .filter-card h4 { font-size:14px;font-weight:800;color:var(--text-main);margin-bottom:14px; }
  .fg-label { font-size:11.5px;font-weight:700;color:var(--text-main);display:block;margin-bottom:5px; }
  .fg-select {
    width:100%;padding:8px 32px 8px 12px;border:1px solid var(--border);border-radius:9px;
    font-size:12.5px;font-weight:600;color:var(--text-main);font-family:inherit;
    background:white;outline:none;cursor:pointer;margin-bottom:12px;
    appearance:none;
    background-image:url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 10 6%22><path d=%22M1 1l4 4 4-4%22 stroke=%22%238b80a8%22 stroke-width=%221.4%22 fill=%22none%22/></svg>');
    background-repeat:no-repeat;background-position:right 10px center;background-size:10px;
  }
  .fg-select:focus { border-color:var(--primary); }

  /* Table */
  .vtable-card { background:white;border:1px solid var(--border);border-radius:16px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,0.04); }
  .vtable-head { display:flex;justify-content:space-between;align-items:center;padding:16px 20px 12px;border-bottom:1px solid var(--border); }
  .vtable-head h3 { font-size:14px;font-weight:700;color:var(--text-main); }
  .vtable { width:100%;border-collapse:collapse; }
  .vtable th { font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.5px;color:var(--text-muted);padding:10px 16px;border-bottom:1px solid var(--border);text-align:left; }
  .vtable td { padding:11px 16px;border-bottom:1px solid var(--border);font-size:13px;vertical-align:middle; }
  .vtable tr:last-child td { border-bottom:none; }
  .vtable tr:hover td { background:#faf8ff; }

  .sp-overload  { background:#fdd8d8;color:#a33030; display:inline-block;padding:4px 10px;border-radius:20px;font-size:11.5px;font-weight:600; }
  .sp-balanced  { background:#d4f5e2;color:#276749; display:inline-block;padding:4px 10px;border-radius:20px;font-size:11.5px;font-weight:600; }
  .sp-lowinv    { background:rgba(243,156,90,0.25);color:#b86d2a; display:inline-block;padding:4px 10px;border-radius:20px;font-size:11.5px;font-weight:600; }

  .util-row { display:flex;align-items:center;gap:8px;min-width:130px; }
  .util-pct { font-size:12.5px;font-weight:700;min-width:38px; }
  .util-bar-wrap { flex:1;height:6px;background:#f3f4f6;border-radius:3px;overflow:hidden; }
  .util-bar-fill { height:100%;border-radius:3px; }

  .btn-relocate {
    height:27px;padding:0 11px;border-radius:7px;
    background:white;border:1px solid rgba(229,90,126,0.4);
    color:#E55A7E;font-size:11.5px;font-weight:700;cursor:pointer;
    display:inline-flex;align-items:center;gap:5px;font-family:inherit;
    transition:all 0.15s;
  }
  .btn-relocate:hover { background:#fde8f0; }

  .pag-bar { display:flex;justify-content:space-between;align-items:center;padding:10px 16px;border-top:1px solid var(--border); }
  .pag-info { font-size:12px;color:var(--text-muted); }
  .pag-btns { display:flex;gap:4px; }
  .pag-btn { width:28px;height:28px;border:1px solid var(--border);border-radius:7px;background:white;font-size:12px;display:flex;align-items:center;justify-content:center;cursor:pointer;font-family:inherit;transition:all 0.15s; }
  .pag-btn.active { background:var(--gradient);color:var(--text-main);border-color:transparent;font-weight:700; }
</style>
}

<!-- PAGE TITLE ROW — không có banner tím như Figma -->
<div class="page-title-row">
  <div>
    <h1 data-i18n="Station Inventory & Capacity">Station Inventory &amp; Capacity</h1>
    <div class="sub" data-i18n="Real-time overview of station capacity and vehicle availability">
      Real-time overview of station capacity and vehicle availability
    </div>
  </div>
  <div class="title-actions">
    <button class="btn-outline" onclick="exportCSV()">
      <i class="fas fa-download"></i>
      <span data-i18n="Export CSV">Export CSV</span>
    </button>
    <button class="btn-outline-red" onclick="window.print()">
      <i class="fas fa-file-pdf"></i>
      <span data-i18n="Export PDF">Export PDF</span>
    </button>
  </div>
</div>

<!-- KPI CARDS — 4 cột cân đối -->
<div class="kpi-row">

  <!-- Total Stations -->
  <div class="kpi-card kpi-purple">
    <div class="kpi-icon-wrap">🚉</div>
    <div class="kpi-body">
      <div class="kpi-label" data-i18n="Total Stations">Total Stations</div>
      <div class="kpi-value">@total</div>
      <div class="kpi-sub" data-i18n="Across all district">Across all district</div>
      <div class="kpi-trend">
        <span class="trend-up">▲ +8</span>
        <span style="color:var(--text-muted);">This month</span>
        <div class="kpi-bar-wrap"><div class="kpi-bar-fill" style="width:60%;background:#B89DF0;"></div></div>
      </div>
    </div>
  </div>

  <!-- Balanced -->
  <div class="kpi-card kpi-green">
    <div class="kpi-icon-wrap">✅</div>
    <div class="kpi-body">
      <div class="kpi-label" data-i18n="Balanced (20-90%)">Balanced (20-90%)</div>
      <div class="kpi-value">@balanced</div>
      <div class="kpi-sub">@(total>0?Math.Round((double)balanced/total*100,2):0)% of total</div>
      <div class="kpi-trend">
        <span class="trend-up">▲ +8 %</span>
        <div class="kpi-bar-wrap"><div class="kpi-bar-fill" style="width:@(total>0?(int)((double)balanced/total*100):0)%;background:#34C77B;"></div></div>
      </div>
    </div>
  </div>

  <!-- Low Inventory -->
  <div class="kpi-card kpi-orange">
    <div class="kpi-icon-wrap">
      <svg viewBox="0 0 56 56" width="44" height="44" fill="none">
        <path d="M28 6 52 50H4L28 6Z" fill="#FFC78A" stroke="#d4783a" stroke-width="2" stroke-linejoin="round"/>
        <path d="M28 24v11" stroke="#8b4500" stroke-width="3.5" stroke-linecap="round"/>
        <circle cx="28" cy="43" r="2.5" fill="#8b4500"/>
      </svg>
    </div>
    <div class="kpi-body">
      <div class="kpi-label" data-i18n="Low Inventory (&lt;20%)">Low Inventory (&lt;20%)</div>
      <div class="kpi-value">@lowInv</div>
      <div class="kpi-sub" style="color:#b86d2a;">
        @(total>0?Math.Round((double)lowInv/total*100,2):0)%
        <span style="color:var(--text-muted);font-weight:500;"> of total</span>
      </div>
      <div class="kpi-discount" data-i18n="15% DISCOUNT applies here!">
        15% DISCOUNT for users returning vehicles to these stations
      </div>
      <div class="kpi-trend" style="margin-top:4px;">
        <span class="trend-up">▲ +8 %</span>
        <div class="kpi-bar-wrap"><div class="kpi-bar-fill" style="width:@(total>0?(int)((double)lowInv/total*100):0)%;background:#F39C5A;"></div></div>
      </div>
    </div>
  </div>

  <!-- Overloaded -->
  <div class="kpi-card kpi-red">
    <div class="kpi-icon-wrap">🔴</div>
    <div class="kpi-body">
      <div class="kpi-label" data-i18n="Full/Overloaded (&gt;90%)">Full/Overloaded (&gt;90%)</div>
      <div class="kpi-value">@overloaded</div>
      <div class="kpi-sub">@(total>0?Math.Round((double)overloaded/total*100,2):0)% of total</div>
      <div class="kpi-trend">
        <span class="trend-dn">▼ Reduce 8%</span>
        <div class="kpi-bar-wrap"><div class="kpi-bar-fill" style="width:@(total>0?(int)((double)overloaded/total*100):0)%;background:#E55A7E;"></div></div>
      </div>
    </div>
  </div>

</div>

<!-- CHART + FILTER -->
<div class="chart-row">

  <!-- Bar Chart — màu đậm hơn, đúng Figma -->
  <div class="chart-card">
    <div class="chart-title" data-i18n="Capacity vs. Utilization by Station">Capacity vs. Utilization by Station</div>
    <div class="chart-sub">Displaying Top 10 critical stations (sorted by utilization %, ties broken by capacity)</div>
    <div class="chart-area">
      <!-- Y axis -->
      <div class="y-axis">
        <div>100</div><div>80</div><div>60</div><div>40</div><div>20</div><div>0</div>
      </div>
      <!-- Bars -->
      <div class="chart-inner">
        <div class="chart-bars">
          <div class="bars-grid">
            @{
              var top10 = list.OrderByDescending(x => x.UtilizationPercent).Take(10).ToList();
              foreach (var s in top10)
              {
                string barClass = s.IsLowInventory ? "bar-amber" : "bar-red";
                int h = (int)Math.Min(s.UtilizationPercent, 100);
                <div class="@barClass" style="height:@h%;"></div>
              }
              // Pad if less than 10
              for (int i = top10.Count; i < 10; i++)
              {
                <div class="bar-red" style="height:5%;opacity:0.2;"></div>
              }
            }
          </div>
        </div>
        <div class="x-axis">
          @foreach (var s in top10)
          {
            string shortName = s.StationName.Length > 9 ? s.StationName.Substring(0, 9) + "…" : s.StationName;
            <div>@shortName</div>
          }
          @for (int i = top10.Count; i < 10; i++) { <div></div> }
        </div>
      </div>
      <!-- Legend -->
      <div class="legend">
        <div class="leg-item">
          <span class="leg-sw" style="background:#E55A7E;"></span>
          <span>Low Inventory<br/>(&gt;90%)</span>
        </div>
        <div class="leg-item" style="margin-top:50px;">
          <span class="leg-sw" style="background:#F39C5A;"></span>
          <span>Low Inventory<br/>(&lt;20%)</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Filter Panel — 3 dropdown đúng Figma -->
  <div class="filter-card">
    <h4 data-i18n="Filter">Filter</h4>

    <label class="fg-label">District / Area</label>
    <select class="fg-select" id="filterDistrict" onchange="applyFilter()">
      <option value="">All Districts</option>
      @foreach (var d in districts)
      {
        <option value="@d.ToLower()">@d</option>
      }
    </select>

    <label class="fg-label">Status</label>
    <select class="fg-select" id="filterStatus" onchange="applyFilter()">
      <option value="">All Status</option>
      <option value="balanced">Balanced</option>
      <option value="lowinventory">Low Inventory</option>
      <option value="overload">Overload</option>
    </select>

    <label class="fg-label">Utilization Range</label>
    <select class="fg-select" id="filterRange" onchange="applyFilter()" style="background-color:rgba(201,184,245,0.08);">
      <option value="">All Range</option>
      <option value="low">0% – 20% (Low)</option>
      <option value="mid">20% – 90% (Balanced)</option>
      <option value="high">90%+ (Overload)</option>
    </select>
  </div>

</div>

<!-- DETAIL TABLE -->
<div class="vtable-card">
  <div class="vtable-head">
    <h3 data-i18n="Station Inventory Details">Station Inventory Details</h3>
    <span style="font-size:12.5px;color:var(--text-muted);" id="showingCount">
      Showing @list.Count of @total stations
    </span>
  </div>

  <div style="overflow-x:auto;">
    <table class="vtable" id="reportTable">
      <thead>
        <tr>
          <th data-i18n="Station Name">Station Name</th>
          <th style="text-align:center;">Current Bike</th>
          <th style="text-align:center;">Current E-Scooter</th>
          <th style="text-align:center;" data-i18n="Capacity">Total Capacity</th>
          <th style="text-align:center;" data-i18n="Available Slots">Available Slots</th>
          <th data-i18n="Utilization %">Utilization %</th>
          <th data-i18n="STATUS">Status</th>
          <th style="text-align:center;" data-i18n="Actions">Actions</th>
        </tr>
      </thead>
      <tbody id="reportBody">
        @foreach (var s in list.OrderByDescending(x => x.UtilizationPercent))
        {
          string utilColor  = s.IsOverloaded ? "#E55A7E" : s.IsLowInventory ? "#F39C5A" : "#34C77B";
          string statusKey  = s.IsOverloaded ? "overload" : s.IsLowInventory ? "lowinventory" : "balanced";
          string rangeKey   = s.IsOverloaded ? "high" : s.IsLowInventory ? "low" : "mid";
          string badgeSpan  = s.IsOverloaded ? "sp-overload Overload" : s.IsLowInventory ? "sp-lowinv Low Inventory" : "sp-balanced Balanced";
          var bParts        = badgeSpan.Split(' ', 2);

          <tr data-status="@statusKey"
              data-range="@rangeKey"
              data-district="@s.Location.ToLower()">
            <td style="font-weight:600;">@s.StationName</td>
            <td style="text-align:center;font-weight:600;">@s.BikeCount</td>
            <td style="text-align:center;font-weight:600;">@s.ScooterCount</td>
            <td style="text-align:center;font-weight:600;">@s.Capacity</td>
            <td style="text-align:center;font-weight:700;
                color:@(s.AvailableSlots == 0 ? "#E55A7E" : s.AvailableSlots <= 3 ? "#F39C5A" : "#34C77B");">
              @s.AvailableSlots
            </td>
            <td>
              <div class="util-row">
                <span class="util-pct" style="color:@utilColor;">@s.UtilizationPercent%</span>
                <div class="util-bar-wrap">
                  <div class="util-bar-fill" style="width:@(Math.Min(s.UtilizationPercent,100))%;background:@utilColor;"></div>
                </div>
              </div>
            </td>
            <td><span class="@bParts[0]">@bParts[1]</span></td>
            <td style="text-align:center;">
              <button class="btn-relocate">
                <svg width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M2 7h10M9 4l3 3-3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span data-i18n="Relocate">Relocate</span>
              </button>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>

  <!-- Pagination -->
  <div class="pag-bar">
    <div class="pag-info">Page 1 of @(Math.Max(1,(int)Math.Ceiling((double)total/7))) — @total stations total</div>
    <div class="pag-btns">
      <button class="pag-btn"><i class="fas fa-chevron-left" style="font-size:10px;"></i></button>
      <button class="pag-btn active">1</button>
      <button class="pag-btn">2</button>
      <button class="pag-btn">3</button>
      <span style="padding:0 4px;color:var(--text-muted);">…</span>
      <button class="pag-btn">@(Math.Max(1,(int)Math.Ceiling((double)total/7)))</button>
      <button class="pag-btn"><i class="fas fa-chevron-right" style="font-size:10px;"></i></button>
    </div>
  </div>
</div>

@section Scripts {
<script>
// Filter tự động khi chọn dropdown
function applyFilter(){
  const dist  = document.getElementById('filterDistrict').value.toLowerCase();
  const status= document.getElementById('filterStatus').value;
  const range = document.getElementById('filterRange').value;
  let vis = 0;
  document.querySelectorAll('#reportBody tr').forEach(row => {
    const rD = (row.dataset.district || '').toLowerCase();
    const rS = row.dataset.status   || '';
    const rR = row.dataset.range    || '';
    const show = (!dist || rD.includes(dist)) &&
                 (!status || rS === status) &&
                 (!range  || rR === range);
    row.style.display = show ? '' : 'none';
    if (show) vis++;
  });
  document.getElementById('showingCount').textContent = `Showing ${vis} of @total stations`;
}

function exportCSV(){
  const rows = [['Station','Bike','Scooter','Capacity','Available','Utilization%','Status']];
  document.querySelectorAll('#reportBody tr').forEach(row => {
    if(row.style.display==='none')return;
    const c = row.querySelectorAll('td');
    if(c.length<7)return;
    rows.push([...c].slice(0,7).map(x=>`"${x.textContent.trim().replace(/"/g,'""')}"`));
  });
  const a = document.createElement('a');
  a.href = 'data:text/csv;charset=utf-8,\uFEFF' + encodeURIComponent(rows.map(r=>r.join(',')).join('\n'));
  a.download = `station_inventory_${new Date().toISOString().slice(0,10)}.csv`;
  a.click();
}
</script>
}
