@model IEnumerable<SaigonRide.Models.Rental>
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Page"] = "dashboard";
}

@section Styles {
    <style>
        /* Hero */
        .hero {
            background: linear-gradient(135deg, #C9B8F5 0%, #d8c0e8 50%, #F5B8D0 100%);
            border-radius: 18px;
            padding: 26px 28px;
            display: grid;
            grid-template-columns: 1fr 1.05fr;
            gap: 22px;
            min-height: 220px;
            margin-bottom: 20px;
        }

        .hero-text {
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: 14px;
        }

        .hero-eyebrow {
            font-size: 10.5px;
            font-weight: 800;
            letter-spacing: 2px;
            color: rgba(61,53,87,0.65);
            text-transform: uppercase;
        }

        .hero-title {
            font-size: 30px;
            font-weight: 800;
            color: #2D2640;
            line-height: 1.15;
        }

        .hero-desc {
            font-size: 13.5px;
            color: rgba(61,53,87,0.72);
            font-weight: 500;
            max-width: 360px;
            line-height: 1.5;
        }

        .hero-cta {
            display: flex;
            gap: 10px;
            margin-top: 6px;
        }

        .btn-hero-dark {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 10px 18px;
            border-radius: 12px;
            background: rgba(45,38,64,0.75);
            color: white;
            border: none;
            font-size: 13px;
            font-weight: 700;
            font-family: inherit;
            cursor: pointer;
            transition: all 0.15s;
            backdrop-filter: blur(4px);
            text-decoration: none; /* ĐÃ FIX GẠCH CHÂN */
        }

            .btn-hero-dark:hover {
                background: rgba(45,38,64,0.9);
                color: white;
            }

        .btn-hero-light {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 10px 18px;
            border-radius: 12px;
            background: rgba(255,255,255,0.55);
            color: #2D2640;
            border: 1px solid rgba(255,255,255,0.7);
            font-size: 13px;
            font-weight: 700;
            font-family: inherit;
            cursor: pointer;
            transition: all 0.15s;
            backdrop-filter: blur(4px);
            text-decoration: none; /* ĐÃ FIX GẠCH CHÂN */
        }

            .btn-hero-light:hover {
                background: rgba(255,255,255,0.75);
                color: #2D2640;
            }

        /* Map thumbnail */
        .map-wrap {
            position: relative;
            border-radius: 14px;
            overflow: hidden;
            background: #f3ecde;
            border: 2px solid rgba(255,255,255,0.6);
            min-height: 200px;
        }

        .map-bg {
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 30% 50%, rgba(180,210,160,0.5) 0%, transparent 28%), radial-gradient(circle at 70% 30%, rgba(180,210,160,0.4) 0%, transparent 22%), linear-gradient(120deg, #efe6d2 0%, #f5ecd6 50%, #f0e8d0 100%);
        }

        .map-pin-dot {
            position: absolute;
            transform: translate(-50%,-50%);
            width: 13px;
            height: 13px;
            border-radius: 50%;
            border: 2px solid white;
            box-shadow: 0 1px 4px rgba(0,0,0,0.18);
        }

        .map-tags {
            position: absolute;
            right: 12px;
            top: 14px;
            display: flex;
            flex-direction: column;
            gap: 7px;
        }

        .map-tag {
            background: white;
            border: 1px solid rgba(201,184,245,0.4);
            padding: 5px 12px 5px 24px;
            border-radius: 14px;
            font-size: 12px;
            font-weight: 700;
            color: #2D2640;
            position: relative;
            box-shadow: 0 2px 6px rgba(45,38,64,0.06);
        }

            .map-tag::before {
                content: '';
                position: absolute;
                left: 9px;
                top: 50%;
                transform: translateY(-50%);
                width: 8px;
                height: 8px;
                border-radius: 50%;
            }

            .map-tag.av::before {
                background: #34C77B;
            }

            .map-tag.lo::before {
                background: #F39C5A;
            }

            .map-tag.tr::before {
                background: #E55A7E;
            }

        /* Stats row */
        .stats-row {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 14px;
            margin-bottom: 20px;
        }

        .stat-card-dash {
            background: white;
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 18px 20px;
            box-shadow: 0 1px 4px rgba(0,0,0,0.04);
        }

        .stat-icon-wrap {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            margin-bottom: 10px;
        }

        .stat-label-dash {
            font-size: 12px;
            color: var(--text-muted);
            font-weight: 500;
            margin-bottom: 4px;
        }

        .stat-value-dash {
            font-size: 28px;
            font-weight: 800;
            line-height: 1;
            margin-bottom: 5px;
        }

        .stat-trend {
            font-size: 11.5px;
            font-weight: 600;
        }

            .stat-trend.up {
                color: var(--success);
            }

            .stat-trend.live {
                color: var(--danger);
            }

            .stat-trend.warn {
                color: var(--warning);
            }

        .stat-bar-dash {
            height: 3px;
            border-radius: 2px;
            margin-top: 10px;
        }

        /* Recent Activity table card */
        .table-card-dash {
            background: white;
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 0;
            overflow: hidden;
            box-shadow: 0 1px 4px rgba(0,0,0,0.04);
        }

        .table-head-dash {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 18px 20px 14px;
            border-bottom: 1px solid var(--border);
        }

            .table-head-dash h3 {
                font-size: 15px;
                font-weight: 700;
                color: var(--text-main);
            }

            .table-head-dash .sub-label {
                font-size: 12px;
                color: var(--text-muted);
                margin-top: 2px;
            }

        .tabs-dash {
            display: flex;
            gap: 4px;
        }

        .tab-btn {
            padding: 5px 12px;
            border-radius: 8px;
            border: 1px solid var(--border);
            background: white;
            font-size: 12px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            color: var(--text-muted);
            transition: all 0.15s;
        }

            .tab-btn.active {
                background: var(--gradient);
                color: var(--text-main);
                border-color: transparent;
            }

        .view-all-link {
            font-size: 12px;
            color: var(--text-muted);
            font-weight: 600;
            cursor: pointer;
            margin-left: 6px;
            text-decoration: none;
        }

            .view-all-link:hover {
                color: var(--primary-text);
            }

        .dash-table {
            width: 100%;
            border-collapse: collapse;
        }

            .dash-table th {
                font-size: 11px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                color: var(--text-muted);
                padding: 10px 20px;
                border-bottom: 1px solid var(--border);
                text-align: left;
            }

            .dash-table td {
                padding: 12px 20px;
                border-bottom: 1px solid var(--border);
                font-size: 13px;
                vertical-align: middle;
            }

            .dash-table tr:last-child td {
                border-bottom: none;
            }

            .dash-table tr:hover td {
                background: #f9f7ff;
            }

        .user-chip {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 26px;
            height: 26px;
            border-radius: 50%;
            font-size: 10px;
            font-weight: 800;
            color: white;
            margin-right: 8px;
            vertical-align: middle;
            flex-shrink: 0;
        }

        .veh-tag {
            display: inline-block;
            padding: 3px 9px;
            border-radius: 6px;
            font-size: 11.5px;
            font-weight: 700;
        }

            .veh-tag.scooter {
                background: rgba(201,184,245,0.25);
                color: #7c5cbf;
                border: 1px solid rgba(201,184,245,0.5);
            }

            .veh-tag.bike {
                background: rgba(255,212,163,0.35);
                color: #b86d2a;
                border: 1px solid rgba(243,156,90,0.4);
            }

        .fare-discount {
            font-size: 10.5px;
            color: var(--danger);
            margin-left: 4px;
            font-weight: 700;
        }
    </style>
}

<!-- HERO BANNER -->
<section class="hero">
    <div class="hero-text">
        <div class="hero-eyebrow" data-i18n="FLEET OVERVIEW">FLEET OVERVIEW</div>
        <h1 class="hero-title" data-i18n="Find a Vehicle Near You">Tìm xe gần bạn</h1>
        <p class="hero-desc" data-i18n="Track live vehicle availability across all 52 stations in Ho Chi Minh City.">
            Theo dõi lượng xe khả dụng tại các trạm xe điện trên toàn TP Hồ Chí Minh.
        </p>
        <div class="hero-cta">
            <a href="/Dashboard/Map" class="btn-hero-dark">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M8 1.5s5 4.5 5 8a5 5 0 0 1-10 0c0-3.5 5-8 5-8Z" stroke="white" stroke-width="1.4" stroke-linejoin="round" /><circle cx="8" cy="8.5" r="1.8" stroke="white" stroke-width="1.4" /></svg>
                <span data-i18n="View Live Map">Xem bản đồ</span>
            </a>
            <a href="/Vehicle" class="btn-hero-light">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><rect x="2" y="3" width="12" height="10" rx="1.5" stroke="#2D2640" stroke-width="1.4" /><path d="M2 6h12" stroke="#2D2640" stroke-width="1.4" /></svg>
                <span data-i18n="Manage Fleet">Quản lý Đội xe</span>
            </a>
        </div>
    </div>

    <!-- Map thumbnail (Giữ nguyên) -->
    <div class="map-wrap">
        <div class="map-bg"></div>
        <svg style="position:absolute;inset:0;width:100%;height:100%;" viewBox="0 0 600 280" preserveAspectRatio="none">
            <path d="M-10 210 Q 80 170 180 200 T 380 190 T 620 225" stroke="#a8d4f5" stroke-width="12" fill="none" opacity="0.55" />
            <path d="M0 85 L600 105" stroke="white" stroke-width="5.5" opacity="0.85" />
            <path d="M0 155 L600 145" stroke="white" stroke-width="4.5" opacity="0.8" />
            <path d="M120 0 L150 280" stroke="white" stroke-width="5.5" opacity="0.85" />
            <path d="M290 0 L320 280" stroke="white" stroke-width="4.5" opacity="0.8" />
            <path d="M440 0 L460 280" stroke="white" stroke-width="4.5" opacity="0.8" />
            <path d="M0 48 L600 58" stroke="white" stroke-width="2" opacity="0.55" />
            <path d="M0 238 L600 248" stroke="white" stroke-width="2" opacity="0.55" />
            <path d="M60 0 L75 280" stroke="white" stroke-width="2" opacity="0.55" />
            <path d="M220 0 L235 280" stroke="white" stroke-width="2" opacity="0.55" />
            <path d="M380 0 L395 280" stroke="white" stroke-width="2" opacity="0.55" />
            <path d="M530 0 L545 280" stroke="white" stroke-width="2" opacity="0.55" />
            <rect x="155" y="110" width="58" height="32" fill="white" opacity="0.16" />
            <rect x="325" y="52" width="48" height="48" fill="white" opacity="0.13" />
            <rect x="465" y="162" width="58" height="38" fill="white" opacity="0.13" />
            <text x="36" y="38" font-family="sans-serif" font-size="8" fill="#7a7058" opacity="0.65">KHU PHỐ 1</text>
            <text x="235" y="33" font-family="sans-serif" font-size="8" fill="#7a7058" opacity="0.65">KHU PHỐ 2</text>
            <text x="425" y="38" font-family="sans-serif" font-size="8" fill="#7a7058" opacity="0.65">KHU PHỐ 3</text>
            <text x="36" y="268" font-family="sans-serif" font-size="7.5" fill="#7a7058" opacity="0.55">Quận 1</text>
            <text x="235" y="272" font-family="sans-serif" font-size="7.5" fill="#7a7058" opacity="0.55">Quận 3</text>
            <text x="425" y="272" font-family="sans-serif" font-size="7.5" fill="#7a7058" opacity="0.55">Bình Thạnh</text>
        </svg>
        <div class="map-pin-dot" style="left:18%;top:25%;background:#34C77B;"></div>
        <div class="map-pin-dot" style="left:42%;top:40%;background:#34C77B;"></div>
        <div class="map-pin-dot" style="left:62%;top:18%;background:#E55A7E;"></div>
        <div class="map-pin-dot" style="left:30%;top:62%;background:#34C77B;"></div>
        <div class="map-pin-dot" style="left:55%;top:70%;background:#F39C5A;"></div>
        <div class="map-pin-dot" style="left:80%;top:50%;background:#34C77B;"></div>
        <div class="map-pin-dot" style="left:75%;top:80%;background:#E55A7E;"></div>
        <div class="map-pin-dot" style="left:13%;top:75%;background:#34C77B;"></div>
        <div class="map-tags">
            <div class="map-tag av" data-i18n="Available">Available</div>
            <div class="map-tag lo" data-i18n="Low Stock">Low Stock</div>
            <div class="map-tag tr" data-i18n="In transit">In transit</div>
        </div>
    </div>
</section>

<!-- STATS ROW -->
<div class="stats-row">
    <!-- Total Vehicles -->
    <div class="stat-card-dash">
        <div class="stat-icon-wrap" style="background:#ede9fa;">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" style="color:#7c5cbf;"><circle cx="6" cy="14" r="3.2" stroke="currentColor" stroke-width="1.5" /><circle cx="14" cy="14" r="3.2" stroke="currentColor" stroke-width="1.5" /><path d="M6 14 9 7l2.5 4 2.5 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /><path d="M9 7h2M12 5l1.5 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
        </div>
        <div class="stat-label-dash" data-i18n="Total Vehicles">Total Vehicles</div>
        <div class="stat-value-dash" style="color:var(--primary-text);">@(ViewBag.TotalVehicles ?? 0)</div>
        <div class="stat-trend up">▲ <span data-i18n="+8 this week">+8 this week</span></div>
        <div class="stat-bar-dash" style="background:var(--gradient);width:78%;"></div>
    </div>

    <!-- Active Rentals -->
    <div class="stat-card-dash">
        <div class="stat-icon-wrap" style="background:#fde8f0;">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" style="color:#E55A7E;"><circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.5" /><path d="M10 6v4l2.5 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
        </div>
        <div class="stat-label-dash" data-i18n="Active Rentals">Active Rentals</div>
        <div class="stat-value-dash" style="color:#E55A7E;">@(ViewBag.ActiveRentals ?? 0)</div>
        <div class="stat-trend live">● <span data-i18n="Live now">Live now</span></div>
        <div class="stat-bar-dash" style="background:#E55A7E;width:55%;"></div>
    </div>

    <!-- Total Revenue -->
    <div class="stat-card-dash">
        <div class="stat-icon-wrap" style="background:var(--accent-yellow);">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" style="color:#b86d2a;"><rect x="3" y="6" width="14" height="10" rx="1.5" stroke="currentColor" stroke-width="1.5" /><path d="M3 9h14" stroke="currentColor" stroke-width="1.5" /><circle cx="13.5" cy="12.5" r="1" fill="currentColor" /></svg>
        </div>
        <div class="stat-label-dash" data-i18n="Total Revenue">Total Revenue</div>
        <div class="stat-value-dash" style="color:#b86d2a;font-size:22px;">₫ @string.Format("{0:N0}", ViewBag.TotalRevenue ?? 0)</div>
        <div class="stat-trend up">▲ <span data-i18n="+12% vs last week">+12% vs last week</span></div>
        <div class="stat-bar-dash" style="background:var(--accent-warm);width:88%;"></div>
    </div>

    <!-- Low Inventory Stations -->
    <div class="stat-card-dash">
        <div class="stat-icon-wrap" style="background:var(--accent-warm);">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" style="color:#b86d2a;"><circle cx="10" cy="10" r="7.2" stroke="currentColor" stroke-width="1.5" /><path d="M10 6.5v4M10 13.2v.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
        </div>
        <div class="stat-label-dash" data-i18n="Low Inventory Stations">Low Inventory Stations</div>
        <div class="stat-value-dash" style="color:var(--warning);">@(ViewBag.LowInventoryStations ?? 0)</div>
        <div class="stat-trend warn">▼ <span data-i18n="Needs rebalancing">Needs rebalancing</span></div>
        <div class="stat-bar-dash" style="background:var(--warning);width:30%;"></div>
    </div>
</div>

<!-- RECENT ACTIVITY -->
<div class="table-card-dash">
    <div class="table-head-dash">
        <div>
            <h3 data-i18n="Recent Activity">Recent Activity</h3>
            <div class="sub-label" data-i18n="Last 5 rental transactions">5 giao dịch gần nhất từ CSDL</div>
        </div>
        <div style="display:flex;align-items:center;gap:6px;">
            <div class="tabs-dash">
                <!-- ĐÃ THÊM ONCLICK ĐỂ LỌC -->
                <button class="tab-btn active" onclick="filterActivity('All', this)" data-i18n="All">Tất cả</button>
                <button class="tab-btn" onclick="filterActivity('Active', this)" data-i18n="Active">Đang thuê</button>
                <button class="tab-btn" onclick="filterActivity('Completed', this)" data-i18n="Completed">Hoàn thành</button>
            </div>
            <a href="#" class="view-all-link" data-i18n="View all">Xem tất cả →</a>
        </div>
    </div>

    <table class="dash-table">
        <thead>
            <tr>
                <th data-i18n="USER">NGƯỜI DÙNG</th>
                <th data-i18n="VEHICLE">PHƯƠNG TIỆN</th>
                <th data-i18n="START STATION">TRẠM ĐI</th>
                <th data-i18n="END STATION">TRẠM ĐẾN</th>
                <th data-i18n="DURATION / TIME">THỜI GIAN ĐẶT</th>
                <th data-i18n="FARE">GIÁ CƯỚC</th>
                <th data-i18n="STATUS">TRẠNG THÁI</th>
            </tr>
        </thead>
        <tbody id="activityTableBody">
            <!-- ĐÃ FIX ĐỔ DỮ LIỆU THẬT -->
            @if (Model != null && Model.Any())
            {
                var colors = new[] { "#C9B8F5", "#F5B8D0", "#FFD4A3", "#a8d4f5", "#d4f5e2" };
                int i = 0;
                foreach (var a in Model)
                {
                    var color = colors[i % colors.Length];
                    var userName = a.User?.FullName ?? "Unknown User";
                    var initials = userName.Length >= 2 ? userName.Substring(0, 2).ToUpper() : "US";

                    var statusText = a.Status == SaigonRide.Models.RentalStatus.Active ? "Active" : "Completed";
                    var isScooter = a.Vehicle?.Category?.CategoryName?.Contains("Scooter") ?? false;

                    <tr data-status="@statusText">
                        <td>
                            <span class="user-chip" style="background:@color;">@initials</span>
                            @userName
                        </td>
                        <td>
                            <span class="veh-tag @(isScooter ? "scooter" : "bike")">
                                @(a.Vehicle?.VehicleCode ?? "No Vehicle")
                            </span>
                        </td>
                        <td style="color:var(--text-muted);">@(a.StartStation?.StationName ?? "N/A")</td>
                        <td style="color:@(a.DestinationStation == null ? "var(--border)" : "var(--text-muted)");">
                            @(a.DestinationStation?.StationName ?? "—")
                        </td>
                        <td style="color:var(--text-muted);font-size:12.5px;">@a.StartTime.ToString("HH:mm - dd/MM/yyyy")</td>
                        <td style="font-weight:700;">
                            @if (statusText == "Completed")
                            {
                                <span>₫ 25,000</span> <!-- Giả lập giá tiền khi đã hoàn thành -->
                            }
                            else
                            {
                                <span style="color:var(--text-muted); font-size: 12px;">
                                    ₫ @(a.Vehicle?.Category?.PricePerMinute.ToString("N0") ?? "0")/phút
                                </span>
                            }
                        </td>
                        <td>
                            @if (statusText == "Active")
                            {
                                <span class="badge-custom badge-available">● Active</span>
                            }
                            else
                            {
                                <span class="badge-custom" style="background:#ede9fa;color:var(--primary-text);">Completed</span>
                            }
                        </td>
                    </tr>
                    i++;
                }
            }
            else
            {
                <tr>
                    <td colspan="7" style="text-align:center; padding: 20px; color: var(--text-muted);">
                        Chưa có dữ liệu thuê xe nào trong Database.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        // SCRIPT LỌC HOẠT ĐỘNG
        function filterActivity(status, btn) {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            document.querySelectorAll('#activityTableBody tr').forEach(row => {
                if (row.dataset.status) { // bỏ qua dòng trống nếu mảng rỗng
                    if (status === 'All' || row.dataset.status === status) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                }
            });
        }
    </script>
}