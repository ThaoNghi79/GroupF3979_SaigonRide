@model SaigonRide.Models.Rental
@using SaigonRide.Models
@{
    var tab = (string)(ViewBag.Tab ?? "domestic");
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Checkout</title>
    <link rel="stylesheet" href="~/css/saigonride-ui.css" />
</head>
<body>
<div class="checkout-page">
    <div class="sr-page-label">Check out</div>
    <a class="back-btn" href="/Rental/MyTrip">←</a>
    <h1>Trip Completed & Checkout</h1>
    <p class="success-line">● Thank you for riding with SaigonRide. Please review your trip and complete payment.</p>
    <main class="checkout-grid">
        <section class="checkout-card">
            <h2>▣ Trip Summary</h2>
            <div class="checkout-vehicle"><div class="checkout-art">🛴</div><div><h3>@Model.Vehicle?.VehicleName</h3><span class="id-pill">ID: @Model.Vehicle?.VehicleCode</span><p>🔋 35% Battery<br />Good condition</p></div></div>
            <div class="route-mini"><span>📍 Start Station<br /><b>@Model.StartStation?.StationName</b></span><i></i><span>📍 End Station<br /><b>@Model.DestinationStation?.StationName</b></span></div>
            <div class="checkout-metrics"><div><small>⏱ Duration</small><strong>@Model.DurationMinutes mins</strong></div><div><small>🏷 Rate</small><strong>@((Model.Vehicle?.Category?.PricePerMinute ?? 0).ToString("N0")) VND/min</strong></div></div>
            <div class="fare-lines"><p><span>Base Fare (@Model.DurationMinutes mins × @((Model.Vehicle?.Category?.PricePerMinute ?? 0).ToString("N0")) VND)</span><b>@Model.BaseFare.ToString("N0") VND</b></p><p class="discount"><span>15% OFF - Low Inventory Station!</span><b>-@Model.DiscountAmount.ToString("N0") VND</b></p></div>
            <div class="total-line"><span>Total Amount</span><b>@Model.FinalFare.ToString("N0") VND</b></div>
        </section>
        <section class="checkout-card">
            <h2>💳 Select Payment Method</h2>
            <div class="method-tabs"><a class="@(tab == "domestic" ? "active" : "")" href="/Rental/Payment?tab=domestic">⌂ Domestic Methods</a><a class="@(tab == "global" ? "active" : "")" href="/Rental/Payment?tab=global">🌐 Global Methods</a></div>
            <form method="post" action="/Payment/Process">
                @Html.AntiForgeryToken()
                <input type="hidden" name="rentalId" value="@Model.RentalId" />
                @if (tab == "global")
                {
                    <label class="method-card selected"><input type="radio" name="method" value="ApplePay" checked /><span> Apple Pay<br /><small>Pay instantly from your device</small></span></label>
                    <label class="method-card"><input type="radio" name="method" value="PayPal" /><span>💳 International Cards<br /><small>Processed securely</small></span></label>
                    <label class="method-card"><input type="radio" name="method" value="PayPal" /><span>🅿️ PayPal<br /><small>Pay from PayPal balance or card</small></span></label>
                }
                    else
                    {
                        <label class="method-card selected">
                            <input type="radio" name="method" value="Wallet" checked />
                            <span>💳 Your Wallet<br /><small>Balance: 250,000 VND</small></span>
                        </label>

                        <label class="method-card">
                            <input type="radio" name="method" value="MoMo" />
                            <span>MoMo E-Wallet<br /><small>Pay easily with MoMo</small></span>
                        </label>

                        <label class="method-card">
                            <input type="radio" name="method" value="VNPay" />
                            <span>VNPay<br /><small>Pay securely with VNPay</small></span>
                        </label>

                        <label class="method-card">
                            <input type="radio" name="method" value="Cash" />
                            <span>Cash<br /><small>Pay with cash at the station</small></span>
                        </label>
                    }
                <button class="confirm-payment">🔒 Confirm Payment @Model.FinalFare.ToString("N0") VND</button>
            </form>
        </section>
    </main>
    <div class="bottom-strip"><span>🌍 Eco-Friendly choice<br /><small>You saved 0.5kg of CO2 this trip!</small></span><span>🔒 Safe & Secure<br /><small>Your payment is protected</small></span><span>🎧 Need Help?<br /><small>Contact our support 24/7</small></span></div>
</div>
</body>
</html>
