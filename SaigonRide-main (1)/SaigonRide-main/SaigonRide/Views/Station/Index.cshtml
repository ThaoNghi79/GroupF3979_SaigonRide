@model IEnumerable<SaigonRide.Models.Station>
@{
    ViewData["Title"] = "Stations Management";
    ViewData["Page"] = "stations";
}

@section Styles {
    <style>
        .page-banner-plain {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            margin-bottom: 18px;
        }

            .page-banner-plain h1 {
                font-size: 22px;
                font-weight: 800;
                color: var(--text-main);
            }

            .page-banner-plain .sub {
                font-size: 13px;
                color: var(--text-muted);
                margin-top: 3px;
                font-weight: 500;
            }

        .banner-btns {
            display: flex;
            gap: 10px;
        }

        .btn-outline {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 9px 17px;
            border-radius: 10px;
            border: 1.5px solid var(--border);
            background: white;
            font-size: 13px;
            font-weight: 600;
            font-family: inherit;
            color: var(--text-main);
            cursor: pointer;
            transition: all 0.15s;
        }

            .btn-outline:hover {
                border-color: var(--primary);
            }

        .btn-filled {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 9px 17px;
            border-radius: 10px;
            background: #2D2640;
            color: white;
            border: none;
            font-size: 13px;
            font-weight: 700;
            font-family: inherit;
            cursor: pointer;
            transition: all 0.15s;
        }

            .btn-filled:hover {
                background: #3d3557;
            }

        .filter-bar-plain {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 14px;
            flex-wrap: wrap;
        }

        .flabel {
            font-size: 13px;
            color: var(--text-muted);
            font-weight: 500;
        }

        .fdrop {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 7px 12px;
            border: 1px solid var(--border);
            border-radius: 8px;
            background: white;
            font-size: 13px;
            font-weight: 600;
            color: var(--text-main);
            cursor: pointer;
            appearance: none;
            padding-right: 28px;
            background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 10 6%22><path d=%22M1 1l4 4 4-4%22 stroke=%22%238b80a8%22 stroke-width=%221.4%22 fill=%22none%22/></svg>');
            background-repeat: no-repeat;
            background-position: right 10px center;
            background-size: 10px;
        }

        .fsearch {
            flex: 1;
            position: relative;
        }

            .fsearch input {
                width: 100%;
                padding: 8px 14px 8px 34px;
                border: 1px solid var(--border);
                border-radius: 8px;
                font-size: 13px;
                font-family: inherit;
                outline: none;
            }

                .fsearch input:focus {
                    border-color: var(--primary);
                }

            .fsearch .si {
                position: absolute;
                left: 11px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--text-muted);
                font-size: 12px;
            }

        .vtable-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 1px 4px rgba(0,0,0,0.04);
        }

        .vtable-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px 20px 12px;
            border-bottom: 1px solid var(--border);
        }

            .vtable-head h3 {
                font-size: 14px;
                font-weight: 700;
                color: var(--text-main);
            }

        .vtable {
            width: 100%;
            border-collapse: collapse;
        }

            .vtable th {
                font-size: 11px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                color: var(--text-muted);
                padding: 10px 16px;
                border-bottom: 1px solid var(--border);
                text-align: left;
            }

            .vtable td {
                padding: 11px 16px;
                border-bottom: 1px solid var(--border);
                font-size: 13px;
                vertical-align: middle;
            }

            .vtable tr:last-child td {
                border-bottom: none;
            }

            .vtable tr:hover td {
                background: #faf8ff;
            }

            .vtable tr.selected-row td {
                background: rgba(201,184,245,0.08);
            }

        .id-chip {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 6px;
            background: #ede9fa;
            color: var(--primary-text);
            font-size: 11px;
            font-weight: 700;
        }

        .inv-chip {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: 12.5px;
            font-weight: 700;
            color: var(--text-main);
        }

        .inv-div {
            color: var(--border);
            margin: 0 4px;
        }

        .util-row {
            display: flex;
            align-items: center;
            gap: 8px;
            min-width: 120px;
        }

        .util-pct {
            font-size: 12.5px;
            font-weight: 700;
            min-width: 36px;
        }

        .util-bar-wrap {
            flex: 1;
            height: 6px;
            background: #f3f4f6;
            border-radius: 3px;
            overflow: hidden;
        }

        .util-bar-fill {
            height: 100%;
            border-radius: 3px;
        }

        .status-pill {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 11.5px;
            font-weight: 600;
        }

        .sp-active {
            background: #d4f5e2;
            color: #276749;
        }

        .sp-maint {
            background: #fde8f0;
            color: #a3305a;
        }

        .sp-offline {
            background: #ede9fa;
            color: var(--primary-text);
        }

        .act-btn {
            width: 28px;
            height: 28px;
            border-radius: 7px;
            border: 1px solid var(--border);
            background: white;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 12px;
            transition: all 0.15s;
        }

            .act-btn.edit {
                color: var(--primary-text);
            }

                .act-btn.edit:hover {
                    background: #ede9fa;
                }

            .act-btn.del {
                color: var(--danger);
            }

                .act-btn.del:hover {
                    background: #fdd8d8;
                }

        .sel-bar {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 16px;
            border-top: 1px solid var(--border);
            background: var(--body-bg);
            font-size: 13px;
        }

        .sel-info {
            font-weight: 600;
            color: var(--text-main);
        }

        .clear-sel {
            color: var(--primary-text);
            cursor: pointer;
            font-weight: 500;
            margin-left: 6px;
        }

        .sel-actions {
            margin-left: auto;
            display: flex;
            gap: 8px;
        }

        .btn-danger {
            background: #fdd8d8;
            color: var(--danger);
            border: none;
            padding: 7px 14px;
            border-radius: 8px;
            font-size: 12.5px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
        }

        .pag-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 16px;
            border-top: 1px solid var(--border);
        }

        .pag-info {
            font-size: 12px;
            color: var(--text-muted);
        }

        .pag-btns {
            display: flex;
            gap: 4px;
        }

        .pag-btn {
            width: 28px;
            height: 28px;
            border: 1px solid var(--border);
            border-radius: 7px;
            background: white;
            font-size: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-family: inherit;
            transition: all 0.15s;
        }

            .pag-btn.active {
                background: var(--gradient);
                color: var(--text-main);
                border-color: transparent;
                font-weight: 700;
            }
    </style>
}

<!-- PAGE HEADER -->
<div class="page-banner-plain">
    <div>
        <h1 data-i18n="Stations Management">Stations Management</h1>
        <div class="sub" data-i18n="Manage your station network — monitor capacities, live status, and vehicle distribution">
            Manage your station network — monitor capacities, live status, and vehicle distribution
        </div>
    </div>
    <div class="banner-btns">
        <button class="btn-outline" onclick="exportTableCSV()">
            <i class="fas fa-download"></i> <span data-i18n="Export CSV">Export CSV</span>
        </button>
        <button class="btn-filled" onclick="openModal('addModal')">
            <i class="fas fa-plus"></i> <span data-i18n="Add New Station">Add New Station</span>
        </button>
    </div>
</div>

<!-- FILTER BAR -->
<div class="filter-bar-plain">
    <span class="flabel" data-i18n="Filter by:">Filter by:</span>
    <select class="fdrop" id="filterDistrict" onchange="applyFilter()">
        <option value="">📍 All Districts</option>
        @foreach (var d in Model.Select(s => s.Location).Distinct().OrderBy(x => x))
        {
            <option value="@d">@d</option>
        }
    </select>
    <select class="fdrop" id="filterStatus" onchange="applyFilter()">
        <option value="">🔄 All Statuses</option>
        <option value="active">Active</option>
        <option value="maintenance">Maintenance</option>
        <option value="offline">Offline</option>
    </select>
    <div class="fsearch">
        <i class="fas fa-search si"></i>
        <input type="text" id="searchInput"
               data-i18n-placeholder="Search station name or location..."
               placeholder="Search station name or location..."
               oninput="applyFilter()" />
    </div>
</div>

<!-- TABLE -->
<div class="vtable-card">
    <div class="vtable-head">
        <h3 data-i18n="All Stations">All Stations</h3>
        <span style="font-size:12.5px;color:var(--text-muted);" id="showingCount">
            Showing @Model.Count() of @Model.Count() stations
        </span>
    </div>

    <div style="overflow-x:auto;">
        <table class="vtable" id="stationTable">
            <thead>
                <tr>
                    <th style="width:36px;"><input type="checkbox" id="selectAll" onchange="toggleAll(this)" /></th>
                    <th>ID</th>
                    <th data-i18n="Station Name">Station Name</th>
                    <th data-i18n="Location">Location</th>
                    <th data-i18n="Inventory (Bike | Scooter)">Inventory (Bike | Scooter)</th>
                    <th data-i18n="Capacity">Capacity</th>
                    <th data-i18n="Available Slots">Available Slots</th>
                    <th data-i18n="Utilization %">Utilization %</th>
                    <th data-i18n="STATUS">Status</th>
                    <th style="text-align:center;" data-i18n="Actions">Actions</th>
                </tr>
            </thead>
            <tbody id="stationBody">
                @{
                    int idx = 1;
                    foreach (var s in Model)
                    {
                        double util = s.Capacity > 0 ? (double)s.CurrentInventory / s.Capacity * 100 : 0;
                        int availSlots = s.Capacity - s.CurrentInventory;
                        string utilColor = util >= 90 ? "#E55A7E" : util < 20 ? "#F39C5A" : "#34C77B";
                        string statusKey = util >= 90 ? "active" : util < 20 ? "maintenance" : "active";
                        string badgeClass = util >= 90 ? "sp-active" : util < 20 ? "sp-maint" : "sp-active";
                        string badgeTxt = util >= 90 ? "Active" : util < 20 ? "Maintenance" : "Active";

                        <tr data-district="@s.Location.ToLower()"
                            data-status="active"
                            data-name="@s.StationName.ToLower() @s.Location.ToLower()">
                            <td><input type="checkbox" class="row-check" value="@s.StationId" onchange="updateBulkBar()" /></td>
                            <td><span class="id-chip">ST-@idx.ToString("D3")</span></td>
                            <td style="font-weight:600;">@s.StationName</td>
                            <td style="color:var(--text-muted);font-size:12.5px;">@s.Location</td>
                            <td>
                                <span class="inv-chip">🚲 @(s.CurrentInventory / 2)</span>
                                <span class="inv-div">|</span>
                                <span class="inv-chip">🛴 @(s.CurrentInventory - s.CurrentInventory / 2)</span>
                            </td>
                            <td style="font-weight:600;text-align:center;">@s.Capacity</td>
                            <td style="text-align:center;font-weight:700;
                                color:@(availSlots == 0 ? "#E55A7E" : availSlots <= 3 ? "#F39C5A" : "#34C77B");">
                                @availSlots
                            </td>
                            <td>
                                <div class="util-row">
                                    <span class="util-pct" style="color:@utilColor;">@Math.Round(util, 1)%</span>
                                    <div class="util-bar-wrap">
                                        <div class="util-bar-fill" style="width:@(Math.Min(util, 100))%;background:@utilColor;"></div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="status-pill @badgeClass">@badgeTxt</span></td>
                            <td style="text-align:center;">
                                <button class="act-btn edit" title="Edit"
                                        onclick="openEditModal(@s.StationId,'@Html.Raw(s.StationName)','@Html.Raw(s.Location)',@s.Capacity,@s.CurrentInventory)">
                                    <i class="fas fa-pen"></i>
                                </button>
                                <form method="post" action="/Station/Delete/@s.StationId" style="display:inline;"
                                      onsubmit="return confirm('Delete station @Html.Raw(s.StationName)?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="act-btn del" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                        idx++;
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Bulk bar -->
    <div class="sel-bar" id="bulkBar" style="display:none;">
        <span class="sel-info">
            <span id="bulkCount">0</span> Selected
            <span class="clear-sel" onclick="clearSelection()">Clear selection</span>
        </span>
        <div class="sel-actions">
            <button class="btn-danger">🗑 Delete Selected</button>
        </div>
    </div>

    <!-- Pagination -->
    <div class="pag-bar">
        <div class="pag-info">Page 1 of @(Math.Max(1, (int)Math.Ceiling((double)Model.Count() / 7))) — @Model.Count() stations total</div>
        <div class="pag-btns">
            <button class="pag-btn"><i class="fas fa-chevron-left" style="font-size:10px;"></i></button>
            <button class="pag-btn active">1</button>
            <button class="pag-btn">2</button>
            <button class="pag-btn">3</button>
            <span style="padding:0 4px;color:var(--text-muted);">…</span>
            <button class="pag-btn">@(Math.Max(1, (int)Math.Ceiling((double)Model.Count() / 7)))</button>
            <button class="pag-btn"><i class="fas fa-chevron-right" style="font-size:10px;"></i></button>
        </div>
    </div>
</div>

<!-- ADD STATION MODAL -->
<div class="modal-backdrop-custom" id="addModal">
    <div class="modal-box">
        <div class="modal-header-custom">
            <h4>
                <i class="fas fa-map-marker-alt" style="margin-right:8px;"></i>
                <span data-i18n="Add New Station">Add New Station</span>
            </h4>
        </div>
        <form method="post" action="/Station/Create">
            @Html.AntiForgeryToken()
            <div class="modal-body-custom">
                <label class="form-label-custom" data-i18n="Station Name">Station Name</label>
                <input name="StationName" class="form-input-custom" placeholder="e.g. Ben Thanh Market" required maxlength="100" />
                <label class="form-label-custom" data-i18n="Location / Address">Location / Address</label>
                <input name="Location" class="form-input-custom" placeholder="e.g. District 1, Ho Chi Minh City" required maxlength="200" />
                <div style="background:linear-gradient(135deg,#e0f2fe,#f0fdf4);border-radius:10px;height:90px;display:flex;align-items:center;justify-content:center;margin-bottom:16px;border:1px solid var(--border);">
                    <div style="text-align:center;color:var(--text-muted);">
                        <i class="fas fa-map-marked-alt" style="font-size:24px;color:#60a5fa;display:block;margin-bottom:5px;"></i>
                        <span style="font-size:12px;" data-i18n="Map preview">Map preview</span>
                    </div>
                </div>
                <label class="form-label-custom" data-i18n="Max Capacity">Max Capacity</label>
                <input name="Capacity" type="number" min="1" max="500" class="form-input-custom" placeholder="e.g. 50" required />
            </div>
            <div style="padding:0 24px 24px;">
                <div class="modal-footer-custom">
                    <button type="button" class="btn-cancel" onclick="closeModal('addModal')" data-i18n="Cancel">Cancel</button>
                    <button type="submit" class="btn-save">
                        <i class="fas fa-save" style="margin-right:5px;"></i>
                        <span data-i18n="Save Station">Save Station</span>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- EDIT STATION MODAL -->
<div class="modal-backdrop-custom" id="editModal">
    <div class="modal-box">
        <div class="modal-header-custom">
            <h4>
                <i class="fas fa-pen" style="margin-right:8px;"></i>
                <span data-i18n="Edit Station">Edit Station</span> — <span id="editModalTitle"></span>
            </h4>
        </div>
        <form method="post" id="editForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="StationId" id="editStationId" />
            <div class="modal-body-custom">
                <label class="form-label-custom" data-i18n="Station Name">Station Name</label>
                <input name="StationName" id="editStationName" class="form-input-custom" required maxlength="100" />
                <label class="form-label-custom" data-i18n="Location / Address">Location / Address</label>
                <input name="Location" id="editLocation" class="form-input-custom" required maxlength="200" />
                <label class="form-label-custom" data-i18n="Max Capacity">Max Capacity</label>
                <input name="Capacity" id="editCapacity" type="number" min="1" max="500" class="form-input-custom" required />
                <div style="background:var(--body-bg);border-radius:10px;padding:12px 16px;border:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;">
                    <span style="font-size:13px;color:var(--text-muted);" data-i18n="Current Inventory">Current Inventory</span>
                    <span id="editInventoryInfo" style="font-weight:700;color:var(--primary-text);font-size:14px;">—</span>
                </div>
            </div>
            <div style="padding:0 24px 24px;">
                <div class="modal-footer-custom">
                    <button type="button" class="btn-cancel" onclick="closeModal('editModal')" data-i18n="Cancel">Cancel</button>
                    <button type="submit" class="btn-save">
                        <i class="fas fa-save" style="margin-right:5px;"></i>
                        <span data-i18n="Save Changes">Save Changes</span>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openModal(id) { document.getElementById(id).classList.add('show'); document.body.style.overflow = 'hidden'; }
        function closeModal(id) { document.getElementById(id).classList.remove('show'); document.body.style.overflow = ''; }
        document.querySelectorAll('.modal-backdrop-custom').forEach(m => m.addEventListener('click', e => { if (e.target === m) closeModal(m.id); }));
        document.addEventListener('keydown', e => { if (e.key === 'Escape') document.querySelectorAll('.modal-backdrop-custom.show').forEach(m => closeModal(m.id)); });

        function openEditModal(id, name, location, cap, inv) {
            document.getElementById('editStationId').value = id;
            document.getElementById('editStationName').value = name;
            document.getElementById('editLocation').value = location;
            document.getElementById('editCapacity').value = cap;
            document.getElementById('editModalTitle').textContent = name;
            document.getElementById('editInventoryInfo').textContent = `${inv} / ${cap} vehicles`;
            document.getElementById('editForm').action = `/Station/Edit/${id}`;
            openModal('editModal');
        }

        function applyFilter() {
            const dist = document.getElementById('filterDistrict').value.toLowerCase();
            const search = document.getElementById('searchInput').value.toLowerCase();
            let vis = 0;
            document.querySelectorAll('#stationBody tr').forEach(row => {
                const rD = (row.dataset.district || '');
                const rN = (row.dataset.name || '');
                const show = (!dist || rD.includes(dist)) && (!search || rN.includes(search));
                row.style.display = show ? '' : 'none';
                if (show) vis++;
            });
            document.getElementById('showingCount').textContent = `Showing ${vis} of @Model.Count() stations`;
        }

        function toggleAll(cb) { document.querySelectorAll('.row-check').forEach(c => { if (c.closest('tr').style.display !== 'none') c.checked = cb.checked; }); updateBulkBar(); }
        function updateBulkBar() { const n = document.querySelectorAll('.row-check:checked').length; document.getElementById('bulkBar').style.display = n > 0 ? 'flex' : 'none'; document.getElementById('bulkCount').textContent = n; }
        function clearSelection() { document.querySelectorAll('.row-check,#selectAll').forEach(c => c.checked = false); updateBulkBar(); }

        function exportTableCSV() {
            const rows = [['Station', 'Location', 'Capacity', 'Available', 'Utilization', 'Status']];
            document.querySelectorAll('#stationBody tr').forEach(row => {
                if (row.style.display === 'none') return;
                const c = row.querySelectorAll('td');
                if (c.length < 8) return;
                rows.push([c[2], c[3], c[5], c[6], c[7], c[8]].map(x => `"${x.textContent.trim().replace(/"/g, '""')}"`));
            });
            const a = document.createElement('a');
            a.href = 'data:text/csv;charset=utf-8,\uFEFF' + encodeURIComponent(rows.map(r => r.join(',')).join('\n'));
            a.download = `stations_${new Date().toISOString().slice(0, 10)}.csv`;
            a.click();
        }
    </script>
}
