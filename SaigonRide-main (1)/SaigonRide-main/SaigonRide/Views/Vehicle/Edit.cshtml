@model SaigonRide.Models.Vehicle
@{
    ViewData["Title"] = "Edit Vehicle";
    ViewData["Page"] = "vehicles";
    var categories = ViewBag.Categories as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var stationsList = ViewBag.Stations as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var statuses = ViewBag.Statuses as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
}

<div style="max-width:560px; margin:0 auto;">
    <a href="/Vehicle" style="font-size:13px; color:var(--primary-text); font-weight:600;
        text-decoration:none; display:flex; align-items:center; gap:6px; margin-bottom:20px;">
        <i class="fas fa-arrow-left"></i>
        <span data-i18n="Back to Vehicles">Back to Vehicles</span>
    </a>

    <div class="card-custom">
        <div style="background:var(--gradient); margin:-20px -20px 24px;
            padding:20px 24px; border-radius:14px 14px 0 0;">
            <h4 style="color:var(--text-main); font-size:17px; font-weight:700;">
                <i class="fas fa-pen" style="margin-right:8px;"></i>
                <span data-i18n="Edit Vehicle">Edit Vehicle</span> — @Model.VehicleCode
            </h4>
        </div>

        <form method="post" action="/Vehicle/Edit/@Model.VehicleId">
            @Html.AntiForgeryToken()
            <input type="hidden" name="VehicleId" value="@Model.VehicleId" />

            <label class="form-label-custom" data-i18n="Vehicle Code">Vehicle Code</label>
            <input name="VehicleCode" class="form-input-custom"
                   value="@Model.VehicleCode" required />

            <label class="form-label-custom" data-i18n="Vehicle Name">Vehicle Name</label>
            <input name="VehicleName" class="form-input-custom"
                   value="@Model.VehicleName" required />

            <label class="form-label-custom" data-i18n="Category">Category</label>
            @Html.DropDownList("CategoryId", categories, new { @class = "form-input-custom" })

            <label class="form-label-custom" data-i18n="Station">Station</label>
            @Html.DropDownList("StationId", stationsList, new { @class = "form-input-custom" })

            <label class="form-label-custom" data-i18n="Status">Status</label>
            @Html.DropDownList("Status", statuses, new { @class = "form-input-custom" })

            <div style="display:flex; gap:10px; justify-content:flex-end; margin-top:8px;">
                <a href="/Vehicle" class="btn-cancel"
                   style="display:flex; align-items:center; text-decoration:none;"
                   data-i18n="Cancel">Cancel</a>
                <button type="submit" class="btn-save">
                    <i class="fas fa-save" style="margin-right:5px;"></i>
                    <span data-i18n="Save Changes">Save Changes</span>
                </button>
            </div>
        </form>
    </div>
</div>
