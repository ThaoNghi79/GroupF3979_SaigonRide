@{
    ViewData["Title"] = "Live Map";
    ViewData["Page"] = "dashboard";
    ViewData["HideSidebar"] = true;
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        .map-layout {
            display: flex;
            height: calc(100vh - 56px);
            margin: -24px;
            overflow: hidden;
            position: relative;
        }

        .map-sidebar {
            width: 240px;
            flex-shrink: 0;
            background: white;
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            z-index: 10;
        }

        .sidebar-block {
            padding: 16px 14px 12px;
            border-bottom: 1px solid var(--border);
        }

        .sidebar-block:last-child {
            border-bottom: none;
        }

        .block-title {
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: var(--text-muted);
            margin-bottom: 10px;
        }

        .filter-pills {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
        }

        .pill {
            padding: 5px 14px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
            border: 1.5px solid var(--border);
            background: white;
            color: var(--text-muted);
            cursor: pointer;
            transition: all 0.15s;
            font-family: inherit;
        }

        .pill.active {
            background: var(--gradient);
            color: var(--text-main);
            border-color: transparent;
        }

        .toggle-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 9px;
        }

        .toggle-row:last-child {
            margin-bottom: 0;
        }

        .toggle-label {
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: 12.5px;
            font-weight: 500;
            color: var(--text-main);
        }

        .toggle-chip {
            padding: 3px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            border: 1.5px solid var(--border);
            background: white;
            color: var(--text-muted);
            cursor: pointer;
            transition: all 0.15s;
            font-family: inherit;
        }

        .toggle-chip.on {
            background: var(--gradient);
            color: var(--text-main);
            border-color: transparent;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 9px;
            font-size: 12px;
            color: var(--text-main);
            margin-bottom: 7px;
        }

        .legend-item:last-child {
            margin-bottom: 0;
        }

        .legend-dot {
            width: 11px;
            height: 11px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .qs-row {
            display: flex;
            justify-content: space-around;
        }

        .qs-item {
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 2px;
        }

        .qs-icon {
            font-size: 18px;
        }

        .qs-num {
            font-size: 17px;
            font-weight: 800;
        }

        .qs-label {
            font-size: 10.5px;
            font-weight: 500;
        }

        #mapContainer {
            flex: 1;
            position: relative;
            min-height: 0;
        }

        #map {
            width: 100%;
            height: 100%;
            min-height: 0;
        }

        .route-toggle-bar {
            position: absolute;
            bottom: 24px;
            left: 50%;
            transform: translateX(-50%);
            background: white;
            border-radius: 14px;
            padding: 10px 20px;
            box-shadow: 0 6px 24px rgba(0,0,0,0.15);
            border: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 12px;
            z-index: 1000;
        }

        .route-toggle-bar button {
            border: none;
            background: none;
            cursor: pointer;
            font-size: 13px;
            font-family: inherit;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 8px;
            transition: all 0.15s;
        }

        .route-toggle-bar button.active-btn {
            background: var(--gradient);
            color: var(--text-main);
        }

        .route-toggle-bar button.inactive-btn {
            color: var(--text-muted);
        }

        .user-popup {
            position: absolute;
            bottom: 80px;
            right: 20px;
            background: white;
            border-radius: 14px;
            padding: 14px 16px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.12);
            border: 1px solid var(--border);
            min-width: 180px;
            z-index: 500;
            display: none;
        }

        .user-popup.show {
            display: block;
        }

        .user-popup-close {
            position: absolute;
            top: 8px;
            right: 10px;
            background: none;
            border: none;
            font-size: 14px;
            cursor: pointer;
            color: var(--text-muted);
        }

        .up-title {
            font-size: 11px;
            color: var(--text-muted);
            font-weight: 600;
            margin-bottom: 8px;
        }

        .up-row {
            font-size: 13px;
            font-weight: 600;
            color: var(--text-main);
            margin-bottom: 4px;
        }

        .up-row span {
            color: var(--text-muted);
            font-weight: 500;
        }

        .leaflet-popup-content-wrapper {
            border-radius: 12px !important;
            box-shadow: 0 8px 24px rgba(0,0,0,0.12) !important;
            border: 1px solid var(--border) !important;
            font-family: 'Plus Jakarta Sans', sans-serif !important;
        }

        .leaflet-popup-content {
            margin: 14px 16px !important;
            font-size: 13px;
        }

        .popup-title {
            font-weight: 700;
            color: var(--text-main);
            font-size: 14px;
            margin-bottom: 8px;
        }

        .popup-row {
            display: flex;
            justify-content: space-between;
            font-size: 12.5px;
            margin-bottom: 4px;
        }

        .popup-row span:first-child {
            color: var(--text-muted);
        }

        .popup-row span:last-child {
            font-weight: 600;
            color: var(--text-main);
        }

        .popup-badge {
            display: inline-block;
            padding: 3px 9px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            margin-top: 6px;
        }
    </style>
}

<div class="map-layout">
    <div class="map-sidebar">
        <div class="sidebar-block">
            <div class="block-title" data-i18n="Filter">Filter</div>
            <div class="filter-pills">
                <button class="pill active" onclick="filterVehicle('all', this)" data-i18n="All">All</button>
                <button class="pill" onclick="filterVehicle('scooter', this)" data-i18n="Scooter">Scooter</button>
                <button class="pill" onclick="filterVehicle('bike', this)" data-i18n="Bike">Bike</button>
            </div>
        </div>

        <div class="sidebar-block">
            <div class="block-title" data-i18n="Layers">Layers</div>
            <div class="toggle-row">
                <div class="toggle-label"><span>⚠️</span> <span data-i18n="Low Inventory">Low Inventory</span></div>
                <button class="toggle-chip on" id="toggle-low" onclick="toggleLayer('low', this)" data-i18n="On">On</button>
            </div>
            <div class="toggle-row">
                <div class="toggle-label"><span>🛵</span> <span data-i18n="Active Rentals">Active Rentals</span></div>
                <button class="toggle-chip on" id="toggle-active" onclick="toggleLayer('active', this)" data-i18n="On">On</button>
            </div>
            <div class="toggle-row">
                <div class="toggle-label"><span>🌡️</span> <span data-i18n="Heatmap">Heatmap</span></div>
                <button class="toggle-chip on" id="toggle-heat" onclick="toggleLayer('heat', this)" data-i18n="On">On</button>
            </div>
        </div>

        <div class="sidebar-block">
            <div class="block-title" data-i18n="Legend">Legend</div>
            <div class="legend-item"><div class="legend-dot" style="background:#C9B8F5;border:2px solid #9B7FE8;"></div><span data-i18n="Available station">Available station</span></div>
            <div class="legend-item"><div class="legend-dot" style="background:#FFF3B0;border:2px solid #f2994a;"></div><span data-i18n="Low Inventory (<20%)">Low Inventory (&lt;20%)</span></div>
            <div class="legend-item"><div class="legend-dot" style="background:#fdd8d8;border:2px solid #eb5757;"></div><span data-i18n="Full / Overflowing">Full / Overflowing</span></div>
            <div class="legend-item"><span style="font-size:15px;">🛴</span><span data-i18n="Active (E-Scooter)">Active (E-Scooter)</span></div>
            <div class="legend-item"><span style="font-size:15px;">🚲</span><span data-i18n="Active (Bike)">Active (Bike)</span></div>
            <div class="legend-item"><div class="legend-dot" style="background:rgba(245,184,208,0.4);border:1px solid #F5B8D0;border-radius:3px;"></div><span data-i18n="High demand">High demand</span></div>
        </div>

        <div class="sidebar-block">
            <div class="block-title" data-i18n="Quick Stats">Quick Stats</div>
            <div class="qs-row">
                <div class="qs-item">
                    <span class="qs-icon">🚉</span>
                    <span class="qs-num" style="color:var(--primary-text);">@(ViewBag.StationCount ?? 0)</span>
                    <span class="qs-label" style="color:var(--text-muted);" data-i18n="Total">Total</span>
                </div>
                <div class="qs-item">
                    <span class="qs-icon">⚠️</span>
                    <span class="qs-num" style="color:#f2994a;">@(ViewBag.LowInventoryStations ?? 0)</span>
                    <span class="qs-label" style="color:#f2994a;" data-i18n="Low">Low</span>
                </div>
                <div class="qs-item">
                    <span class="qs-icon">🔴</span>
                    <span class="qs-num" style="color:#eb5757;">@(ViewBag.OverloadedStations ?? 0)</span>
                    <span class="qs-label" style="color:#eb5757;" data-i18n="Full">Full</span>
                </div>
            </div>
        </div>
    </div>

    <div id="mapContainer">
        <div id="map"></div>

        <div class="user-popup" id="userPopup">
            <button class="user-popup-close" onclick="document.getElementById('userPopup').classList.remove('show')">✕</button>
            <div class="up-title" data-i18n="Active Rental">Active Rental</div>
            <div class="up-row"><span data-i18n="User">User</span>: <span id="popupUser">...</span></div>
            <div class="up-row"><span data-i18n="Vehicle">Vehicle</span>: <span id="popupVeh">...</span></div>
            <div class="up-row"><span data-i18n="Duration">Duration</span>: <span id="popupDur">...</span></div>
        </div>

        <div class="route-toggle-bar">
            <span style="color:var(--secondary);font-size:16px;">●</span>
            <button class="active-btn" id="btnShow" onclick="toggleRoute(true)" data-i18n="Show Route">Show Route</button>
            <span style="color:var(--border);">|</span>
            <button class="inactive-btn" id="btnHide" onclick="toggleRoute(false)" data-i18n="Hide Route">Hide Route</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        const stations = [
            @{
                var stationList = ViewBag.StationMapData as List<SaigonRide.Models.Station>;
                if (stationList != null && stationList.Any())
                {
                    int i = 0;
                    foreach (var s in stationList)
                    {
                        double u = s.Capacity > 0 ? (double)s.CurrentInventory / s.Capacity * 100 : 0;
                        string t = u >= 90 ? "overload" : u < 20 ? "lowinventory" : "available";
                        <text>{ id: @s.StationId, name: "@Html.Raw(s.StationName)", current: @s.CurrentInventory, cap: @s.Capacity, type: "@t", lat: @(s.Latitude ?? 10.7769), lng: @(s.Longitude ?? 106.7009) }, </text>
                        i++;
                    }
                }
            }
        ];

        const rentalData = [
            @{
                var rentals = ViewBag.RentalsMapData as List<SaigonRide.Models.Rental>;
                if (rentals != null && rentals.Any())
                {
                    foreach (var r in rentals)
                    {
                        var startId = r.StartStationId;
                        var endId = r.DestinationStationId ?? 0;
                        var userName = r.User?.FullName ?? "Guest";
                        var veh = r.Vehicle?.Category?.CategoryName ?? "Bike";
                        var dur = r.DestinationStationId == null ? "Active..." : "Completed";
                        <text>{ start: @startId, end: @endId, user: '@userName', veh: '@veh', duration: '@dur' }, </text>
                    }
                }
            }
        ];

        const map = L.map('map', { zoomControl: true, preferCanvas: true }).setView([10.7769, 106.7009], 13);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap contributors',
            maxZoom: 18
        }).addTo(map);

        function makeIcon(color, border, emoji) {
            return L.divIcon({
                className: '',
                html: `<div style="width:28px;height:28px;border-radius:50%;background:${color};border:2.5px solid ${border};display:flex;align-items:center;justify-content:center;font-size:13px;box-shadow:0 2px 8px rgba(0,0,0,0.15);">${emoji}</div>`,
                iconSize: [28, 28], iconAnchor: [14, 14], popupAnchor: [0, -16]
            });
        }

        const icons = {
            available: makeIcon('#EDE9FA', '#9B7FE8', '🟣'),
            lowinventory: makeIcon('#FFF3B0', '#f2994a', '⚠️'),
            overload: makeIcon('#fdd8d8', '#eb5757', '🔴'),
            scooter: makeIcon('#fde8f0', '#F5B8D0', '🛴'),
            bike: makeIcon('#EDE9FA', '#C9B8F5', '🚲')
        };

        let stationMarkers = [];
        let rentalLayer = L.layerGroup().addTo(map);
        let heatLayer = L.layerGroup().addTo(map);
        let routeLayerGroup = L.layerGroup().addTo(map);

        const lang = localStorage.getItem('sr_lang') || 'en';
        const popupT = {
            Capacity: lang === 'vi' ? 'Sức chứa' : 'Capacity',
            Utilization: lang === 'vi' ? 'Tỉ lệ sử dụng' : 'Utilization',
            Overload: lang === 'vi' ? 'Quá tải' : 'Overload',
            LowInventory: lang === 'vi' ? 'Tồn kho thấp' : 'Low Inventory',
            Available: lang === 'vi' ? 'Sẵn sàng' : 'Available',
        };

        stations.forEach(s => {
            const util = Math.round(s.current / s.cap * 100);
            const badgeColor = s.type === 'overload' ? '#fdd8d8' : s.type === 'lowinventory' ? '#FFF3B0' : '#d4f5e2';
            const badgeText = s.type === 'overload' ? popupT.Overload : s.type === 'lowinventory' ? popupT.LowInventory : popupT.Available;
            const badgeFg = s.type === 'overload' ? '#a33030' : s.type === 'lowinventory' ? '#7a4000' : '#276749';

            const popup = `<div class="popup-title">${s.name}</div>
            <div class="popup-row"><span>${popupT.Capacity}</span><span>${s.current}/${s.cap}</span></div>
            <div class="popup-row"><span>${popupT.Utilization}</span><span><strong>${util}%</strong></span></div>
            <span class="popup-badge" style="background:${badgeColor};color:${badgeFg};">${badgeText}</span>`;

            const marker = L.marker([s.lat, s.lng], { icon: icons[s.type] || icons.available }).bindPopup(popup);
            marker.stationType = s.type;
            marker.addTo(map);
            stationMarkers.push(marker);
        });

        rentalData.forEach(r => {
            const startStation = stations.find(s => s.id === r.start);
            if (!startStation) return;

            const isScooter = r.veh.toLowerCase().includes('scooter');
            const vType = isScooter ? 'scooter' : 'bike';

            if (r.end !== 0) {
                const endStation = stations.find(s => s.id === r.end);
                if (endStation) {
                    L.polyline(
                        [[startStation.lat, startStation.lng], [endStation.lat, endStation.lng]],
                        { color: '#9B7FE8', weight: 2, opacity: 0.35, dashArray: '5 5' }
                    ).addTo(map);
                }
            } else {
                const randLat = startStation.lat + (Math.random() - 0.5) * 0.015;
                const randLng = startStation.lng + (Math.random() - 0.5) * 0.015;

                L.polyline(
                    [[startStation.lat, startStation.lng], [randLat, randLng]],
                    { color: '#F5B8D0', weight: 3, opacity: 0.9 }
                ).addTo(routeLayerGroup);

                const m = L.marker([randLat, randLng], { icon: icons[vType] }).on('click', function () {
                    document.getElementById('popupUser').innerText = r.user;
                    document.getElementById('popupVeh').innerText = r.veh;
                    document.getElementById('popupDur').innerText = r.duration;
                    document.getElementById('userPopup').classList.add('show');
                });
                m.vehicleType = vType;
                m.addTo(rentalLayer);
            }
        });

        [[10.7726, 106.6980, 60], [10.7744, 106.7030, 40], [10.7796, 106.6990, 50]].forEach(([lat, lng, radius]) => {
            L.circle([lat, lng], {
                radius: radius * 20,
                color: '#F5B8D0', fillColor: '#F5B8D0', fillOpacity: 0.18, weight: 0.5
            }).addTo(heatLayer);
        });

        function filterVehicle(type, btn) {
            document.querySelectorAll('.filter-pills .pill').forEach(p => p.classList.remove('active'));
            btn.classList.add('active');
            const activeToggle = document.getElementById('toggle-active').classList.contains('on');
            rentalLayer.eachLayer(marker => {
                if ((type === 'all' || marker.vehicleType === type) && activeToggle) {
                    map.addLayer(marker);
                } else {
                    map.removeLayer(marker);
                }
            });
        }

        function toggleLayer(layer, btn) {
            btn.classList.toggle('on');
            const isOn = btn.classList.contains('on');
            btn.textContent = isOn ? (lang === 'vi' ? 'Bật' : 'On') : (lang === 'vi' ? 'Tắt' : 'Off');
            if (layer === 'active') { isOn ? map.addLayer(rentalLayer) : map.removeLayer(rentalLayer); }
            if (layer === 'heat') { isOn ? map.addLayer(heatLayer) : map.removeLayer(heatLayer); }
            if (layer === 'low') {
                stationMarkers.forEach(m => {
                    if (m.stationType === 'lowinventory') { isOn ? map.addLayer(m) : map.removeLayer(m); }
                });
            }
        }

        let routeVisible = true;
        function toggleRoute(show) {
            const btnShow = document.getElementById('btnShow');
            const btnHide = document.getElementById('btnHide');
            if (show && !routeVisible) {
                map.addLayer(routeLayerGroup);
                routeVisible = true;
                btnShow.classList.replace('inactive-btn', 'active-btn');
                btnHide.classList.replace('active-btn', 'inactive-btn');
            }
            if (!show && routeVisible) {
                map.removeLayer(routeLayerGroup);
                routeVisible = false;
                btnHide.classList.replace('inactive-btn', 'active-btn');
                btnShow.classList.replace('active-btn', 'inactive-btn');
            }
        }
    </script>
}