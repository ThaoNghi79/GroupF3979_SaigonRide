@model IEnumerable<SaigonRide.Models.Station>
@{
    ViewData["Title"] = "Stations Management";
    ViewData["Page"] = "stations";
}

@section Styles {
    <!-- Thêm thư viện Leaflet để ghim bản đồ -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <style>
        .page-banner-plain {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            margin-bottom: 18px;
        }

            .page-banner-plain h1 {
                font-size: 22px;
                font-weight: 800;
                color: var(--text-main);
            }

            .page-banner-plain .sub {
                font-size: 13px;
                color: var(--text-muted);
                margin-top: 3px;
                font-weight: 500;
            }

        .banner-btns {
            display: flex;
            gap: 10px;
        }

        .btn-outline {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 9px 17px;
            border-radius: 10px;
            border: 1.5px solid var(--border);
            background: white;
            font-size: 13px;
            font-weight: 600;
            font-family: inherit;
            color: var(--text-main);
            cursor: pointer;
            transition: all 0.15s;
        }

            .btn-outline:hover {
                border-color: var(--primary);
            }

        .btn-filled {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 9px 17px;
            border-radius: 10px;
            background: #2D2640;
            color: white;
            border: none;
            font-size: 13px;
            font-weight: 700;
            font-family: inherit;
            cursor: pointer;
            transition: all 0.15s;
        }

            .btn-filled:hover {
                background: #3d3557;
            }

        .filter-bar-plain {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 14px;
            flex-wrap: wrap;
        }

        .flabel {
            font-size: 13px;
            color: var(--text-muted);
            font-weight: 500;
        }

        .fdrop {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 7px 12px;
            border: 1px solid var(--border);
            border-radius: 8px;
            background: white;
            font-size: 13px;
            font-weight: 600;
            color: var(--text-main);
            cursor: pointer;
            appearance: none;
            padding-right: 28px;
            background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 10 6%22><path d=%22M1 1l4 4 4-4%22 stroke=%22%238b80a8%22 stroke-width=%221.4%22 fill=%22none%22/></svg>');
            background-repeat: no-repeat;
            background-position: right 10px center;
            background-size: 10px;
        }

        .fsearch {
            flex: 1;
            position: relative;
        }

            .fsearch input {
                width: 100%;
                padding: 8px 14px 8px 34px;
                border: 1px solid var(--border);
                border-radius: 8px;
                font-size: 13px;
                font-family: inherit;
                outline: none;
            }

                .fsearch input:focus {
                    border-color: var(--primary);
                }

            .fsearch .si {
                position: absolute;
                left: 11px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--text-muted);
                font-size: 12px;
            }

        .vtable-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 1px 4px rgba(0,0,0,0.04);
        }

        .vtable-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px 20px 12px;
            border-bottom: 1px solid var(--border);
        }

            .vtable-head h3 {
                font-size: 14px;
                font-weight: 700;
                color: var(--text-main);
            }

        .vtable {
            width: 100%;
            border-collapse: collapse;
        }

            .vtable th {
                font-size: 11px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                color: var(--text-muted);
                padding: 10px 16px;
                border-bottom: 1px solid var(--border);
                text-align: left;
            }

            .vtable td {
                padding: 11px 16px;
                border-bottom: 1px solid var(--border);
                font-size: 13px;
                vertical-align: middle;
            }

            .vtable tr:last-child td {
                border-bottom: none;
            }

            .vtable tr:hover td {
                background: #faf8ff;
            }

            .vtable tr.selected-row td {
                background: rgba(201,184,245,0.08);
            }

        .id-chip {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 6px;
            background: #ede9fa;
            color: var(--primary-text);
            font-size: 11px;
            font-weight: 700;
        }

        .inv-chip {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: 12.5px;
            font-weight: 700;
            color: var(--text-main);
        }

        .inv-div {
            color: var(--border);
            margin: 0 4px;
        }

        .util-row {
            display: flex;
            align-items: center;
            gap: 8px;
            min-width: 120px;
        }

        .util-pct {
            font-size: 12.5px;
            font-weight: 700;
            min-width: 36px;
        }

        .util-bar-wrap {
            flex: 1;
            height: 6px;
            background: #f3f4f6;
            border-radius: 3px;
            overflow: hidden;
        }

        .util-bar-fill {
            height: 100%;
            border-radius: 3px;
        }

        .status-pill {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 11.5px;
            font-weight: 600;
        }

        .sp-active {
            background: #d4f5e2;
            color: #276749;
        }

        .sp-maint {
            background: #fde8f0;
            color: #a3305a;
        }

        .sp-offline {
            background: #ede9fa;
            color: var(--primary-text);
        }

        .act-btn {
            width: 28px;
            height: 28px;
            border-radius: 7px;
            border: 1px solid var(--border);
            background: white;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 12px;
            transition: all 0.15s;
        }

            .act-btn.edit {
                color: var(--primary-text);
            }

                .act-btn.edit:hover {
                    background: #ede9fa;
                }

            .act-btn.del {
                color: var(--danger);
            }

                .act-btn.del:hover {
                    background: #fdd8d8;
                }

        .sel-bar {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 16px;
            border-top: 1px solid var(--border);
            background: var(--body-bg);
            font-size: 13px;
        }

        .sel-info {
            font-weight: 600;
            color: var(--text-main);
        }

        .clear-sel {
            color: var(--primary-text);
            cursor: pointer;
            font-weight: 500;
            margin-left: 6px;
        }

        .sel-actions {
            margin-left: auto;
            display: flex;
            gap: 8px;
        }

        .btn-danger {
            background: #fdd8d8;
            color: var(--danger);
            border: none;
            padding: 7px 14px;
            border-radius: 8px;
            font-size: 12.5px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
        }

        .pag-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 16px;
            border-top: 1px solid var(--border);
        }

        .pag-info {
            font-size: 12px;
            color: var(--text-muted);
        }

        .pag-btns {
            display: flex;
            gap: 4px;
        }

        .pag-btn {
            width: 28px;
            height: 28px;
            border: 1px solid var(--border);
            border-radius: 7px;
            background: white;
            font-size: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-family: inherit;
            transition: all 0.15s;
        }

            .pag-btn.active {
                background: var(--gradient);
                color: var(--text-main);
                border-color: transparent;
                font-weight: 700;
            }

        /* Bản đồ Leaflet Fix */
        .map-picker {
            height: 180px;
            width: 100%;
            border-radius: 10px;
            border: 1px solid var(--border);
            margin-bottom: 16px;
            z-index: 1; /* Để khỏi đè lên dropdown */
        }
    </style>
}

<!-- PAGE HEADER -->
<div class="page-banner-plain">
    <div>
        <h1 data-i18n="Stations Management">Stations Management</h1>
        <div class="sub" data-i18n="Manage your station network — monitor capacities, live status, and vehicle distribution">
            Manage your station network — monitor capacities, live status, and vehicle distribution
        </div>
    </div>
    <div class="banner-btns">
        <button class="btn-outline" onclick="exportTableCSV()">
            <i class="fas fa-download"></i> <span data-i18n="Export CSV">Export CSV</span>
        </button>
        <button class="btn-filled" onclick="openModal('addModal', 'add')">
            <i class="fas fa-plus"></i> <span data-i18n="Add New Station">Add New Station</span>
        </button>
    </div>
</div>

<!-- FILTER BAR -->
<div class="filter-bar-plain">
    <span class="flabel" data-i18n="Filter by:">Filter by:</span>
    <select class="fdrop" id="filterDistrict" onchange="applyFilter()">
        <option value="">📍 All Districts</option>
        @foreach (var d in Model.Select(s => s.Location).Distinct().OrderBy(x => x))
        {
            <option value="@d">@d</option>
        }
    </select>

    <!-- FIX: Chức năng lọc Status -->
    <select class="fdrop" id="filterStatus" onchange="applyFilter()">
        <option value="">🔄 All Statuses</option>
        <option value="active">Active</option>
        <option value="maintenance">Maintenance</option>
        <option value="offline">Offline</option>
    </select>

    <div class="fsearch">
        <i class="fas fa-search si"></i>
        <input type="text" id="searchInput"
               data-i18n-placeholder="Search station name or location..."
               placeholder="Search station name or location..."
               oninput="applyFilter()" />
    </div>
</div>

<!-- TABLE -->
<div class="vtable-card">
    <div class="vtable-head">
        <h3 data-i18n="All Stations">All Stations</h3>
        <span style="font-size:12.5px;color:var(--text-muted);" id="showingCount">
            Showing @Model.Count() of @Model.Count() stations
        </span>
    </div>

    <div style="overflow-x:auto;">
        <table class="vtable" id="stationTable">
            <thead>
                <tr>
                    <th style="width:36px;"><input type="checkbox" id="selectAll" onchange="toggleAll(this)" /></th>
                    <th>ID</th>
                    <th data-i18n="Station Name">Station Name</th>
                    <th data-i18n="Location">Location</th>
                    <th data-i18n="Inventory (Bike | Scooter)">Inventory (Bike | Scooter)</th>
                    <th data-i18n="Capacity">Capacity</th>
                    <th data-i18n="Available Slots">Available Slots</th>
                    <th data-i18n="Utilization %">Utilization %</th>
                    <th data-i18n="STATUS">Status</th>
                    <th style="text-align:center;" data-i18n="Actions">Actions</th>
                </tr>
            </thead>
            <tbody id="stationBody">
                @{
                    int idx = 1;
                    foreach (var s in Model)
                    {
                        double util = s.Capacity > 0 ? (double)s.CurrentInventory / s.Capacity * 100 : 0;
                        int availSlots = s.Capacity - s.CurrentInventory;
                        string utilColor = util >= 90 ? "#E55A7E" : util < 20 ? "#F39C5A" : "#34C77B";

                        // FIX: Lấy Status trực tiếp từ Database (trả quyền cho Admin), không tính tự động nữa
                        string currentStatus = s.Status != null ? s.Status.ToString() : "Active";
                        string statusKey = currentStatus.ToLower();
                        string badgeClass = statusKey == "active" ? "sp-active" : statusKey == "maintenance" ? "sp-maint" : "sp-offline";
                        string badgeTxt = currentStatus;

                        <tr data-district="@s.Location.ToLower()"
                            data-status="@statusKey"
                            data-name="@s.StationName.ToLower() @s.Location.ToLower()">
                            <td><input type="checkbox" class="row-check" value="@s.StationId" onchange="updateBulkBar()" /></td>
                            <td><span class="id-chip">ST-@idx.ToString("D3")</span></td>
                            <td style="font-weight:600;">@s.StationName</td>
                            <td style="color:var(--text-muted);font-size:12.5px;">@s.Location</td>
                            <td>
                                <span class="inv-chip">🚲 @(s.CurrentInventory / 2)</span>
                                <span class="inv-div">|</span>
                                <span class="inv-chip">🛴 @(s.CurrentInventory - s.CurrentInventory / 2)</span>
                            </td>
                            <td style="font-weight:600;text-align:center;">@s.Capacity</td>
                            <td style="text-align:center;font-weight:700;
                                color:@(availSlots == 0 ? "#E55A7E" : availSlots <= 3 ? "#F39C5A" : "#34C77B");">
                                @availSlots
                            </td>
                            <td>
                                <div class="util-row">
                                    <span class="util-pct" style="color:@utilColor;">@Math.Round(util, 1)%</span>
                                    <div class="util-bar-wrap">
                                        <div class="util-bar-fill" style="width:@(Math.Min(util, 100))%;background:@utilColor;"></div>
                                    </div>
                                </div>
                            </td>
                            <td><span class="status-pill @badgeClass">@badgeTxt</span></td>
                            <td style="text-align:center;">
                                <!-- Trừ hao trường hợp null Lat/Lng để gán 0 -->
                                <button class="act-btn edit" title="Edit"
                                        onclick="openEditModal(@s.StationId,'@Html.Raw(s.StationName)','@Html.Raw(s.Location)',@s.Capacity,@s.CurrentInventory, '@statusKey', @(s.Latitude ?? 10.7769), @(s.Longitude ?? 106.7009))">
                                    <i class="fas fa-pen"></i>
                                </button>
                                <form method="post" action="/Station/Delete/@s.StationId" style="display:inline;"
                                      onsubmit="return confirm('Delete station @Html.Raw(s.StationName)?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="act-btn del" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                        idx++;
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- FIX: Bulk bar đã chèn lại nút Update Status -->
    <div class="sel-bar" id="bulkBar" style="display:none;">
        <span class="sel-info">
            <span id="bulkCount">0</span> Selected
            <span class="clear-sel" onclick="clearSelection()">Clear selection</span>
        </span>
        <div class="sel-actions">
            <button class="btn-filled" style="background:#34C77B; border:none; padding:7px 14px; border-radius:8px; font-size:12.5px; margin-right:5px;" onclick="openModal('bulkUpdateModal', 'none')">
                <i class="fas fa-sync-alt" style="margin-right:4px;"></i> Update Status
            </button>
            <button class="btn-danger" onclick="bulkDeleteStations()">
                <i class="fas fa-trash" style="margin-right:4px;"></i> Delete Selected
            </button>
        </div>
    </div>

    <!-- Pagination thật — JS tự render -->
    <div class="pag-bar">
        <div class="pag-info" id="pagInfo">Page 1 of 1</div>
        <div class="pag-btns" id="pagBtns"></div>
    </div>
</div>

<!-- ADD STATION MODAL -->
<div class="modal-backdrop-custom" id="addModal">
    <div class="modal-box">
        <div class="modal-header-custom">
            <h4>
                <i class="fas fa-map-marker-alt" style="margin-right:8px;"></i>
                <span data-i18n="Add New Station">Add New Station</span>
            </h4>
        </div>
        <form method="post" action="/Station/Create">
            @Html.AntiForgeryToken()
            <div class="modal-body-custom">
                <label class="form-label-custom" data-i18n="Station Name">Station Name</label>
                <input name="StationName" class="form-input-custom" placeholder="e.g. Ben Thanh Market" required maxlength="100" />

                <label class="form-label-custom" data-i18n="Location / Address">Location / Address</label>
                <input name="Location" class="form-input-custom" placeholder="e.g. District 1, Ho Chi Minh City" required maxlength="200" />

                <!-- FIX: Thêm dropdown Status -->
                <label class="form-label-custom">Station Status</label>
                <select name="Status" class="form-input-custom" style="margin-bottom:16px;">
                    <option value="Active">Active</option>
                    <option value="Maintenance">Maintenance</option>
                    <option value="Offline">Offline</option>
                </select>

                <!-- FIX: Bản đồ ghim vị trí thật -->
                <label class="form-label-custom">Pin Location (Click on map)</label>
                <div id="addMap" class="map-picker"></div>
                <input type="hidden" name="Latitude" id="addLat" value="10.7769" />
                <input type="hidden" name="Longitude" id="addLng" value="106.7009" />

                <label class="form-label-custom" data-i18n="Max Capacity">Max Capacity</label>
                <input name="Capacity" type="number" min="1" max="500" class="form-input-custom" placeholder="e.g. 50" required />
            </div>
            <div style="padding:0 24px 24px;">
                <div class="modal-footer-custom">
                    <button type="button" class="btn-cancel" onclick="closeModal('addModal')" data-i18n="Cancel">Cancel</button>
                    <button type="submit" class="btn-save">
                        <i class="fas fa-save" style="margin-right:5px;"></i>
                        <span data-i18n="Save Station">Save Station</span>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- EDIT STATION MODAL -->
<div class="modal-backdrop-custom" id="editModal">
    <div class="modal-box">
        <div class="modal-header-custom">
            <h4>
                <i class="fas fa-pen" style="margin-right:8px;"></i>
                <span data-i18n="Edit Station">Edit Station</span> — <span id="editModalTitle"></span>
            </h4>
        </div>
        <form method="post" id="editForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="StationId" id="editStationId" />
            <div class="modal-body-custom">
                <label class="form-label-custom" data-i18n="Station Name">Station Name</label>
                <input name="StationName" id="editStationName" class="form-input-custom" required maxlength="100" />

                <label class="form-label-custom" data-i18n="Location / Address">Location / Address</label>
                <input name="Location" id="editLocation" class="form-input-custom" required maxlength="200" />

                <!-- FIX: Thêm dropdown Status -->
                <label class="form-label-custom">Station Status</label>
                <select name="Status" id="editStatus" class="form-input-custom" style="margin-bottom:16px;">
                    <option value="Active">Active</option>
                    <option value="Maintenance">Maintenance</option>
                    <option value="Offline">Offline</option>
                </select>

                <!-- FIX: Bản đồ ghim vị trí thật -->
                <label class="form-label-custom">Pin Location (Click on map)</label>
                <div id="editMap" class="map-picker"></div>
                <input type="hidden" name="Latitude" id="editLat" />
                <input type="hidden" name="Longitude" id="editLng" />

                <label class="form-label-custom" data-i18n="Max Capacity">Max Capacity</label>
                <input name="Capacity" id="editCapacity" type="number" min="1" max="500" class="form-input-custom" required />
                <div style="background:var(--body-bg);border-radius:10px;padding:12px 16px;border:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;">
                    <span style="font-size:13px;color:var(--text-muted);" data-i18n="Current Inventory">Current Inventory</span>
                    <span id="editInventoryInfo" style="font-weight:700;color:var(--primary-text);font-size:14px;">—</span>
                </div>
            </div>
            <div style="padding:0 24px 24px;">
                <div class="modal-footer-custom">
                    <button type="button" class="btn-cancel" onclick="closeModal('editModal')" data-i18n="Cancel">Cancel</button>
                    <button type="submit" class="btn-save">
                        <i class="fas fa-save" style="margin-right:5px;"></i>
                        <span data-i18n="Save Changes">Save Changes</span>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- FIX: BULK UPDATE MODAL -->
<div class="modal-backdrop-custom" id="bulkUpdateModal">
    <div class="modal-box" style="max-width: 400px;">
        <div class="modal-header-custom">
            <h4>
                <i class="fas fa-sync-alt" style="margin-right:8px; color:#34C77B;"></i>
                <span>Update Status for <span id="bulkUpdateCountTitle">0</span> Stations</span>
            </h4>
        </div>
        <form method="post" action="/Station/BulkUpdateStatus" id="bulkUpdateForm">
            @Html.AntiForgeryToken()
            <!-- Chứa mảng ID xe đang chọn -->
            <div id="bulkUpdateInputs"></div>

            <div class="modal-body-custom">
                <label class="form-label-custom">Select New Status</label>
                <select name="NewStatus" class="form-input-custom" required>
                    <option value="Active">Active</option>
                    <option value="Maintenance">Maintenance</option>
                    <option value="Offline">Offline</option>
                </select>
            </div>
            <div style="padding:0 24px 24px;">
                <div class="modal-footer-custom">
                    <button type="button" class="btn-cancel" onclick="closeModal('bulkUpdateModal')">Cancel</button>
                    <button type="button" class="btn-save" style="background:#34C77B; border-color:#34C77B;" onclick="submitBulkUpdate()">
                        <i class="fas fa-check" style="margin-right:5px;"></i> Apply Update
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    <!-- Thêm JS Leaflet -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        // ── Bản đồ ghim (Leaflet) ────────────────────────────────
        let mapAdd, mapEdit;
        let markerAdd, markerEdit;

        function initMaps() {
        // Map cho Add
        mapAdd = L.map('addMap').setView([10.7769, 106.7009], 13);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(mapAdd);
        markerAdd = L.marker([10.7769, 106.7009]).addTo(mapAdd);
        mapAdd.on('click', function (e) {
        markerAdd.setLatLng(e.latlng);
        document.getElementById('addLat').value = e.latlng.lat;
        document.getElementById('addLng').value = e.latlng.lng;
        });

        // Map cho Edit
        mapEdit = L.map('editMap').setView([10.7769, 106.7009], 13);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(mapEdit);
        mapEdit.on('click', function (e) {
        if (!markerEdit) { markerEdit = L.marker(e.latlng).addTo(mapEdit); }
        else { markerEdit.setLatLng(e.latlng); }
        document.getElementById('editLat').value = e.latlng.lat;
        document.getElementById('editLng').value = e.latlng.lng;
        });
        }

        // ── Modal ────────────────────────────────────────────────
        function openModal(id, mapType) {
        document.getElementById(id).classList.add('show');
        document.body.style.overflow = 'hidden';

        // Sửa lỗi Leaflet không load hết gạch (tiles) khi bị giấu trong display:none
        setTimeout(() => {
        if (mapType === 'add' && mapAdd) mapAdd.invalidateSize();
        if (mapType === 'edit' && mapEdit) mapEdit.invalidateSize();
        }, 100);

        if (id === 'bulkUpdateModal') {
        document.getElementById('bulkUpdateCountTitle').textContent = document.querySelectorAll('.row-check:checked').length;
        }
        }
        function closeModal(id) { document.getElementById(id).classList.remove('show'); document.body.style.overflow = ''; }

        document.querySelectorAll('.modal-backdrop-custom').forEach(m => m.addEventListener('click', e => { if (e.target === m) closeModal(m.id); }));
        document.addEventListener('keydown', e => { if (e.key === 'Escape') document.querySelectorAll('.modal-backdrop-custom.show').forEach(m => closeModal(m.id)); });

        function openEditModal(id, name, location, cap, inv, status, lat, lng) {
        document.getElementById('editStationId').value = id;
        document.getElementById('editStationName').value = name;
        document.getElementById('editLocation').value = location;
        document.getElementById('editCapacity').value = cap;

        // Chọn đúng Status
        const statusDrop = document.getElementById('editStatus');
        for (let i = 0; i < statusDrop.options.length; i++) {
        if (statusDrop.options[i].value.toLowerCase() === status) { statusDrop.selectedIndex = i; break; }
        }

        document.getElementById('editModalTitle').textContent = name;
        document.getElementById('editInventoryInfo').textContent = `${inv} / ${cap} vehicles`;
        document.getElementById('editForm').action = `/Station/Edit/${id}`;

        // Xử lý cắm cờ bản đồ edit
        document.getElementById('editLat').value = lat;
        document.getElementById('editLng').value = lng;
        setTimeout(() => {
        mapEdit.setView([lat, lng], 15);
        if (markerEdit) mapEdit.removeLayer(markerEdit);
        markerEdit = L.marker([lat, lng]).addTo(mapEdit);
        }, 100);

        openModal('editModal', 'edit');
        }

        // ── Pagination thật ──────────────────────────────────────
        const PAGE_SIZE = 7;
        let currentPage = 1;
        let allRows = [];

        function initPagination() {
        allRows = [...document.querySelectorAll('#stationBody tr')];
        allRows.forEach(r => r.dataset.filtered = 'true');
        goToPage(1);
        }

        function getFiltered() { return allRows.filter(r => r.dataset.filtered !== 'false'); }

        function goToPage(page) {
        const rows = getFiltered();
        const totalPages = Math.max(1, Math.ceil(rows.length / PAGE_SIZE));
        currentPage = Math.min(Math.max(1, page), totalPages);
        allRows.forEach(r => r.style.display = 'none');
        const start = (currentPage - 1) * PAGE_SIZE;
        rows.slice(start, start + PAGE_SIZE).forEach(r => r.style.display = '');
        const showing = Math.min(PAGE_SIZE, rows.length - start);
        document.getElementById('pagInfo').textContent = `Page ${currentPage} of ${totalPages} — ${rows.length} stations total`;
        document.getElementById('showingCount').textContent = `Showing ${showing} of ${rows.length} stations`;
        renderPagBtns(currentPage, totalPages);
        }

        function renderPagBtns(cur, total) {
        const c = document.getElementById('pagBtns');
        c.innerHTML = '';
        const mkBtn = (html, page, active) => {
        const b = document.createElement('button');
        b.className = 'pag-btn' + (active ? ' active' : '');
        b.innerHTML = html;
        if (page && page >= 1 && page <= total) b.onclick = () => goToPage(page);
        else b.disabled = true;
        return b;
        };
        c.appendChild(mkBtn('<i class="fas fa-chevron-left" style="font-size:10px;"></i>', cur - 1));
        const pages = new Set([1, total]);
        for (let i = Math.max(1, cur - 1); i <= Math.min(total, cur + 1); i++) pages.add(i);
        let prev = 0;
        [...pages].sort((a, b) => a - b).forEach(p => {
        if (p - prev > 1) { const sp = document.createElement('span'); sp.textContent = '…'; sp.style.cssText = 'padding:0 4px;color:var(--text-muted);line-height:28px;'; c.appendChild(sp); }
        c.appendChild(mkBtn(p, p, p === cur));
        prev = p;
        });
        c.appendChild(mkBtn('<i class="fas fa-chevron-right" style="font-size:10px;"></i>', cur + 1));
        }

        // ── Filter (ĐÃ FIX LỖI STATUS) ───────────────────────────
        function applyFilter() {
        const dist = document.getElementById('filterDistrict').value.toLowerCase();
        const status = document.getElementById('filterStatus').value.toLowerCase(); // Bắt giá trị status
        const search = document.getElementById('searchInput').value.toLowerCase();

        allRows.forEach(row => {
        const match =
        (!dist || (row.dataset.district || '').includes(dist)) &&
        (!status || (row.dataset.status || '').includes(status)) && // Kiểm tra status
        (!search || (row.dataset.name || '').includes(search));
        row.dataset.filtered = match ? 'true' : 'false';
        });
        goToPage(1);
        }

        // ── Selection & Bulk ─────────────────────────────────────
        function toggleAll(cb) {
        document.querySelectorAll('#stationBody tr').forEach(r => {
        if (r.style.display !== 'none') r.querySelector('.row-check').checked = cb.checked;
        });
        updateBulkBar();
        }
        function updateBulkBar() {
        const n = document.querySelectorAll('.row-check:checked').length;
        document.getElementById('bulkBar').style.display = n > 0 ? 'flex' : 'none';
        document.getElementById('bulkCount').textContent = n;
        }
        function clearSelection() { document.querySelectorAll('.row-check,#selectAll').forEach(c => c.checked = false); updateBulkBar(); }

        function bulkDeleteStations() {
        const ids = [...document.querySelectorAll('.row-check:checked')].map(c => c.value);
        if (!ids.length) return;
        if (!confirm(`Delete ${ids.length} station(s)?`)) return;
        const tok = document.querySelector('input[name="__RequestVerificationToken"]').value;
        Promise.all(ids.map(id => fetch(`/Station/Delete/${id}`, { method: 'POST', headers: { 'RequestVerificationToken': tok } })))
        .then(() => location.reload());
        }

        function submitBulkUpdate() {
        const ids = [...document.querySelectorAll('.row-check:checked')].map(c => c.value);
        if (!ids.length) return;
        const container = document.getElementById('bulkUpdateInputs');
        container.innerHTML = '';
        // Nhét các ID đã chọn vào form ẩn để gửi về Backend
        ids.forEach(id => {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'stationIds'; // Tên biến mảng List<int> bên C# Controller
        input.value = id;
        container.appendChild(input);
        });
        document.getElementById('bulkUpdateForm').submit();
        }

        // ── Export CSV ───────────────────────────────────────────
        function exportTableCSV() {
        const rows = [['Station', 'Location', 'Capacity', 'Available', 'Utilization', 'Status']];
        getFiltered().forEach(row => {
        const c = row.querySelectorAll('td');
        if (c.length < 8) return;
        rows.push([c[2], c[3], c[5], c[6], c[7], c[8]].map(x => `"${x.textContent.trim().replace(/"/g, '""')}"`));
        });
        const a = document.createElement('a');
        a.href = 'data:text/csv;charset=utf-8,\uFEFF' + encodeURIComponent(rows.map(r => r.join(',')).join('\n'));
        a.download = `stations_${new Date().toISOString().slice(0, 10)}.csv`;
        a.click();
        }

        document.addEventListener('DOMContentLoaded', () => {
        initMaps();
        initPagination();
        });
    </script>
}