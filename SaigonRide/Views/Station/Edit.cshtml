<div class="modal-backdrop-custom" id="editModal">
    <div class="modal-box">
        <div class="modal-header-custom">
            <h4>
                <i class="fas fa-pen" style="margin-right:8px;"></i>
                <span data-i18n="Edit Station">Edit Station</span> — <span id="editModalTitle"></span>
            </h4>
        </div>
        <form method="post" id="editForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="StationId" id="editStationId" />
            <div class="modal-body-custom">
                <label class="form-label-custom" data-i18n="Station Name">Station Name</label>
                <input name="StationName" id="editStationName" class="form-input-custom" required maxlength="100" />

                <label class="form-label-custom" data-i18n="Location / Address">Location / Address</label>
                <input name="Location" id="editLocation" class="form-input-custom" required maxlength="200" />

                <label class="form-label-custom">Station Status</label>
                <select name="Status" id="editStatus" class="form-input-custom" style="margin-bottom:16px;">
                    <option value="Active" data-i18n="Active">Active</option>
                    <option value="Maintenance" data-i18n="Maintenance">Maintenance</option>
                    <option value="Offline" data-i18n="Offline">Offline</option>
                </select>

                <label class="form-label-custom">Pin Location (Type above map to search)</label>
                <div id="editMap" class="map-picker"></div>
                <input type="hidden" name="Latitude" id="editLat" />
                <input type="hidden" name="Longitude" id="editLng" />

                <label class="form-label-custom" data-i18n="Max Capacity">Max Capacity</label>
                <input name="Capacity" id="editCapacity" type="number" min="1" max="500" class="form-input-custom" required />
                
                <div style="background:var(--body-bg);border-radius:10px;padding:12px 16px;border:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;">
                    <span style="font-size:13px;color:var(--text-muted);" data-i18n="Current Inventory">Current Inventory</span>
                    <span id="editInventoryInfo" style="font-weight:700;color:var(--primary-text);font-size:14px;">—</span>
                </div>
            </div>
            <div class="modal-footer-custom" style="padding: 12px 24px 20px;">
                <button type="button" class="btn-cancel" onclick="closeModal('addModal')" data-i18n="Cancel">Cancel</button>
                <button type="submit" class="btn-save">
                    <i class="fas fa-save" style="margin-right:5px;"></i>
                    <span data-i18n="Save Changes">Save Changes</span>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function openEditModal(id, name, location, cap, inv, status, lat, lng) {
        document.getElementById('editStationId').value = id;
        document.getElementById('editStationName').value = name;
        document.getElementById('editLocation').value = location;
        document.getElementById('editCapacity').value = cap;

        const statusDrop = document.getElementById('editStatus');
        for (let i = 0; i < statusDrop.options.length; i++) {
            if (statusDrop.options[i].value.toLowerCase() === status) { 
                statusDrop.selectedIndex = i; 
                break; 
            }
        }

        document.getElementById('editModalTitle').textContent = name;
        document.getElementById('editInventoryInfo').textContent = `${inv} / ${cap} vehicles`;
        document.getElementById('editForm').action = `/Station/Edit/${id}`;

        document.getElementById('editLat').value = lat;
        document.getElementById('editLng').value = lng;
        
        setTimeout(() => {
            mapEdit.setView([lat, lng], 15);
            if (markerEdit) mapEdit.removeLayer(markerEdit);
            markerEdit = L.marker([lat, lng]).addTo(mapEdit);
        }, 100);

        openModal('editModal', 'edit');
    }
</script>