                grid-template-columns: 1fr;
            }

            .helper-row {
                grid-template-columns: 1fr;
            }

            .helper-card {
                border-right: none;
                border-bottom: 1px solid #eee4ff;
            }

            .helper-card:last-child {
                border-bottom: none;
            }

            .topbar-right {
                display: none;
            }
        }
    </style>
</head>

<body>
    @await Html.PartialAsync("~/Views/Shared/_UserTopbar.cshtml", currentUser)

    <main data-auto-i18n class="checkout-page">
        <div class="checkout-canvas">
            <div class="checkout-wrap">
                <a asp-controller="UserRental"
                   asp-action="MyTrip"
                   asp-route-id="@Model.RentalId"
                   class="back-btn">
                    <i class="fa-solid fa-arrow-left"></i>
                </a>

                <div class="checkout-header">
                    <div class="checkout-title">Hoàn tất chuyến đi & Thanh toán</div>

                    <div class="checkout-sub">
                        <i class="fa-solid fa-circle-check"></i>
                        Cảm ơn bạn đã sử dụng SaigonRide. Vui lòng kiểm tra thông tin chuyến đi và hoàn tất thanh toán.
                    </div>

@{
    var errorMessage = TempData["Error"]?.ToString();
}

@if (!string.IsNullOrWhiteSpace(errorMessage)
    && !errorMessage.Contains("passport"))
{
    <div class="payment-alert">
        <i class="fa-solid fa-circle-exclamation"></i>
        @errorMessage
    </div>
}
                </div>

                <div class="checkout-grid">
                    <section class="checkout-card">
                        <div class="section-title">
                            <span class="section-icon">
                                <i class="fa-solid fa-receipt"></i>
                            </span>
                            Tóm tắt chuyến đi
                        </div>

                        <div class="vehicle-row">
                            <div class="vehicle-img-box">
                                <span class="category-pill">@categoryName</span>
                                <img src="@imagePath" alt="@vehicleName" onerror="this.style.display='none'" />
                            </div>

                            <div>
                                <div class="vehicle-name">@vehicleName</div>
                                <div class="vehicle-code">Mã xe: @vehicleCode</div>
                                <div class="vehicle-condition">Tình trạng tốt</div>
                            </div>
                        </div>

                        <div class="route-section">
                            <div class="station-box">
                                <div class="station-label">
                                    <i class="fa-solid fa-location-dot"></i>
                                    Trạm bắt đầu
                                </div>
                                <div class="station-name">@startStation</div>
                                <div class="station-address">TP. Hồ Chí Minh</div>
                            </div>

                            <div class="timeline">
                                <div class="timeline-time start">@startTime</div>
                                <div class="timeline-time end">@endTime</div>
                                <div class="timeline-line"></div>
                                <div class="timeline-mid">
                                    <i class="fa-solid fa-angle-right"></i>
                                </div>
                            </div>

                            <div class="station-box end">
                                <div class="station-label">
                                    <i class="fa-solid fa-location-dot"></i>
                                    Trạm trả xe
                                </div>
                                <div class="station-name">@endStation</div>
                                <div class="station-address">TP. Hồ Chí Minh</div>

                                @if (discount > 0)
                                {
                                    <div class="discount-mini">Ưu đãi trạm thiếu xe: giảm 15%</div>
                                }
                            </div>
                        </div>

                        <div class="summary-stats">
                            <div class="stat-box">
                                <div class="stat-icon">
                                    <i class="fa-regular fa-clock"></i>
                                </div>
                                <div>
                                    <div class="stat-label">Thời lượng</div>
                                    <div class="stat-value">@durationText</div>
                                </div>
                            </div>

                            <div class="stat-box">
                                <div class="stat-icon">
                                    <i class="fa-solid fa-tag"></i>
                                </div>
                                <div>
                                    <div class="stat-label">Đơn giá</div>
                                    <div class="stat-value">
                                        @pricePerMinute.ToString("N0")
                                        <small>VND/phút</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="fare-line">
                            <span>Tạm tính (@durationText × @pricePerMinute.ToString("N0") VND/phút)</span>
                            <span>@baseFare.ToString("N0") VND</span>
                        </div>

                        <div class="fare-line discount">
                            @if (discount > 0)
                            {
                                <span>Giảm 15% - Trả xe tại trạm thiếu xe</span>
                                <span>-@discount.ToString("N0") VND</span>
                            }
                            else
                            {
                                <span>Không áp dụng giảm giá trạm thiếu xe</span>
                                <span>-0 VND</span>
                            }
                        </div>

                        <div class="total-row">
                            <span class="total-label">Tổng thanh toán</span>
                            <span class="total-value">@finalFare.ToString("N0") VND</span>
                        </div>
                    </section>

                    <section class="checkout-card">
                        <div class="section-title">
                            <span class="section-icon">
                                <i class="fa-solid fa-wallet"></i>
                            </span>
                            Chọn phương thức thanh toán
                        </div>

                        <div class="method-tabs">
                            @if (!isForeign)
                            {
                                <button type="button" class="method-tab active">
                                    <i class="fa-solid fa-house"></i>
                                    Thanh toán nội địa
                                </button>

                                <button type="button" class="method-tab disabled-tab" disabled>
                                    <i class="fa-solid fa-globe"></i>
                                    Thanh toán quốc tế
                                </button>
                            }
                            else
                            {
                                <button type="button" class="method-tab disabled-tab" disabled>
                                    <i class="fa-solid fa-house"></i>
                                    Thanh toán nội địa
                                </button>

                                <button type="button" class="method-tab active">
                                    <i class="fa-solid fa-globe"></i>
                                    Thanh toán quốc tế
                                </button>
                            }
                        </div>

                        <form asp-controller="UserRental" asp-action="Pay" method="post">
                            @Html.AntiForgeryToken()

                            <input type="hidden" name="rentalId" value="@Model.RentalId" />

                            @if (!isForeign)
                            {
                                <div class="method-group active">
                                    <label class="payment-option selected">
                                        <input type="radio"
                                               name="method"
                                               value="@SaigonRide.Models.PaymentMethod.Wallet"
                                               checked />

                                        <span class="pay-icon wallet-icon">
                                            <i class="fa-solid fa-wallet"></i>
                                        </span>

                                        <span>
                                            <span class="method-name">
                                                Ví SaigonRide
                                                <span class="recommend-pill">Đề xuất</span>
                                            </span>

                                            <span class="method-desc d-block">
                                                Số dư:
                                                <span class="wallet-balance">@walletBalance.ToString("N0") VND</span>
                                            </span>

                                            @if (walletInsufficient)
                                            {
                                                <span class="wallet-warning d-block">
                                                    Số dư trong ví không đủ. Vui lòng chọn phương thức thanh toán khác.
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="wallet-note d-block">Thanh toán nhanh bằng số dư ví</span>
                                            }
                                        </span>

                                        <span class="check-circle">
                                            <i class="fa-solid fa-check"></i>
                                        </span>
                                    </label>

                                    <label class="payment-option">
                                        <input type="radio" name="method" value="@SaigonRide.Models.PaymentMethod.MoMo" />
                                        <span class="pay-icon momo-icon">mo</span>
                                        <span>
                                            <span class="method-name">MoMo</span>
                                            <span class="method-desc d-block">Thanh toán bằng ví MoMo</span>
                                        </span>
                                        <span class="check-circle">
                                            <i class="fa-solid fa-check"></i>
                                        </span>
                                    </label>

                                    <label class="payment-option">
                                        <input type="radio" name="method" value="@SaigonRide.Models.PaymentMethod.VNPay" />
                                        <span class="pay-icon vnpay-icon">VN</span>
                                        <span>
                                            <span class="method-name">VNPAY</span>
                                            <span class="method-desc d-block">Thanh toán qua cổng VNPAY</span>
                                        </span>
                                        <span class="check-circle">
                                            <i class="fa-solid fa-check"></i>
                                        </span>
                                    </label>

                                    <label class="payment-option">
                                        <input type="radio" name="method" value="@SaigonRide.Models.PaymentMethod.Cash" />
                                        <span class="pay-icon cash-icon">
                                            <i class="fa-solid fa-money-bill-wave"></i>
                                        </span>
                                        <span>
                                            <span class="method-name">Tiền mặt</span>
                                            <span class="method-desc d-block">Thanh toán trực tiếp tại trạm</span>
                                        </span>
                                        <span class="check-circle">
                                            <i class="fa-solid fa-check"></i>
                                        </span>
                                    </label>
                                </div>
                            }
                            else
                            {
                                <div class="method-group active">
                                    <label class="payment-option selected">
                                        <input type="radio"
                                               name="method"
                                               value="@SaigonRide.Models.PaymentMethod.ApplePay"
                                               checked />

                                        <span class="pay-icon apple-icon">
                                            <i class="fa-brands fa-apple"></i>
                                        </span>

                                        <span>
                                            <span class="method-name">Apple Pay</span>
                                            <span class="method-desc d-block">Thanh toán nhanh từ thiết bị của bạn</span>
                                        </span>

                                        <span class="check-circle">
                                            <i class="fa-solid fa-check"></i>
                                        </span>
                                    </label>

                                    <label class="payment-option">
                                        <input type="radio" name="method" value="@SaigonRide.Models.PaymentMethod.PayPal" />
                                        <span class="pay-icon paypal-icon">
                                            <i class="fa-brands fa-paypal"></i>
                                        </span>
                                        <span>
                                            <span class="method-name">PayPal</span>
                                            <span class="method-desc d-block">Thanh toán bằng tài khoản PayPal</span>
                                        </span>
                                        <span class="check-circle">
                                            <i class="fa-solid fa-check"></i>
                                        </span>
                                    </label>

                                    <label class="payment-option">
                                        <input type="radio" name="method" value="@SaigonRide.Models.PaymentMethod.Cash" />
                                        <span class="pay-icon cash-icon">
                                            <i class="fa-solid fa-money-bill-wave"></i>
                                        </span>
                                        <span>
                                            <span class="method-name">Tiền mặt</span>
                                            <span class="method-desc d-block">Thanh toán trực tiếp tại trạm</span>
                                        </span>
                                        <span class="check-circle">
                                            <i class="fa-solid fa-check"></i>
                                        </span>
                                    </label>
                                </div>
                            }

                            <button type="submit"
                                    id="paySubmit"
                                    class="pay-submit">
                                <i class="fa-solid fa-lock"></i>
                                Xác nhận thanh toán @finalFare.ToString("N0") VND
                            </button>
                        </form>
                    </section>
                </div>

                <div class="helper-row">
                    <div class="helper-card">
                        <div class="helper-icon">
                            <i class="fa-solid fa-leaf"></i>
                        </div>
                        <div>
                            <div class="helper-title">Lựa chọn thân thiện môi trường</div>
                            <div class="helper-sub">Bạn đã góp phần giảm phát thải CO₂</div>
                        </div>
                    </div>

                    <div class="helper-card">
                        <div class="helper-icon">
                            <i class="fa-solid fa-shield-halved"></i>
                        </div>
                        <div>
                            <div class="helper-title">An toàn & bảo mật</div>
                            <div class="helper-sub">Thông tin thanh toán được bảo vệ</div>
                        </div>
                    </div>

                    <div class="helper-card">
                        <div class="helper-icon">
                            <i class="fa-solid fa-headset"></i>
                        </div>
                        <div>
                            <div class="helper-title">Cần hỗ trợ?</div>
                            <div class="helper-sub">Liên hệ hỗ trợ 24/7</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script>
        const walletInsufficient = @walletInsufficient.ToString().ToLower();

        function syncPayButton() {
            const selectedMethod = document.querySelector('input[name="method"]:checked')?.value;
            const paySubmit = document.getElementById("paySubmit");

            if (!paySubmit) return;

            if (selectedMethod === "Wallet" && walletInsufficient) {
                paySubmit.disabled = true;
            } else {
                paySubmit.disabled = false;
            }
        }

        document.querySelectorAll(".payment-option").forEach(option => {
            option.addEventListener("click", () => {
                const group = option.closest(".method-group");

                group.querySelectorAll(".payment-option").forEach(item => {
                    item.classList.remove("selected");
                });

                option.classList.add("selected");

                const input = option.querySelector('input[type="radio"]');

                if (input) {
                    input.checked = true;
                }

                syncPayButton();
            });
        });

        syncPayButton();
    </script>

    <script src="@Url.Content("~/js/saigonride-i18n.js")"></script>
</body>
</html>