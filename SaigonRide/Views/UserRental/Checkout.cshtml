@using Microsoft.AspNetCore.Http
@model SaigonRide.Models.Rental

@{
    Layout = null;
    ViewData["Title"] = "Thanh toán";
    ViewBag.ActivePage = "MyTrip";

    var rental = Model;
    var vehicle = rental.Vehicle;
    var category = vehicle?.Category;
    var currentUser = ViewBag.CurrentUser as SaigonRide.Models.User ?? rental.User;

    var categoryName = category?.CategoryName ?? "Phương tiện";
    var isScooter = categoryName.Contains("Scooter");

    var imagePath = isScooter
        ? Url.Content("~/images/scooter.png")
        : Url.Content("~/images/bike.png");

    var vehicleName = vehicle?.VehicleName ?? "Không xác định";
    var vehicleCode = vehicle?.VehicleCode ?? "N/A";
    var pricePerMinute = category?.PricePerMinute ?? 0;

    var startStation = rental.StartStation?.StationName ?? "Không xác định";
    var endStation = rental.DestinationStation?.StationName ?? "Không xác định";

    var startTime = rental.StartTime.ToString("HH:mm");
    var endTime = rental.EndTime?.ToString("HH:mm") ?? "--:--";

    var totalTripSeconds = rental.EndTime.HasValue
        ? Math.Max(1, (int)(rental.EndTime.Value - rental.StartTime).TotalSeconds)
        : Math.Max(1, (int)(DateTime.Now - rental.StartTime).TotalSeconds);

    var displayMinutes = totalTripSeconds / 60;
    var displaySeconds = totalTripSeconds % 60;

    var durationText = displayMinutes > 0
        ? $"{displayMinutes} phút {displaySeconds} giây"
        : $"{displaySeconds} giây";

    var baseFare = rental.BaseFare;
    var discount = rental.DiscountAmount;
    var finalFare = rental.FinalFare;

    var walletBalance = currentUser?.WalletBalance ?? 0m;
    var isForeign = currentUser?.Role == SaigonRide.Models.UserRole.ForeignTourist;
    var walletInsufficient = !isForeign && walletBalance < finalFare;
}

