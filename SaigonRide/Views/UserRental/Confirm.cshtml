@model SaigonRide.Models.Vehicle

@{
    Layout = null;
    ViewData["Title"] = "Confirm Rental";

    var vehicles = ViewBag.Vehicles as List<SaigonRide.Models.Vehicle> ?? new List<SaigonRide.Models.Vehicle>();

    var selectedStationName = Model.Station?.StationName ?? "Unknown Station";
    var selectedCategoryName = Model.Category?.CategoryName ?? "";
    var selectedIsScooter = selectedCategoryName.Contains("Scooter");

    var selectedImagePath = selectedIsScooter
        ? Url.Content("~/images/scooter.png")
        : Url.Content("~/images/bike.png");

    var selectedStatusClass =
        Model.Status == SaigonRide.Models.VehicleStatus.Available
        ? "available"
        : Model.Status == SaigonRide.Models.VehicleStatus.InTransit
        ? "intransit"
        : "maintenance";

    int? selectedBatteryLevel = null;

    if (selectedIsScooter)
    {
        selectedBatteryLevel =
            Model.Status == SaigonRide.Models.VehicleStatus.Available
            ? 100
            : Model.Status == SaigonRide.Models.VehicleStatus.InTransit
            ? 34
            : 13;
    }

    var selectedBatteryClass = "";

    if (selectedBatteryLevel.HasValue)
    {
        selectedBatteryClass =
            selectedBatteryLevel.Value >= 60
            ? "high"
            : selectedBatteryLevel.Value >= 30
            ? "medium"
            : "low";
    }

    var selectedPrice = Model.Category?.PricePerMinute ?? 0;
    var currentUser = ViewBag.CurrentUser as SaigonRide.Models.User;
    var currentUserName = currentUser?.FullName ?? Context.Session.GetString("UserName") ?? "User";
    var walletBalance = currentUser?.WalletBalance ?? 0m;
    var isForeignTourist = currentUser?.Role == SaigonRide.Models.UserRole.ForeignTourist;
    var avatarText = !string.IsNullOrWhiteSpace(currentUserName) && currentUserName.Length >= 2
        ? currentUserName.Substring(0, 2).ToUpper()
        : "U";

}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Confirm Rental - SaigonRide</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                background: #fbf9ff;
                font-family: "Plus Jakarta Sans", sans-serif;
                color: #342b55;
                overflow: hidden;
            }

            .confirm-screen {
                position: relative;
                min-height: 100vh;
            }

            .rent-background {
                height: 100vh;
                overflow: hidden;
                opacity: .18;
                pointer-events: none;
            }

            .user-topbar {
                height: 62px;
                background: linear-gradient(90deg, #c9aff5, #f1b3d4);
                display: flex;
                align-items: center;
                padding: 0 26px;
            }

            .brand {
                display: flex;
                align-items: center;
                gap: 10px;
                margin-right: 72px;
                font-size: 17px;
                font-weight: 800;
                color: #2e254b;
            }

            .brand-icon {
                width: 34px;
                height: 34px;
                border-radius: 11px;
                background: rgba(255,255,255,.55);
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .nav-link-user {
                height: 62px;
                padding: 0 34px;
                display: flex;
                align-items: center;
                gap: 9px;
                color: #463a62;
                text-decoration: none;
                font-size: 14px;
                font-weight: 700;
            }

                .nav-link-user.active {
                    background: rgba(255,255,255,.42);
                    border-radius: 15px;
                }

            .topbar-right {
                margin-left: auto;
                display: flex;
                align-items: center;
                gap: 13px;
            }

            .wallet-pill,
            .profile-pill {
                background: rgba(255,255,255,.52);
                border: 1px solid rgba(255,255,255,.72);
                border-radius: 999px;
                padding: 8px 16px;
                font-size: 13px;
                font-weight: 700;
                color: #44375f;
            }

            .uc2-page {
                padding: 28px 0 50px;
            }

            .uc2-wrap {
                max-width: 1110px;
                margin: 0 auto;
            }

            .uc2-hero {
                height: 155px;
                border-radius: 24px;
                background: linear-gradient(90deg, #c7aff6 0%, #f2b0d3 100%);
                padding: 34px 42px;
                position: relative;
                overflow: hidden;
                margin-bottom: 22px;
            }

            .uc2-kicker {
                font-size: 10px;
                letter-spacing: 1.8px;
                text-transform: uppercase;
                color: rgba(60,50,90,.45);
                font-weight: 800;
                margin-bottom: 10px;
            }

            .uc2-hero-title {
                font-size: 26px;
                font-weight: 800;
                color: #3b305d;
                margin-bottom: 10px;
            }

            .uc2-hero-sub {
                font-size: 14px;
                color: rgba(60,50,90,.65);
            }

            .hero-city {
                position: absolute;
                right: 0;
                bottom: -6px;
                width: 430px;
                height: 125px;
                object-fit: cover;
                object-position: right bottom;
                opacity: .88;
                pointer-events: none;
                -webkit-mask-image: linear-gradient(to right, transparent 0%, black 26%, black 100%);
                mask-image: linear-gradient(to right, transparent 0%, black 26%, black 100%);
            }

            .uc2-filter {
                background: white;
                border: 1px solid #eee4ff;
                border-radius: 20px;
                padding: 16px 18px;
                margin-bottom: 26px;
            }

            .uc2-filter-row {
                display: grid;
                grid-template-columns: 175px 1fr 1fr 54px;
                gap: 14px;
                align-items: center;
            }

            .uc2-filter-label {
                display: flex;
                align-items: center;
                gap: 11px;
                height: 44px;
            }

            .uc2-station-icon {
                width: 31px;
                height: 31px;
                border-radius: 50%;
                background: #f5e7ff;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .uc2-station-text {
                font-size: 13px;
                font-weight: 700;
                color: #74668d;
                white-space: nowrap;
            }

            .uc2-input {
                height: 44px;
                border-radius: 14px;
                border: 1px solid #e8dcff;
                color: #65587e;
                font-size: 14px;
                padding-left: 16px;
            }

            .uc2-refresh {
                width: 44px;
                height: 44px;
                border-radius: 50%;
                border: 1px solid #f0d7eb;
                background: #fff7fb;
                color: #9c6ade;
                font-size: 22px;
            }

            .uc2-title-row {
                margin-bottom: 18px;
            }

            .uc2-section-title {
                font-size: 23px;
                font-weight: 800;
                color: #3e355d;
                margin: 0;
            }

            .uc2-card {
                background: white;
                border: 1px solid #eee4ff;
                border-radius: 22px;
                padding: 14px;
                height: 100%;
            }

            .uc2-img-box {
                height: 210px;
                border-radius: 18px;
                background: #fbf8ff;
                border: 1px solid #efe7ff;
                position: relative;
                display: flex;
                align-items: center;
                justify-content: center;
                overflow: hidden;
                margin-bottom: 14px;
            }

                .uc2-img-box img {
                    width: 90%;
                    height: 165px;
                    object-fit: contain;
                }

            .uc2-category {
                position: absolute;
                top: 13px;
                left: 13px;
                background: #eadcff;
                color: #8056df;
                padding: 5px 12px;
                border-radius: 999px;
                font-size: 10px;
                font-weight: 800;
            }

            .uc2-name {
                font-size: 16px;
                font-weight: 800;
                color: #231a38;
                margin-bottom: 9px;
            }

            .uc2-meta-row {
                display: flex;
                align-items: center;
                gap: 9px;
                margin-bottom: 10px;
            }

            .uc2-code {
                min-width: 108px;
                height: 25px;
                border-radius: 999px;
                background: #f5efff;
                border: 1px solid #e7dcff;
                color: #8b63f6;
                font-size: 10px;
                font-weight: 800;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 0 10px;
            }

            .uc2-status {
                min-width: 96px;
                height: 25px;
                border-radius: 999px;
                font-size: 10px;
                font-weight: 800;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                padding: 0 10px;
                margin-left: auto;
            }

            .available {
                background: #dff2d4;
                color: #2b9d46;
            }

            .intransit {
                background: #ffe79d;
                color: #9a7300;
            }

            .maintenance {
                background: #f4d9f2;
                color: #ba4d9c;
            }

            .uc2-price-row {
                display: flex;
                align-items: center;
                gap: 8px;
                margin-bottom: 14px;
                font-size: 14px;
                color: #948ca5;
            }

            .uc2-price-tag {
                display: flex;
                align-items: center;
                gap: 6px;
            }

            .uc2-price-tag i {
                    font-size: 12px;
                    color: #8f7ca8;
            }

            .uc2-battery {
                min-width: 28px;
                height: 17px;
                border-radius: 5px;
                color: white;
                font-size: 9px;
                font-weight: 800;
                display: inline-flex;
                align-items: center;
                justify-content: center;
            }

            .high {
                background: #35c66b;
            }

            .medium {
                background: #f3c343;
                color: #332800;
            }

            .low {
                background: #e64646;
            }

            .uc2-btn {
                width: 100%;
                height: 41px;
                border-radius: 13px;
                border: 0;
                font-size: 13px;
                font-weight: 800;
            }

                .uc2-btn.active {
                    background: linear-gradient(90deg, #b79cf4, #f1a7d1);
                    color: white;
                }

                .uc2-btn.disabled {
                    background: #efefef;
                    color: #9f9f9f;
                }

            .modal-layer {
                position: fixed;
                inset: 0;
                background: rgba(255,255,255,.62);
                backdrop-filter: blur(2px);
                display: flex;
                align-items: center;
                justify-content: center;
                z-index: 20;
            }

            .confirm-modal {
                width: 392px;
                min-height: 390px;
                background: #fff;
                border: 1px solid rgba(61,53,87,.28);
                border-radius: 26px;
                padding: 20px 20px 22px;
                box-shadow: 0 26px 70px rgba(45,38,64,.18);
            }

            .confirm-icon {
                width: 42px;
                height: 42px;
                border: 2px solid #342b55;
                border-radius: 50%;
                margin: 0 auto 14px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 22px;
                font-weight: 800;
                color: #342b55;
                background: #f6efff;
            }

            .confirm-title {
                text-align: center;
                font-size: 24px;
                font-weight: 800;
                color: #231a38;
                margin-bottom: 9px;
            }

            .confirm-text {
                text-align: center;
                font-size: 12.5px;
                line-height: 1.45;
                font-weight: 700;
                color: #342b55;
                margin-bottom: 20px;
            }

            .confirm-highlight {
                color: #8b63f6;
                font-weight: 800;
            }

            .confirm-card {
                border: 1px solid rgba(61,53,87,.24);
                border-radius: 16px;
                display: grid;
                grid-template-columns: 120px 1fr;
                overflow: hidden;
                background: #fff;
                margin-bottom: 18px;
                min-height: 124px;
            }

            .confirm-img-box {
                border-right: 1px solid #eee4ff;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 12px;
                background: #fcf9ff;
            }

            .confirm-img-box > img {
                width: 108px !important;
                height: 82px !important;
                max-width: 92px !important;
                max-height: 82px !important;
                object-fit: contain !important;
                display: block;
                }

            .confirm-details {
                padding: 15px 22px 18px 30px;
                display: flex;
                flex-direction: column;
                justify-content: center;
            }

            .confirm-name {
                font-size: 16px;
                font-weight: 800;
                color: #231a38;
                margin-bottom: 7px;
            }

            .confirm-row {
                display: flex;
                align-items: center;
                gap: 8px;
                flex-wrap: wrap;
                margin-bottom: 8px;
            }

            .confirm-code {
                min-height: 22px;
                padding: 4px 10px;
                border-radius: 999px;
                background: #f5efff;
                border: 1px solid #e7dcff;
                color: #8b63f6;
                font-size: 9.5px;
                font-weight: 800;
                display: inline-flex;
                align-items: center;
            }

            .confirm-status {
                min-height: 22px;
                padding: 5px 10.5px;
                border-radius: 999px;
                background: #f5efff;
                border: 1px solid #e7dcff;
                color: #3f9b41;
                font-size: 9.5px;
                font-weight: 800;
                display: inline-flex;
                align-items: center;
            }

            .confirm-meta {
                display: flex;
                align-items: center;
                gap: 8px;
                flex-wrap: wrap;
                font-size: 11px;
                color: #5f5575;
                font-weight: 600;
            }

            .confirm-battery {
                min-width: 28px;
                height: 17px;
                border-radius: 5px;
                color: white;
                font-size: 9px;
                font-weight: 800;
                display: inline-flex;
                align-items: center;
                justify-content: center;
            }

            .confirm-price {
                display: flex;
                align-items: center;
                gap: 6px;
                color: #6f6585;
                white-space: nowrap;
                font-size: 11px;
                font-weight: 600;
            }

            .confirm-price i {
                font-size: 10px;
                color: #8f7ca8;
            }

            .confirm-actions {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 14px;
                margin-top: 18px;
            }

            .confirm-cancel,
            .confirm-submit {
                height: 42px;
                border-radius: 10px;
                border: none;
                font-size: 13px;
                font-weight: 800;
                display: flex;
                align-items: center;
                justify-content: center;
                text-decoration: none;
                font-family: inherit;
            }

            .confirm-cancel {
                background: #f8b7d1;
                color: #342b55;
            }

            .confirm-submit {
                width: 100%;
                background: linear-gradient(90deg, #c9aff5, #f1b3d4);
                color: white;
                cursor: pointer;
            }
    </style>

    <link rel="stylesheet" href="@Url.Content("~/css/user-topbar.css")" />
</head>

<body>
    <div class="confirm-screen">

        <div class="rent-background">

            @{ ViewBag.ActivePage = "Rent"; }
    @await Html.PartialAsync("~/Views/Shared/_UserTopbar.cshtml", currentUser)

            <div class="uc2-page">
                <div class="uc2-wrap">

                    <div class="uc2-hero">
                        <div>
                            <div class="uc2-kicker">Fleet Overview</div>
                            <div class="uc2-hero-title">Start Your Rental</div>
                            <div class="uc2-hero-sub">
                                Choose a pick-up station and select a vehicle to start your journey
                            </div>
                        </div>

                        <img src="~/images/city.png"
                             class="hero-city"
                             alt="City"
                             onerror="this.style.display='none'" />
                    </div>

                    <form class="uc2-filter">
                        <div class="uc2-filter-row">

                            <div class="uc2-filter-label">
                                <div class="uc2-station-icon">📍</div>
                                <div class="uc2-station-text">Pick-up Station</div>
                            </div>

                            <select class="form-select uc2-input" disabled>
                                <option>@selectedStationName</option>
                            </select>

                            <select class="form-select uc2-input" disabled>
                                <option>🚲 All Categories</option>
                            </select>

                            <button type="button" class="uc2-refresh" disabled>
                                &#10227;
                            </button>

                        </div>
                    </form>

                    <div class="uc2-title-row">
                        <h3 class="uc2-section-title">
                            Available Vehicles at @selectedStationName
                        </h3>
                    </div>

                    <div class="row g-4">
                        @foreach (var vehicle in vehicles)
                        {
                            var categoryName = vehicle.Category?.CategoryName ?? "";
                            var isScooter = categoryName.Contains("Scooter");

                            var imagePath = isScooter
                                ? Url.Content("~/images/scooter.png")
                                : Url.Content("~/images/bike.png");

                            var statusClass =
                                vehicle.Status == SaigonRide.Models.VehicleStatus.Available
                                ? "available"
                                : vehicle.Status == SaigonRide.Models.VehicleStatus.InTransit
                                ? "intransit"
                                : "maintenance";

                            int? batteryLevel = null;
                            var batteryClass = "";

                            if (isScooter)
                            {
                                batteryLevel =
                                    vehicle.Status == SaigonRide.Models.VehicleStatus.Available
                                    ? 100
                                    : vehicle.Status == SaigonRide.Models.VehicleStatus.InTransit
                                    ? 34
                                    : 13;

                                batteryClass =
                                    batteryLevel.Value >= 60
                                    ? "high"
                                    : batteryLevel.Value >= 30
                                    ? "medium"
                                    : "low";
                            }

                            <div class="col-xl-3 col-lg-4 col-md-6">
                                <div class="uc2-card">

                                    <div class="uc2-img-box">
                                        <div class="uc2-category">
                                            @vehicle.Category?.CategoryName
                                        </div>

                                        <img src="@imagePath"
                                             alt="@vehicle.VehicleName"
                                             onerror="this.style.display='none'" />
                                    </div>

                                    <div class="uc2-name">
                                        @vehicle.VehicleName
                                    </div>

                                    <div class="uc2-meta-row">
                                        <div class="uc2-code">
                                            ID: @vehicle.VehicleCode
                                        </div>

                                        <div class="uc2-status @statusClass">
                                            @vehicle.Status
                                        </div>
                                    </div>

                                    <div class="uc2-price-row">
                                        @if (batteryLevel.HasValue)
                                        {
                                            <div class="uc2-battery @batteryClass">
                                                @batteryLevel
                                            </div>

                                            <span>•</span>
                                        }

                                        <span class="uc2-price-tag">
                                            <i class="fa-solid fa-tag"></i>
                                            @vehicle.Category?.PricePerMinute.ToString("N0") VND/min
                                        </span>
                                    </div>

                                    @if (vehicle.Status == SaigonRide.Models.VehicleStatus.Available)
                                    {
                                        <button class="uc2-btn active" disabled>
                                            Rent This
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="uc2-btn disabled" disabled>
                                            Rent This
                                        </button>
                                    }

                                </div>
                            </div>
                        }
                    </div>

                </div>
            </div>

        </div>

        <div class="modal-layer">

            <div class="confirm-modal">

                <div class="confirm-icon">
                    ?
                </div>

                <div class="confirm-title">
                    Confirm Rental
                </div>

                <div class="confirm-text">
                    Start rental for
                    <span class="confirm-highlight">@Model.VehicleName</span>
                    at
                    <span class="confirm-highlight">@selectedStationName</span>
                    ?
                </div>

                <div class="confirm-card">

                    <div class="confirm-img-box">
                        <img src="@selectedImagePath"
                             alt="@Model.VehicleName"
                             onerror="this.style.display='none'" />
                    </div>

                    <div class="confirm-details">

                        <div class="confirm-name">
                            @Model.VehicleName
                        </div>

                        <div class="confirm-row">
                            <span class="confirm-code">
                                ID: @Model.VehicleCode
                            </span>

                            <span class="confirm-status @selectedStatusClass">
                                @Model.Status
                            </span>
                        </div>

                        <div class="confirm-meta">

                            @if (selectedIsScooter && selectedBatteryLevel.HasValue)
                            {
                                <span class="confirm-battery @selectedBatteryClass">
                                    @selectedBatteryLevel
                                </span>

                                <span>•</span>
                            }

                            <span class="confirm-price">
                                <i class="fa-solid fa-tag"></i>
                                @selectedPrice.ToString("N0") VND/min
                            </span>

                        </div>

                    </div>

                </div>

                <div class="confirm-actions">

                    <a asp-controller="UserRental"
                           asp-action="Index"
                           asp-route-stationId="@Model.StationId"
                           class="confirm-cancel">
                        Cancel
                    </a>

                    <form asp-controller="UserRental"
                          asp-action="StartRental"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="vehicleId"
                               value="@Model.VehicleId" />

                        <button type="submit"
                                class="confirm-submit">
                            Confirm
                        </button>
                    </form>

                </div>

            </div>

        </div>

    </div>

    <script src="@Url.Content("~/js/saigonride-i18n.js")"></script>
</body>
</html>