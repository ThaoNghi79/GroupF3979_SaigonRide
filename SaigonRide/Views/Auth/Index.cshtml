@{
    ViewData["Title"] = "Login / Register";
    Layout = null; 
    var error = TempData["AuthError"]?.ToString();
    var panel = TempData["Panel"]?.ToString() ?? "login";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>SaigonRide — Login / Register</title>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&family=Playfair+Display:wght@700;800&display=swap" rel="stylesheet"/>
    <style>
        :root {
            --primary: #C9B8F5;
            --secondary: #F5B8D0;
            --warm: #FFD4A3;
            --yellow: #FFF3B0;
            --bg: #FAF8FF;
            --text: #2D2640;
            --muted: #8A7FAA;
            --border: rgba(201,184,245,0.35);
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            min-height: 100vh;
            font-family: 'Nunito', sans-serif;
            overflow-x: hidden;
        }

        body {
            display: flex;
            background: var(--bg);
        }

        .left {
            flex: 1 0 52%;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 60px 56px;
            overflow: hidden;
            min-height: 100vh;
        }

        .left-bg {
            position: absolute;
            inset: 0;
            background:
                radial-gradient(ellipse 70% 60% at 20% 30%, #dfd4ff 0%, transparent 60%),
                radial-gradient(ellipse 55% 50% at 80% 70%, #fbc8dd 0%, transparent 60%),
                radial-gradient(ellipse 60% 55% at 60% 10%, #ffe5c0 0%, transparent 55%),
                radial-gradient(ellipse 80% 80% at 50% 50%, #faf8ff 0%, #f0eaff 100%);
        }

        .blob {
            position: absolute;
            border-radius: 50%;
            filter: blur(48px);
            opacity: 0.55;
            animation: drift 8s ease-in-out infinite alternate;
        }

        .blob-1 { width: 320px; height: 320px; background: var(--primary); top: -80px; left: -80px; }
        .blob-2 { width: 260px; height: 260px; background: var(--secondary); bottom: -60px; right: -40px; animation-delay: 2s; }
        .blob-3 { width: 200px; height: 200px; background: var(--warm); bottom: 120px; left: 60px; animation-delay: 4s; }
        .blob-4 { width: 150px; height: 150px; background: var(--yellow); top: 200px; right: 80px; animation-delay: 1s; }

        @@keyframes drift {
            from { transform: translateY(0) scale(1); }
            to { transform: translateY(20px) scale(1.06); }
        }

        .left-content {
            position: relative;
            z-index: 1;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 26px;
            max-width: 420px;
        }

        .logo-row { display: flex; align-items: center; gap: 14px; }

        .logo-icon {
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 18px rgba(201,184,245,0.5);
            font-size: 28px;
        }

        .logo-text { font-family: 'Playfair Display', serif; font-size: 28px; font-weight: 800; color: var(--text); }
        .logo-text span { color: #9B7FE8; }

        .tagline {
            font-size: 14px;
            color: var(--muted);
            font-weight: 500;
            background: rgba(255,255,255,0.6);
            padding: 10px 16px;
            border-radius: 12px;
            border: 1px solid var(--border);
        }

        .hero-headline {
            font-family: 'Playfair Display', serif;
            font-size: 44px;
            font-weight: 800;
            color: var(--text);
            line-height: 1.2;
        }

        .hero-headline em {
            font-style: normal;
            background: linear-gradient(90deg, #a882f0, #f07cb0);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .feature-list { display: flex; flex-direction: column; gap: 12px; }
        .feat-item { display: flex; align-items: center; gap: 12px; font-size: 14px; color: var(--text); font-weight: 600; }

        .feat-dot {
            width: 32px;
            height: 32px;
            border-radius: 10px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

        .feat-dot.p { background: rgba(201,184,245,0.4); }
        .feat-dot.s { background: rgba(245,184,208,0.4); }
        .feat-dot.w { background: rgba(255,212,163,0.4); }

        .stats-box {
            width: 100%;
            background: rgba(255,255,255,0.45);
            border: 1px solid rgba(255,255,255,0.7);
            border-radius: 20px;
            padding: 18px 22px;
        }

        .stats-label {
            font-size: 10.5px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--muted);
            margin-bottom: 12px;
        }

        .stats-row { display: flex; gap: 28px; }
        .stat-item { display: flex; flex-direction: column; gap: 2px; }
        .stat-num { font-size: 22px; font-weight: 800; color: var(--text); }
        .stat-desc { font-size: 12px; color: var(--muted); font-weight: 500; }

        .right {
            flex: 0 0 48%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 48px;
            background: #FFFFFF;
            border-left: 1.5px solid rgba(201,184,245,0.2);
            position: relative;
            overflow-y: auto;
            min-height: 100vh;
        }

        .lang-toggle {
            position: absolute;
            top: 24px;
            right: 24px;
            display: flex;
            align-items: center;
            gap: 2px;
            background: rgba(201,184,245,0.12);
            border: 1.5px solid var(--border);
            border-radius: 10px;
            padding: 3px;
            cursor: pointer;
        }

        .lang-btn {
            padding: 5px 10px;
            border-radius: 7px;
            border: none;
            background: transparent;
            font-family: 'Nunito', sans-serif;
            font-size: 12.5px;
            font-weight: 700;
            color: var(--muted);
            cursor: pointer;
            transition: all 0.2s;
        }

        .lang-btn.active {
            background: white;
            color: var(--text);
            box-shadow: 0 1px 6px rgba(180,160,240,0.2);
        }

        .form-card { width: 100%; max-width: 390px; }

        .form-header { margin-bottom: 24px; }
        .form-header h2 { font-family: 'Playfair Display', serif; font-size: 28px; font-weight: 800; color: var(--text); }
        .form-header p { font-size: 13.5px; color: var(--muted); margin-top: 5px; font-weight: 500; }

        .panel-form { display: flex; flex-direction: column; gap: 13px; }

        .field { display: flex; flex-direction: column; gap: 5px; }
        .field label { font-size: 12px; font-weight: 700; color: var(--text); letter-spacing: 0.3px; }

        .field-wrap { position: relative; }

        .field-icon {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            display: flex;
            align-items: center;
            pointer-events: none;
        }

        .field input {
            width: 100%;
            padding: 12px 14px 12px 40px;
            border: 1.5px solid var(--border);
            border-radius: 12px;
            background: #FDFCFF;
            font-family: 'Nunito', sans-serif;
            font-size: 14px;
            font-weight: 500;
            color: var(--text);
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        .field input::placeholder { color: #c0b8d8; }
        .field input:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(201,184,245,0.2); background: white; }
        .field input.is-invalid { border-color: #eb5757; }

        .user-type-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

        .type-card {
            padding: 11px 10px;
            border: 1.5px solid var(--border);
            border-radius: 12px;
            cursor: pointer;
            text-align: center;
            background: #FDFCFF;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 5px;
            transition: all 0.2s;
        }

        .type-card.selected {
            border-color: var(--primary);
            background: linear-gradient(135deg, rgba(201,184,245,0.18), rgba(245,184,208,0.12));
            box-shadow: 0 0 0 3px rgba(201,184,245,0.18);
        }

        .type-emoji { font-size: 22px; }
        .type-label { font-size: 12.5px; font-weight: 700; color: var(--text); }
        .type-desc { font-size: 11px; color: var(--muted); }

        .extra-field {
            overflow: hidden;
            max-height: 0;
            opacity: 0;
            transition: max-height 0.32s ease, opacity 0.28s ease;
        }

        .extra-field.visible { max-height: 90px; opacity: 1; }

        .forgot-row { display: flex; justify-content: flex-end; }
        .forgot-link { font-size: 12.5px; font-weight: 600; color: var(--muted); text-decoration: none; }
        .forgot-link:hover { color: #9B7FE8; }

        .btn-submit {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            border: none;
            border-radius: 13px;
            font-family: 'Nunito', sans-serif;
            font-size: 15px;
            font-weight: 800;
            color: white;
            cursor: pointer;
            box-shadow: 0 6px 22px rgba(201,184,245,0.45);
            transition: transform 0.15s, box-shadow 0.15s;
            margin-top: 2px;
        }

        .btn-submit:hover { transform: translateY(-2px); box-shadow: 0 10px 28px rgba(201,184,245,0.52); }

        .divider {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 11.5px;
            font-weight: 700;
            color: #c0b8d8;
            margin: 14px 0 12px;
        }

        .divider::before, .divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: var(--border);
        }

        .social-row { display: flex; gap: 10px; }

        .btn-social {
            flex: 1;
            padding: 10px 8px;
            border: 1.5px solid var(--border);
            border-radius: 12px;
            background: #FDFCFF;
            font-family: 'Nunito', sans-serif;
            font-size: 13px;
            font-weight: 700;
            color: var(--text);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            transition: border-color 0.2s;
        }

        .btn-social:hover { border-color: var(--primary); background: white; }

        .bottom-note {
            margin-top: 18px;
            text-align: center;
            font-size: 12.5px;
            color: var(--muted);
            font-weight: 500;
        }

        .bottom-note a { color: #9B7FE8; font-weight: 700; text-decoration: none; }

        .alert-auth {
            padding: 10px 14px;
            background: #fdd8d8;
            color: #a33030;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .alert-success { background: #d4f5e2; color: #276749; }

        @@media(max-width:768px) {
            body { flex-direction: column; }
            .left { min-height: auto; padding: 40px 24px; flex: none; }
            .right { flex: none; min-height: auto; padding: 32px 24px; }
        }
    </style>
</head>
<body>

<div class="left">
    <div class="left-bg"></div>
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    <div class="blob blob-3"></div>
    <div class="blob blob-4"></div>
    <div class="left-content">
        <div class="logo-row">
            <div class="logo-icon">🛴</div>
            <div class="logo-text">Saigon<span>Ride</span></div>
        </div>
        <div class="tagline"
            data-vi="🛴&nbsp;&nbsp;Di chuyển thông minh — khám phá Sài Gòn theo cách của bạn"
            data-en="🛴&nbsp;&nbsp;Ride smart — explore Saigon your way">
            🛴&nbsp;&nbsp;Ride smart — explore Saigon your way
        </div>
        <div class="hero-headline"
            data-vi="Hành trình của bạn,<br/><em>bắt đầu từ đây.</em>"
            data-en="Your journey,<br/><em>starts here.</em>">
            Your journey,<br/><em>starts here.</em>
        </div>
        <div class="feature-list">
            <div class="feat-item">
                <div class="feat-dot p">🛴</div>
                <span data-vi="Thuê xe nhanh trong 30 giây" data-en="Rent a ride in 30 seconds">Rent a ride in 30 seconds</span>
            </div>
            <div class="feat-item">
                <div class="feat-dot s">🗺️</div>
                <span data-vi="Bản đồ thời gian thực, theo dõi chuyến đi" data-en="Real-time map &amp; live trip tracking">Real-time map &amp; live trip tracking</span>
            </div>
            <div class="feat-item">
                <div class="feat-dot w">🌏</div>
                <span data-vi="Hỗ trợ khách du lịch quốc tế" data-en="Full support for foreign tourists">Full support for foreign tourists</span>
            </div>
        </div>
        <div class="stats-box">
            <div class="stats-label">SaigonRide · Stats</div>
            <div class="stats-row">
                <div class="stat-item"><div class="stat-num">120K+</div><div class="stat-desc" data-vi="Người dùng" data-en="Users">Users</div></div>
                <div class="stat-item"><div class="stat-num">2.4M</div><div class="stat-desc" data-vi="Chuyến đi" data-en="Trips">Trips</div></div>
                <div class="stat-item"><div class="stat-num">4.9 ★</div><div class="stat-desc" data-vi="Đánh giá" data-en="Rating">Rating</div></div>
            </div>
        </div>
    </div>
</div>

<div class="right">
    <div class="lang-toggle">
        <button class="lang-btn active" id="btn-en" onclick="setLang('en')">EN</button>
        <button class="lang-btn" id="btn-vi" onclick="setLang('vi')">VI</button>
    </div>

    <div class="form-card">

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert-auth alert-custom">⚠️ @error</div>
        }
        @if (TempData["AuthSuccess"] != null)
        {
            <div class="alert-auth alert-success alert-custom">✅ @TempData["AuthSuccess"]</div>
        }

        <div id="login-panel" style="display:@(panel == "login" ? "block" : "none")">
            <div class="form-header">
                <h2 data-vi="Chào mừng trở lại 👋" data-en="Welcome back 👋">Welcome back 👋</h2>
                <p data-vi="Đăng nhập để tiếp tục hành trình của bạn" data-en="Sign in to continue your journey">Sign in to continue your journey</p>
            </div>
            <form method="post" action="/Auth/Login" class="panel-form">
                @Html.AntiForgeryToken()
                <div class="field">
                    <label data-vi="Email" data-en="Email">Email</label>
                    <div class="field-wrap">
                        <span class="field-icon"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="1.5" y="3.5" width="13" height="9" rx="1.5" stroke="#8A7FAA" stroke-width="1.4"/><path d="M1.5 5.5l6.5 4 6.5-4" stroke="#8A7FAA" stroke-width="1.4" stroke-linecap="round"/></svg></span>
                        <input type="email" name="Email" placeholder="name@email.com" required/>
                    </div>
                </div>
                <div class="field">
                    <label data-vi="Mật khẩu" data-en="Password">Password</label>
                    <div class="field-wrap">
                        <span class="field-icon"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="3" y="7" width="10" height="7" rx="1.5" stroke="#8A7FAA" stroke-width="1.4"/><path d="M5.5 7V5a2.5 2.5 0 015 0v2" stroke="#8A7FAA" stroke-width="1.4" stroke-linecap="round"/><circle cx="8" cy="10.5" r="1" fill="#8A7FAA"/></svg></span>
                        <input type="password" name="Password" placeholder="••••••••" required/>
                    </div>
                </div>
                <div class="forgot-row">
                    <a href="/Auth/ForgotPassword" class="forgot-link" data-vi="Quên mật khẩu?" data-en="Forgot password?">Forgot password?</a>
                </div>
                <button type="submit" class="btn-submit" data-vi="Đăng nhập" data-en="Sign In">Sign In</button>
                <div class="divider" data-vi="hoặc tiếp tục với" data-en="or continue with">or continue with</div>
                <div class="social-row">
                    <button type="button" class="btn-social">
                        <svg width="17" height="17" viewBox="0 0 18 18"><path d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.716v2.259h2.908c1.702-1.567 2.684-3.875 2.684-6.615z" fill="#4285F4"/><path d="M9 18c2.43 0 4.467-.806 5.956-2.184l-2.908-2.259c-.806.54-1.837.859-3.048.859-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 009 18z" fill="#34A853"/><path d="M3.964 10.705A5.41 5.41 0 013.682 9c0-.593.102-1.17.282-1.705V4.963H.957A8.996 8.996 0 000 9c0 1.452.348 2.827.957 4.037l3.007-2.332z" fill="#FBBC05"/><path d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 00.957 4.963L3.964 7.295C4.672 5.163 6.656 3.58 9 3.58z" fill="#EA4335"/></svg>
                        Google
                    </button>
                    <button type="button" class="btn-social">
                        <svg width="17" height="17" viewBox="0 0 18 18" fill="#1877F2"><path d="M18 9a9 9 0 10-10.406 8.892v-6.294H5.31V9h2.284V7.017c0-2.254 1.343-3.5 3.4-3.5.985 0 2.015.175 2.015.175v2.216h-1.135c-1.118 0-1.467.694-1.467 1.406V9h2.496l-.399 2.598h-2.097v6.294A9.002 9.002 0 0018 9z"/></svg>
                        Facebook
                    </button>
                </div>
            </form>
            <div class="bottom-note">
                <span data-vi="Chưa có tài khoản?" data-en="Don't have an account?">Don't have an account?</span>
                <a href="#" onclick="switchPanel('register');return false;" data-vi="Đăng ký ngay" data-en="Sign up">Sign up</a>
            </div>
        </div>

        <div id="register-panel" style="display:@(panel == "register" ? "block" : "none")">
            <div class="form-header">
                <h2 data-vi="Tạo tài khoản mới ✨" data-en="Create an account ✨">Create an account ✨</h2>
                <p data-vi="Tham gia cộng đồng SaigonRide hôm nay" data-en="Join the SaigonRide community today">Join the SaigonRide community today</p>
            </div>
            <form method="post" action="/Auth/Register" class="panel-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Role" id="roleInput" value="ForeignTourist"/>
                <div class="field">
                    <label data-vi="Họ và tên" data-en="Full Name">Full Name</label>
                    <div class="field-wrap">
                        <span class="field-icon"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="5.5" r="3" stroke="#8A7FAA" stroke-width="1.4"/><path d="M2 13.5c0-2.485 2.686-4 6-4s6 1.515 6 4" stroke="#8A7FAA" stroke-width="1.4" stroke-linecap="round"/></svg></span>
                        <input type="text" name="FullName" placeholder="Nguyen Van A" required/>
                    </div>
                </div>
                <div class="field">
                    <label data-vi="Email" data-en="Email">Email</label>
                    <div class="field-wrap">
                        <span class="field-icon"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="1.5" y="3.5" width="13" height="9" rx="1.5" stroke="#8A7FAA" stroke-width="1.4"/><path d="M1.5 5.5l6.5 4 6.5-4" stroke="#8A7FAA" stroke-width="1.4" stroke-linecap="round"/></svg></span>
                        <input type="email" name="Email" placeholder="name@email.com" required/>
                    </div>
                </div>
                <div class="field">
                    <label data-vi="Mật khẩu" data-en="Password">Password</label>
                    <div class="field-wrap">
                        <span class="field-icon"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="3" y="7" width="10" height="7" rx="1.5" stroke="#8A7FAA" stroke-width="1.4"/><path d="M5.5 7V5a2.5 2.5 0 015 0v2" stroke="#8A7FAA" stroke-width="1.4" stroke-linecap="round"/><circle cx="8" cy="10.5" r="1" fill="#8A7FAA"/></svg></span>
                        <input type="password" name="Password" data-placeholder-vi="Ít nhất 8 ký tự" data-placeholder-en="At least 8 characters" placeholder="At least 8 characters" required/>
                    </div>
                </div>
                <div class="field">
                    <label data-vi="Xác nhận mật khẩu" data-en="Confirm Password">Confirm Password</label>
                    <div class="field-wrap">
                        <span class="field-icon"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="3" y="7" width="10" height="7" rx="1.5" stroke="#8A7FAA" stroke-width="1.4"/><path d="M5.5 7V5a2.5 2.5 0 015 0v2" stroke="#8A7FAA" stroke-width="1.4" stroke-linecap="round"/><circle cx="8" cy="10.5" r="1" fill="#8A7FAA"/></svg></span>
                        <input type="password" name="ConfirmPassword" data-placeholder-vi="Nhập lại mật khẩu" data-placeholder-en="Re-enter your password" placeholder="Re-enter your password" required/>
                    </div>
                </div>
                <div class="field">
                    <label data-vi="Loại tài khoản" data-en="Account Type">Account Type</label>
                    <div class="user-type-grid">
                        <div class="type-card" id="type-local" onclick="selectType('local')">
                            <div class="type-emoji">🏙️</div>
                            <div class="type-label" data-vi="Cư dân địa phương" data-en="Local Commuter">Local Commuter</div>
                            <div class="type-desc" data-vi="Cư dân Việt Nam" data-en="Vietnamese resident">Vietnamese resident</div>
                        </div>
                        <div class="type-card selected" id="type-tourist" onclick="selectType('tourist')">
                            <div class="type-emoji">✈️</div>
                            <div class="type-label" data-vi="Khách du lịch" data-en="Foreign Tourist">Foreign Tourist</div>
                            <div class="type-desc" data-vi="Khách quốc tế" data-en="International visitor">International visitor</div>
                        </div>
                    </div>
                </div>
                <div class="extra-field visible" id="passport-field">
                    <div class="field">
                        <label>
                            <span data-vi="Số hộ chiếu" data-en="Passport Number">Passport Number</span>
                            <span style="color:#F5B8D0;font-size:10.5px;font-weight:600;margin-left:5px;" data-vi="(bắt buộc)" data-en="(required)">(required)</span>
                        </label>
                        <div class="field-wrap">
                            <span class="field-icon"><svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="2" y="1.5" width="12" height="13" rx="2" stroke="#8A7FAA" stroke-width="1.4"/><circle cx="8" cy="6.5" r="2" stroke="#8A7FAA" stroke-width="1.3"/><path d="M4.5 12.5c0-1.933 1.567-3 3.5-3s3.5 1.067 3.5 3" stroke="#8A7FAA" stroke-width="1.3" stroke-linecap="round"/></svg></span>
                            <input type="text" name="PassportNumber" id="passport-input" data-placeholder-vi="VD: A12345678" data-placeholder-en="e.g. A12345678" placeholder="e.g. A12345678"/>
                        </div>
                    </div>
                </div>
                <button type="submit" class="btn-submit" data-vi="Tạo tài khoản" data-en="Create Account">Create Account</button>
            </form>
            <div class="bottom-note">
                <span data-vi="Đã có tài khoản?" data-en="Already have an account?">Already have an account?</span>
                <a href="#" onclick="switchPanel('login');return false;" data-vi="Đăng nhập" data-en="Sign in">Sign in</a>
            </div>
        </div>
    </div>
</div>

<script>
    let currentLang = 'en';

    function switchPanel(panel) {
        document.getElementById('login-panel').style.display = panel === 'login' ? 'block' : 'none';
        document.getElementById('register-panel').style.display = panel === 'register' ? 'block' : 'none';
    }

    function selectType(type) {
        document.getElementById('type-local').classList.toggle('selected', type === 'local');
        document.getElementById('type-tourist').classList.toggle('selected', type === 'tourist');
        document.getElementById('passport-field').classList.toggle('visible', type === 'tourist');
        document.getElementById('roleInput').value = type === 'tourist' ? 'ForeignTourist' : 'LocalCommuter';
        if (type === 'local') document.getElementById('passport-input').value = '';
    }

    function setLang(lang) {
        currentLang = lang;
        document.getElementById('btn-en').classList.toggle('active', lang === 'en');
        document.getElementById('btn-vi').classList.toggle('active', lang === 'vi');
        
        document.querySelectorAll('[data-vi][data-en]').forEach(el => {
            const val = el.getAttribute('data-' + lang);
            if (el.tagName === 'INPUT') {
                el.placeholder = val;
            } else {
                el.innerHTML = val;
            }
        });
        
        document.querySelectorAll('[data-placeholder-' + lang + ']').forEach(el => {
            el.placeholder = el.getAttribute('data-placeholder-' + lang);
        });
        const alertMap = {
            "Invalid email or password.": "Email hoặc mật khẩu không đúng.",
            "Your account has been suspended. Please contact support.": "Tài khoản của bạn đã bị khóa. Vui lòng liên hệ hỗ trợ.",
            "Passwords do not match.": "Mật khẩu không khớp.",
            "This email is already registered.": "Email này đã được đăng ký.",
            "Account created! Please sign in.": "Tạo tài khoản thành công! Vui lòng đăng nhập.",
        };
        document.querySelectorAll('.alert-custom').forEach(el => {
            if (!el.getAttribute('data-orig')) {
                el.setAttribute('data-orig', el.textContent.trim());
            }
            const raw = el.getAttribute('data-orig');
            const key = Object.keys(alertMap).find(k => raw.includes(k));
            el.textContent = lang === 'vi' && key ? alertMap[key] : raw;
        });

        localStorage.setItem('sr_lang', lang);
    }

    window.addEventListener('DOMContentLoaded', () => {
        const saved = localStorage.getItem('sr_lang') || 'en';
        if (saved !== 'en') setLang(saved);
    });
</script>
</body>
</html>