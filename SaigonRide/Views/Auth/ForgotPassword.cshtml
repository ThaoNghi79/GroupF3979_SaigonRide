@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SaigonRide — Forgot Password</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&family=Playfair+Display:wght@700;800&display=swap" rel="stylesheet" />
    <style>
        :root {
            --primary: #C9B8F5;
            --secondary: #F5B8D0;
            --warm: #FFD4A3;
            --yellow: #FFF3B0;
            --bg: #FAF8FF;
            --text: #2D2640;
            --muted: #8A7FAA;
            --border: rgba(201,184,245,0.35)
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0
        }

        html, body {
            min-height: 100vh;
            font-family: 'Nunito', sans-serif
        }

        body {
            display: flex;
            background: var(--bg)
        }

        .left {
            flex: 1 0 52%;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 60px 56px;
            overflow: hidden;
            min-height: 100vh
        }

        .left-bg {
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse 70% 60% at 20% 30%,#dfd4ff 0%,transparent 60%), radial-gradient(ellipse 55% 50% at 80% 70%,#fbc8dd 0%,transparent 60%), radial-gradient(ellipse 60% 55% at 60% 10%,#ffe5c0 0%,transparent 55%), radial-gradient(ellipse 80% 80% at 50% 50%,#faf8ff 0%,#f0eaff 100%)
        }

        .blob {
            position: absolute;
            border-radius: 50%;
            filter: blur(48px);
            opacity: 0.55;
            animation: drift 8s ease-in-out infinite alternate
        }

        .blob-1 {
            width: 320px;
            height: 320px;
            background: var(--primary);
            top: -80px;
            left: -80px
        }

        .blob-2 {
            width: 260px;
            height: 260px;
            background: var(--secondary);
            bottom: -60px;
            right: -40px;
            animation-delay: 2s
        }

        .blob-3 {
            width: 200px;
            height: 200px;
            background: var(--warm);
            bottom: 120px;
            left: 60px;
            animation-delay: 4s
        }

        .blob-4 {
            width: 150px;
            height: 150px;
            background: var(--yellow);
            top: 200px;
            right: 80px;
            animation-delay: 1s
        }

        @@keyframes drift {
            from {
                transform: translateY(0) scale(1)
            }

            to {
                transform: translateY(20px) scale(1.06)
            }
        }

        .left-content {
            position: relative;
            z-index: 1;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 26px;
            max-width: 420px
        }

        .logo-row {
            display: flex;
            align-items: center;
            gap: 14px
        }

        .logo-icon {
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg,var(--primary),var(--secondary));
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 18px rgba(201,184,245,0.5);
            font-size: 28px
        }

        .logo-text {
            font-family: 'Playfair Display', serif;
            font-size: 28px;
            font-weight: 800;
            color: var(--text)
        }

        .logo-text span {
            color: #9B7FE8
        }

        .tagline {
            font-size: 14px;
            color: var(--muted);
            font-weight: 500;
            background: rgba(255,255,255,0.6);
            padding: 10px 16px;
            border-radius: 12px;
            border: 1px solid var(--border)
        }

        .hero-headline {
            font-family: 'Playfair Display', serif;
            font-size: 44px;
            font-weight: 800;
            color: var(--text);
            line-height: 1.2
        }

        .hero-headline em {
            font-style: normal;
            background: linear-gradient(90deg,#a882f0,#f07cb0);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent
        }

        .feature-list {
            display: flex;
            flex-direction: column;
            gap: 12px
        }

        .feat-item {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 14px;
            color: var(--text);
            font-weight: 600
        }

        .feat-dot {
            width: 32px;
            height: 32px;
            border-radius: 10px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px
        }

        .feat-dot.p {
            background: rgba(201,184,245,0.4)
        }

        .feat-dot.s {
            background: rgba(245,184,208,0.4)
        }

        .feat-dot.w {
            background: rgba(255,212,163,0.4)
        }

        .stats-box {
            width: 100%;
            background: rgba(255,255,255,0.45);
            border: 1px solid rgba(255,255,255,0.7);
            border-radius: 20px;
            padding: 18px 22px
        }

        .stats-label {
            font-size: 10.5px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--muted);
            margin-bottom: 12px
        }

        .stats-row {
            display: flex;
            gap: 28px
        }

        .stat-item {
            display: flex;
            flex-direction: column;
            gap: 2px
        }

        .stat-num {
            font-size: 22px;
            font-weight: 800;
            color: var(--text)
        }

        .stat-desc {
            font-size: 12px;
            color: var(--muted);
            font-weight: 500
        }

        .right {
            flex: 0 0 48%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 48px;
            background: #FFFFFF;
            border-left: 1.5px solid rgba(201,184,245,0.2);
            position: relative;
            overflow-y: auto;
            min-height: 100vh
        }

        .lang-toggle {
            position: absolute;
            top: 24px;
            right: 24px;
            display: flex;
            align-items: center;
            gap: 2px;
            background: rgba(201,184,245,0.12);
            border: 1.5px solid var(--border);
            border-radius: 10px;
            padding: 3px
        }

        .lang-btn {
            padding: 5px 10px;
            border-radius: 7px;
            border: none;
            background: transparent;
            font-family: 'Nunito', sans-serif;
            font-size: 12.5px;
            font-weight: 700;
            color: var(--muted);
            cursor: pointer;
            transition: all 0.2s
        }

        .lang-btn.active {
            background: white;
            color: var(--text);
            box-shadow: 0 1px 6px rgba(180,160,240,0.2)
        }

        .form-card {
            width: 100%;
            max-width: 390px
        }

        .form-header {
            margin-bottom: 24px
        }

        .form-header h2 {
            font-family: 'Playfair Display', serif;
            font-size: 28px;
            font-weight: 800;
            color: var(--text)
        }

        .form-header p {
            font-size: 13.5px;
            color: var(--muted);
            margin-top: 5px;
            font-weight: 500
        }

        .form-header p.helper {
            color: #d4a3c4
        }

        .panel-form {
            display: flex;
            flex-direction: column;
            gap: 13px
        }

        .field {
            display: flex;
            flex-direction: column;
            gap: 5px
        }

        .field label {
            font-size: 12px;
            font-weight: 700;
            color: var(--text);
            letter-spacing: 0.3px
        }

        .field-wrap {
            position: relative
        }

        .field-icon {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            display: flex;
            align-items: center;
            pointer-events: none
        }

        .field input {
            width: 100%;
            padding: 12px 14px 12px 40px;
            border: 1.5px solid var(--border);
            border-radius: 12px;
            background: #FDFCFF;
            font-family: 'Nunito', sans-serif;
            font-size: 14px;
            font-weight: 500;
            color: var(--text);
            outline: none;
            transition: border-color 0.2s,box-shadow 0.2s
        }

        .field input::placeholder {
            color: #c0b8d8
        }

        .field input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(201,184,245,0.2);
            background: white
        }

        .verify-wrap {
            position: relative
        }

        .verify-wrap input {
            padding-right: 88px
        }

        .get-code {
            position: absolute;
            right: 6px;
            top: 50%;
            transform: translateY(-50%);
            border: none;
            background: transparent;
            color: #d97aab;
            font-family: 'Nunito', sans-serif;
            font-size: 13px;
            font-weight: 700;
            padding: 6px 10px;
            border-radius: 8px;
            cursor: pointer;
            transition: background 0.15s,color 0.15s
        }

        .get-code:hover {
            background: rgba(245,184,208,0.18);
            color: #c0567f
        }

        .get-code:disabled {
            color: var(--muted);
            cursor: default;
            background: transparent
        }

        .btn-submit {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg,var(--primary),var(--secondary));
            border: none;
            border-radius: 13px;
            font-family: 'Nunito', sans-serif;
            font-size: 15px;
            font-weight: 800;
            color: white;
            cursor: pointer;
            box-shadow: 0 6px 22px rgba(201,184,245,0.45);
            transition: transform 0.15s,box-shadow 0.15s;
            margin-top: 8px
        }

        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 28px rgba(201,184,245,0.52)
        }

        .bottom-note {
            margin-top: 16px;
            text-align: center;
            font-size: 13px;
            color: var(--muted);
            font-weight: 500
        }

        .bottom-note a {
            color: #9B7FE8;
            font-weight: 700;
            text-decoration: none
        }

        .bottom-note a:hover {
            color: #7d5cd1
        }

        .code-msg {
            font-size: 12px;
            font-weight: 600;
            margin-top: 5px;
            min-height: 16px
        }
    </style>
</head>
<body>

    <div class="left">
        <div class="left-bg"></div>
        <div class="blob blob-1"></div>
        <div class="blob blob-2"></div>
        <div class="blob blob-3"></div>
        <div class="blob blob-4"></div>
        <div class="left-content">
            <div class="logo-row">
                <div class="logo-icon">🛵</div>
                <div class="logo-text">Saigon<span>Ride</span></div>
            </div>
            <div class="tagline" data-vi="🛵&nbsp;&nbsp;Di chuyển thông minh — khám phá Sài Gòn theo cách của bạn" data-en="🛵&nbsp;&nbsp;Ride smart — explore Saigon your way">
                🛵&nbsp;&nbsp;Ride smart — explore Saigon your way
            </div>
            <div class="hero-headline" data-vi="Hành trình của bạn,<br/><em>bắt đầu từ đây.</em>" data-en="Your journey,<br/><em>starts here.</em>">
                Your journey,<br /><em>starts here.</em>
            </div>
            <div class="feature-list">
                <div class="feat-item"><div class="feat-dot p">🛵</div><span data-vi="Đặt xe nhanh trong 30 giây" data-en="Book a ride in 30 seconds">Book a ride in 30 seconds</span></div>
                <div class="feat-item"><div class="feat-dot s">🗺️</div><span data-vi="Bản đồ thời gian thực, theo dõi chuyến đi" data-en="Real-time map &amp; live trip tracking">Real-time map &amp; live trip tracking</span></div>
                <div class="feat-item"><div class="feat-dot w">🌏</div><span data-vi="Hỗ trợ khách du lịch quốc tế" data-en="Full support for foreign tourists">Full support for foreign tourists</span></div>
            </div>
            <div class="stats-box">
                <div class="stats-label">SaigonRide · Stats</div>
                <div class="stats-row">
                    <div class="stat-item"><div class="stat-num">120K+</div><div class="stat-desc" data-vi="Người dùng" data-en="Users">Users</div></div>
                    <div class="stat-item"><div class="stat-num">2.4M</div><div class="stat-desc" data-vi="Chuyến đi" data-en="Trips">Trips</div></div>
                    <div class="stat-item"><div class="stat-num">4.9 ★</div><div class="stat-desc" data-vi="Đánh giá" data-en="Rating">Rating</div></div>
                </div>
            </div>
        </div>
    </div>

    <div class="right">
        <div class="lang-toggle">
            <button class="lang-btn active" id="btn-en" onclick="setLang('en')">EN</button>
            <button class="lang-btn" id="btn-vi" onclick="setLang('vi')">VI</button>
        </div>
        <div class="form-card">
            <div class="form-header">
                <h2 data-vi="Quên mật khẩu" data-en="Forgot Password">Forgot Password</h2>
                <p class="helper" data-vi="Đừng lo — chúng tôi sẽ giúp bạn đặt lại" data-en="Don't worry — we'll help you reset it">Don't worry — we'll help you reset it</p>
            </div>
            @if (TempData["AuthError"] != null)
            {
                <div style="padding:10px 14px;background:#fdd8d8;color:#a33030;border-radius:10px;font-size:13px;font-weight:600;margin-bottom:14px;">
                    ⚠️ @TempData["AuthError"]
                </div>
            }
            <form method="post" action="/Auth/ResetPassword" class="panel-form">
                @Html.AntiForgeryToken()
                <div class="field">
                    <label data-vi="Email" data-en="Email">Email</label>
                    <div class="field-wrap">
                        <span class="field-icon">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                                <rect x="1.5" y="3.5" width="13" height="9" rx="1.5" stroke="#8A7FAA" stroke-width="1.4" />
                                <path d="M1.5 5.5l6.5 4 6.5-4" stroke="#8A7FAA" stroke-width="1.4" stroke-linecap="round" />
                            </svg>
                        </span>
                        <input type="email" name="Email" id="reset-email" placeholder="name@email.com" required />
                    </div>
                </div>
                <div class="field">
                    <label data-vi="Mật khẩu mới" data-en="New Password">New Password</label>
                    <div class="field-wrap">
                        <span class="field-icon">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                                <rect x="3" y="7" width="10" height="7" rx="1.5" stroke="#8A7FAA" stroke-width="1.4" />
                                <path d="M5.5 7V5a2.5 2.5 0 015 0v2" stroke="#8A7FAA" stroke-width="1.4" stroke-linecap="round" />
                                <circle cx="8" cy="10.5" r="1" fill="#8A7FAA" />
                            </svg>
                        </span>
                        <input type="password" name="NewPassword" data-placeholder-vi="Ít nhất 8 ký tự" data-placeholder-en="At least 8 characters" placeholder="At least 8 characters" required />
                    </div>
                </div>
                <div class="field">
                    <label data-vi="Xác nhận mật khẩu" data-en="Confirm Password">Confirm Password</label>
                    <div class="field-wrap">
                        <span class="field-icon">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                                <rect x="3" y="7" width="10" height="7" rx="1.5" stroke="#8A7FAA" stroke-width="1.4" />
                                <path d="M5.5 7V5a2.5 2.5 0 015 0v2" stroke="#8A7FAA" stroke-width="1.4" stroke-linecap="round" />
                                <circle cx="8" cy="10.5" r="1" fill="#8A7FAA" />
                            </svg>
                        </span>
                        <input type="password" name="ConfirmPassword" data-placeholder-vi="Nhập lại mật khẩu" data-placeholder-en="Re-enter your password" placeholder="Re-enter your password" required />
                    </div>
                </div>
                <div class="field">
                    <label data-vi="Mã xác minh" data-en="Verification">Verification</label>
                    <div class="field-wrap verify-wrap">
                        <span class="field-icon">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                                <path d="M8 1.5l5.5 2v4c0 3.3-2.3 6.2-5.5 7-3.2-0.8-5.5-3.7-5.5-7v-4l5.5-2z" stroke="#8A7FAA" stroke-width="1.3" stroke-linejoin="round" />
                                <path d="M5.8 8l1.6 1.6L10.4 6.6" stroke="#8A7FAA" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </span>
                        <input type="text" name="VerificationCode" data-placeholder-vi="Nhập mã xác minh" data-placeholder-en="Enter verification code" placeholder="Enter verification code" />
                        <button type="button" class="get-code" id="get-code-btn" onclick="sendCode()" data-vi="Gửi mã" data-en="Get code">Get code</button>
                    </div>
                    <div class="code-msg" id="code-msg"></div>
                </div>
                <button type="submit" class="btn-submit" data-vi="Đặt lại mật khẩu" data-en="Reset Password">Reset Password</button>
            </form>
            <div class="bottom-note">
                <a href="/Auth" data-vi="Quay lại đăng nhập" data-en="Back to login">Back to login</a>
            </div>
        </div>
    </div>

    <script>
        let currentLang = localStorage.getItem('sr_lang') || 'en';

        function setLang(lang) {
            currentLang = lang;
            document.getElementById('btn-en').classList.toggle('active', lang === 'en');
            document.getElementById('btn-vi').classList.toggle('active', lang === 'vi');

            document.querySelectorAll('[data-vi][data-en]').forEach(el => {
                const val = el.getAttribute('data-' + lang);
                if (el.tagName === 'INPUT') el.placeholder = val;
                else el.innerHTML = val;
            });

            document.querySelectorAll('[data-placeholder-' + lang + ']').forEach(el => {
                el.placeholder = el.getAttribute('data-placeholder-' + lang);
            });

            localStorage.setItem('sr_lang', lang);
        }

        let cdTimer = null;

        function sendCode() {
            const btn = document.getElementById('get-code-btn');
            const msg = document.getElementById('code-msg');
            const email = document.getElementById('reset-email').value.trim();

            if (btn.disabled) return;

            if (!email) {
                msg.style.color = '#a33030';
                msg.textContent = currentLang === 'vi' ? 'Vui lòng nhập email trước!' : 'Please enter your email first!';
                return;
            }

            btn.disabled = true;
            msg.style.color = '#8A7FAA';
            msg.textContent = currentLang === 'vi' ? 'Đang gửi...' : 'Sending...';

            fetch('/Auth/SendResetCode', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'email=' + encodeURIComponent(email)
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    msg.style.color = '#276749';
                    msg.textContent = '✅ ' + data.message;
                    let secs = 60;
                    const tick = () => {
                        btn.textContent = (currentLang === 'vi' ? 'Gửi lại' : 'Resend') + ' (' + secs + 's)';
                        if (secs-- <= 0) {
                            clearInterval(cdTimer);
                            btn.disabled = false;
                            btn.textContent = currentLang === 'vi' ? 'Gửi mã' : 'Get code';
                        }
                    };
                    tick();
                    cdTimer = setInterval(tick, 1000);
                } else {
                    msg.style.color = '#a33030';
                    msg.textContent = '⚠️ ' + data.message;
                    btn.disabled = false;
                }
            })
            .catch(() => {
                msg.style.color = '#a33030';
                msg.textContent = '⚠️ ' + (currentLang === 'vi' ? 'Lỗi kết nối.' : 'Network error.');
                btn.disabled = false;
            });
        }

        window.addEventListener('DOMContentLoaded', () => {
            if (currentLang !== 'en') setLang(currentLang);
        });
    </script>
</body>
</html>