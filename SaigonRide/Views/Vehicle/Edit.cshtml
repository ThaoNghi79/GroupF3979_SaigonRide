@{
    var categories = ViewBag.Categories as List<SaigonRide.Models.VehicleCategory>;
    var stations = ViewBag.Stations as List<SaigonRide.Models.Station>;
}

<div class="modal-backdrop-custom" id="editModal">
    <div class="modal-box">
        <div class="modal-header-custom">
            <h4>
                <i class="fas fa-pen" style="margin-right:8px;"></i>
                <span data-i18n="Edit Vehicle">Edit Vehicle</span> — <span id="editModalTitle"></span>
            </h4>
        </div>
        <form method="post" id="editForm" enctype="multipart/form-data"
                style="display:flex;flex-direction:column;flex:1;min-height:0;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="VehicleId" id="editVehicleId" />
            <div class="modal-body-custom">
                <label class="form-label-custom" data-i18n="Vehicle Code">Vehicle Code</label>
                <input name="VehicleCode" id="editVehicleCode" class="form-input-custom" required maxlength="20" />
                
                <label class="form-label-custom" data-i18n="Vehicle Name">Vehicle Name</label>
                <input name="VehicleName" id="editVehicleName" class="form-input-custom" required maxlength="100" />
                
                <label class="form-label-custom" data-i18n="Category">Category</label>
                <select name="CategoryId" id="editCategoryId" class="form-input-custom" required>
                    @if (categories != null)
                    {
                        foreach (var c in categories)
                        {
                            <option value="@c.CategoryId"
                                    data-catname="@c.CategoryName"
                                    data-price="₫@c.PricePerMinute.ToString("N0")/min">
                                @c.CategoryName (₫@c.PricePerMinute.ToString("N0")/min)
                            </option>
                        }
                    }
                </select>
                
                <label class="form-label-custom" data-i18n="Station">Station</label>
                <select name="StationId" id="editStationId" class="form-input-custom" required>
                    @if (stations != null)
                    {
                        foreach (var s in stations)
                        {
                            <option value="@s.StationId">@s.StationName (@s.CurrentInventory/@s.Capacity)</option>
                        }
                    }
                </select>
                
                <label class="form-label-custom" data-i18n="STATUS">Status</label>
                <select name="Status" id="editStatus" class="form-input-custom">
                    <option value="Available" data-i18n="Available">Available</option>
                    <option value="InTransit" data-i18n="In-Transit">In-Transit</option>
                    <option value="Maintenance" data-i18n="Maintenance">Maintenance</option>
                </select>
                <input type="hidden" name="RemoveImage" id="editRemoveImage" value="false" />
                <label class="form-label-custom">
                    <span data-i18n="Vehicle Photo">Vehicle Photo</span> 
                    <span style="color:var(--text-muted);font-weight:400;" data-i18n="(optional)">(optional)</span>
                </label>
                <div id="editCurrentImgWrap" style="display:none;margin-bottom:8px;">
                    <div style="font-size:11px;color:var(--text-muted);margin-bottom:4px;" data-i18n="Current photo:">Current photo:</div>
                    <div style="position:relative;display:inline-block;">
                        <img id="editCurrentImg" src="" alt="Current"
                             style="height:80px;border-radius:10px;border:1.5px solid var(--border);object-fit:cover;" />
                        <button type="button"
                                style="position:absolute;top:4px;right:4px;width:20px;height:20px;border-radius:50%;background:rgba(0,0,0,0.55);color:white;border:none;cursor:pointer;font-size:11px;display:flex;align-items:center;justify-content:center;"
                                onclick="clearEditCurrentImage()">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>
                <div class="img-upload-box" id="editUploadBox">
                    <input type="file" name="ImageFile" id="editImageFile" accept="image/*"
                           onchange="previewImage(this,'editPreviewWrap','editPreviewImg','editUploadBox')" />
                    <div class="upload-icon"><i class="fas fa-cloud-upload-alt"></i></div>
                    <div class="upload-text" data-i18n="Click or drag to replace photo">Click or drag to replace photo</div>
                    <div class="upload-hint" data-i18n="JPG, PNG, WEBP · max 5MB">JPG, PNG, WEBP · max 5MB</div>
                </div>
                <div class="img-preview-wrap" id="editPreviewWrap">
                    <img id="editPreviewImg" src="" alt="New Preview" />
                    <button type="button" class="img-preview-remove" onclick="clearEditNewImage()">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            </div>
            <div style="padding:0 24px 24px;flex-shrink:0;">
                <div class="modal-footer-custom">
                    <button type="button" class="btn-cancel" onclick="closeModal('editModal')" data-i18n="Cancel">Cancel</button>
                    <button type="submit" class="btn-save">
                        <i class="fas fa-save" style="margin-right:5px;"></i>
                        <span data-i18n="Save Changes">Save Changes</span>
                    </button>
                </div>
            </div>
        </form>
    </div>

</div>

<script>
    function openEditModal(id, code, name, catId, stationId, status, imageUrl) {
        document.getElementById('editVehicleId').value = id;
        document.getElementById('editVehicleCode').value = code;
        document.getElementById('editVehicleName').value = name;
        document.getElementById('editCategoryId').value = catId;
        document.getElementById('editStationId').value = stationId;
        document.getElementById('editStatus').value = status;
        document.getElementById('editModalTitle').textContent = code;
        document.getElementById('editForm').action = `/Vehicle/Edit/${id}`;
        document.getElementById('editRemoveImage').value = 'false';
        document.getElementById('editPreviewWrap').style.display = 'none';
        document.getElementById('editUploadBox').style.display = 'block';
        document.getElementById('editImageFile').value = '';
         const imgWrap = document.getElementById('editCurrentImgWrap');
        if (imageUrl && imageUrl.trim() !== '') {
            document.getElementById('editCurrentImg').src = imageUrl;
            imgWrap.style.display = 'block';
        } else {
            imgWrap.style.display = 'none';
        }
        openModal('editModal');
    }

    function clearEditCurrentImage() {
        document.getElementById('editCurrentImgWrap').style.display = 'none';
        document.getElementById('editRemoveImage').value = 'true';
    }

    function clearEditNewImage() {
        document.getElementById('editPreviewWrap').style.display = 'none';
        document.getElementById('editUploadBox').style.display = 'block';
        document.getElementById('editImageFile').value = '';
    }
</script>