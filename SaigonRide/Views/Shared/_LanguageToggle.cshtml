    let _lang = localStorage.getItem('sr_lang') || 'en';

    function applyLang(lang) {
        document.querySelectorAll('[data-i18n]').forEach(el => {
            const k = el.getAttribute('data-i18n');
            el.textContent = (lang === 'vi' && T[k]) ? T[k] : k;
        });
        document.querySelectorAll('[data-i18n-placeholder]').forEach(el => {
            const k = el.getAttribute('data-i18n-placeholder');
            el.placeholder = (lang === 'vi' && T[k]) ? T[k] : k;
        });
        document.querySelectorAll('option[data-i18n]').forEach(el => {
            const k = el.getAttribute('data-i18n');
            const prefix = el.getAttribute('data-i18n-prefix') || '';
            el.textContent = prefix + ((lang === 'vi' && T[k]) ? T[k] : k);
        });
        document.querySelectorAll('[data-vi][data-en]').forEach(el => {
            const val = el.getAttribute('data-' + lang);
            if (!val) return;
            if (el.tagName === 'INPUT') el.placeholder = val;
            else el.innerHTML = val;
        });
        document.querySelectorAll('[data-placeholder-' + lang + ']').forEach(el => {
            el.placeholder = el.getAttribute('data-placeholder-' + lang);
        });
        document.querySelectorAll('option[data-catname]').forEach(opt => {
            const name = opt.getAttribute('data-catname');
            const price = opt.getAttribute('data-price');
            const translated = (lang === 'vi' && T[name]) ? T[name] : name;
            opt.textContent = `${translated} (${price})`;
        });

        const a = document.getElementById('lp-a');
        const b = document.getElementById('lp-b');
        const f1 = document.getElementById('lp-flag1');
        const f2 = document.getElementById('lp-flag2');
        if (lang === 'vi') {
            if (a) { a.textContent = 'VI'; a.className = 'lp-active'; }
            if (b) { b.textContent = 'EN'; b.className = 'lp-inactive'; }
            if (f1) f1.textContent = '🇻🇳';
            if (f2) f2.textContent = '🇬🇧';
        } else {
            if (a) { a.textContent = 'EN'; a.className = 'lp-active'; }
            if (b) { b.textContent = 'VI'; b.className = 'lp-inactive'; }
            if (f1) f1.textContent = '🇬🇧';
            if (f2) f2.textContent = '🇻🇳';
        }
        document.documentElement.lang = lang;
        if (typeof goToPage === 'function') goToPage(currentPage);

        const alertMap = {
            "Please fill in all required fields.": "Vui lòng điền đầy đủ thông tin.",
            "Vehicle deleted successfully.": "Xóa phương tiện thành công.",
            "Station deleted successfully.": "Xóa trạm thành công.",
            "Station not found!": "Không tìm thấy trạm.",
            "No stations selected for update.": "Chưa chọn trạm nào để cập nhật.",
            "Cannot delete vehicle in active rental.": "Không thể xóa phương tiện đang được thuê.",
            "Station is full. Cannot add vehicle.": "Trạm đã đầy. Không thể thêm xe.",
            "New station is full.": "Trạm đích đã đầy.",
            "Vehicle not found.": "Không tìm thấy phương tiện.",
            "Cannot delete station with vehicles assigned.": "Không thể xóa trạm đang còn xe.",
            "Profile updated successfully.": "Cập nhật hồ sơ thành công.",
            "Password changed successfully.": "Đổi mật khẩu thành công.",
            "Current password is incorrect.": "Mật khẩu hiện tại không đúng.",
            "New passwords do not match.": "Mật khẩu mới không khớp.",
            "Notification settings saved.": "Đã lưu cài đặt thông báo.",
            "Avatar updated successfully.": "Cập nhật ảnh đại diện thành công.",
        };

        const alertRegex = [
            { pattern: /Vehicle '(.+)' created successfully!/, vi: (m) => `Thêm phương tiện '${m[1]}' thành công!` },
            { pattern: /Vehicle '(.+)' updated successfully!/, vi: (m) => `Cập nhật phương tiện '${m[1]}' thành công!` },
            { pattern: /Station '(.+)' created successfully!/, vi: (m) => `Thêm trạm '${m[1]}' thành công!` },
            { pattern: /Station '(.+)' updated successfully!/, vi: (m) => `Cập nhật trạm '${m[1]}' thành công!` },
            { pattern: /Successfully updated (\d+) stations to '(.+)'!/, vi: (m) => `Đã cập nhật ${m[1]} trạm sang trạng thái '${m[2]}' thành công!` },
        ];

        document.querySelectorAll('.alert-custom').forEach(el => {
            const icon = el.querySelector('i');
            if (!el.getAttribute('data-orig')) {
                el.setAttribute('data-orig', el.textContent.trim());
            }

            const rawText = el.getAttribute('data-orig');

            if (lang === 'vi') {
                const exactKey = Object.keys(alertMap).find(k => rawText.includes(k));
                if (exactKey) {
                    el.textContent = ' ' + alertMap[exactKey];
                    if (icon) el.prepend(icon);
                    return;
                }
                for (const { pattern, vi } of alertRegex) {
                    const m = rawText.match(pattern);
                    if (m) {
                        el.textContent = ' ' + vi(m);
                        if (icon) el.prepend(icon);
                        return;
                    }
                }
            } else {
                el.textContent = ' ' + rawText;
                if (icon) el.prepend(icon);
            }
        });
    }

    function toggleLang() {
        _lang = _lang === 'en' ? 'vi' : 'en';
        localStorage.setItem('sr_lang', _lang);
        applyLang(_lang);
    }

    function setAppLang(lang) {
        _lang = lang;
        localStorage.setItem('sr_lang', lang);
        applyLang(lang);
    }

    document.addEventListener('DOMContentLoaded', () => {
        const saved = localStorage.getItem('sr_lang') || 'en';
        _lang = saved;
        applyLang(saved);
    });
</script>
