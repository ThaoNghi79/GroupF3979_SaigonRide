@model IEnumerable<SaigonRide.Models.User>
@{
    ViewData["Title"] = "User Management";
    ViewData["Page"] = "users";
}

@section Styles {
    <style>
        .page-banner-plain {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            margin-bottom: 18px;
        }

        .page-banner-plain h1 {
            font-size: 22px;
            font-weight: 800;
            color: var(--text-main);
        }

        .page-banner-plain .sub {
            font-size: 13px;
            color: var(--text-muted);
            margin-top: 3px;
            font-weight: 500;
        }

        .stat-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 14px;
            margin-bottom: 18px;
        }

        .stat-mini {
            background: white;
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 16px 20px;
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .stat-mini-icon {
            width: 40px;
            height: 40px;
            border-radius: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 17px;
            flex-shrink: 0;
        }

        .stat-mini-val {
            font-size: 24px;
            font-weight: 800;
            color: var(--text-main);
            line-height: 1;
        }

        .stat-mini-label {
            font-size: 12px;
            color: var(--text-muted);
            font-weight: 500;
            margin-top: 3px;
        }

        .filter-bar-plain {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 14px;
            flex-wrap: wrap;
        }

        .flabel {
            font-size: 13px;
            color: var(--text-muted);
            font-weight: 500;
        }

        .fdrop {
            padding: 7px 28px 7px 12px;
            border: 1px solid var(--border);
            border-radius: 8px;
            background: white;
            font-size: 13px;
            font-weight: 600;
            color: var(--text-main);
            cursor: pointer;
            appearance: none;
            background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 10 6%22><path d=%22M1 1l4 4 4-4%22 stroke=%22%238b80a8%22 stroke-width=%221.4%22 fill=%22none%22/></svg>');
            background-repeat: no-repeat;
            background-position: right 10px center;
            background-size: 10px;
            transition: all 0.15s;
        }

        .fdrop:hover { border-color: var(--primary); }

        .fsearch {
            flex: 1;
            position: relative;
        }

        .fsearch input {
            width: 100%;
            padding: 8px 14px 8px 34px;
            border: 1px solid var(--border);
            border-radius: 8px;
            font-size: 13px;
            font-family: inherit;
            outline: none;
        }

        .fsearch input:focus { border-color: var(--primary); }

        .fsearch .si {
            position: absolute;
            left: 11px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 12px;
        }

        .vtable-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 1px 4px rgba(0,0,0,0.04);
        }

        .vtable-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px 20px 12px;
            border-bottom: 1px solid var(--border);
        }

        .vtable-head h3 {
            font-size: 14px;
            font-weight: 700;
            color: var(--text-main);
        }

        .vtable {
            width: 100%;
            border-collapse: collapse;
        }

        .vtable th {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--text-muted);
            padding: 10px 16px;
            border-bottom: 1px solid var(--border);
            text-align: left;
        }

        .vtable td {
            padding: 12px 16px;
            border-bottom: 1px solid var(--border);
            font-size: 13px;
            vertical-align: middle;
        }

        .vtable tr:last-child td { border-bottom: none; }
        .vtable tr:hover td { background: #faf8ff; }
        .vtable tr.locked-row td { background: #fff8f8; }

        .user-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            object-fit: cover;
            border: 1.5px solid var(--border);
        }

        .user-avatar-placeholder {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: var(--gradient);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 12px;
            font-weight: 700;
            flex-shrink: 0;
        }

        .user-avatar-placeholder.locked {
            background: #ccc;
        }

        .role-pill {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 11.5px;
            font-weight: 600;
        }

        .role-local {
            background: #ede9fa;
            color: var(--primary-text);
        }

        .role-tourist {
            background: rgba(255,212,163,0.35);
            color: #b86d2a;
        }

        .passport-pill {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 9px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
        }

        .pp-verified { background: #d4f5e2; color: #276749; }
        .pp-unverified { background: #fdd8d8; color: #a33030; }
        .pp-na { background: #f5f3ff; color: var(--text-muted); }

        .wallet-val {
            font-weight: 700;
            color: var(--primary-text);
            font-size: 13px;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 9px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
        }

        .status-active { background: #d4f5e2; color: #276749; }
        .status-locked { background: #fdd8d8; color: #a33030; }

        .act-btn {
            width: 28px;
            height: 28px;
            border-radius: 7px;
            border: 1px solid var(--border);
            background: white;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 12px;
            transition: all 0.15s;
        }

        .act-btn.lock { color: var(--danger); }
        .act-btn.lock:hover { background: #fdd8d8; }
        .act-btn.unlock { color: #276749; }
        .act-btn.unlock:hover { background: #d4f5e2; }

        .pag-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 16px;
            border-top: 1px solid var(--border);
        }

        .pag-info { font-size: 12px; color: var(--text-muted); }
        .pag-btns { display: flex; gap: 4px; }

        .pag-btn {
            width: 28px;
            height: 28px;
            border: 1px solid var(--border);
            border-radius: 7px;
            background: white;
            font-size: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-family: inherit;
            transition: all 0.15s;
        }

        .pag-btn.active {
            background: var(--gradient);
            color: var(--text-main);
            border-color: transparent;
            font-weight: 700;
        }
    </style>
}

<div class="page-banner-plain">
    <div>
        <h1 data-i18n="User Management">User Management</h1>
        <div class="sub" data-i18n="View all registered commuters and tourists">
            View all registered commuters and tourists
        </div>
    </div>
</div>

<div class="stat-row">
    <div class="stat-mini">
        <div class="stat-mini-icon" style="background:#ede9fa;">
            <i class="fas fa-users" style="color:var(--primary-text);"></i>
        </div>
        <div>
            <div class="stat-mini-val">@Model.Count()</div>
            <div class="stat-mini-label" data-i18n="Total Users">Total Users</div>
        </div>
    </div>
    <div class="stat-mini">
        <div class="stat-mini-icon" style="background:#f0eaff;">
            <i class="fas fa-user" style="color:var(--primary-text);"></i>
        </div>
        <div>
            <div class="stat-mini-val">@ViewBag.TotalLocal</div>
            <div class="stat-mini-label" data-i18n="Local Commuters">Local Commuters</div>
        </div>
    </div>
    <div class="stat-mini">
        <div class="stat-mini-icon" style="background:rgba(255,212,163,0.35);">
            <i class="fas fa-passport" style="color:#b86d2a;"></i>
        </div>
        <div>
            <div class="stat-mini-val">@ViewBag.TotalTourist</div>
            <div class="stat-mini-label" data-i18n="Foreign Tourists">Foreign Tourists</div>
        </div>
    </div>
</div>

<div class="filter-bar-plain">
    <span class="flabel" data-i18n="Filter by:">Filter by:</span>
    <select class="fdrop" id="filterRole" onchange="applyFilter()">
        <option value="" data-i18n="All Roles">All Roles</option>
        <option value="LocalCommuter" data-i18n="Local Commuter">Local Commuter</option>
        <option value="ForeignTourist" data-i18n="Foreign Tourist">Foreign Tourist</option>
    </select>
    <select class="fdrop" id="filterStatus" onchange="applyFilter()">
        <option value="" data-i18n="All Status">All Status</option>
        <option value="active" data-i18n="Active">Active</option>
        <option value="locked" data-i18n="Locked">Locked</option>
    </select>
    <div class="fsearch">
        <i class="fas fa-search si"></i>
        <input type="text" id="searchInput"
               data-i18n-placeholder="Search name or email..."
               placeholder="Search name or email..."
               oninput="applyFilter()" />
    </div>
</div>

<div class="vtable-card">
    <div class="vtable-head">
        <h3 data-i18n="All Users">All Users</h3>
        <span style="font-size:12.5px;color:var(--text-muted);" id="showingCount">
            Showing @Model.Count() users
        </span>
    </div>

    <div style="overflow-x:auto;">
        <table class="vtable" id="userTable">
            <thead>
                <tr>
                    <th style="width:50px;" data-i18n="Avatar">Avatar</th>
                    <th data-i18n="Full Name">Full Name</th>
                    <th data-i18n="Email">Email</th>
                    <th data-i18n="Role">Role</th>
                    <th data-i18n="Wallet Balance">Wallet Balance</th>
                    <th data-i18n="Passport">Passport</th>
                    <th data-i18n="Status">Status</th>
                    <th style="text-align:center;" data-i18n="Actions">Actions</th>
                </tr>
            </thead>
            <tbody id="userBody">
                @foreach (var u in Model)
                {
                    var initials = string.Concat(
                        u.FullName.Split(' ')
                            .Where(w => w.Length > 0)
                            .Take(2)
                            .Select(w => w[0])
                    ).ToUpper();

                    <tr data-role="@u.Role.ToString()"
                        data-status="@(u.IsLocked ? "locked" : "active")"
                        data-name="@u.FullName.ToLower() @u.Email.ToLower()"
                        class="@(u.IsLocked ? "locked-row" : "")">
                        <td>
                            @if (!string.IsNullOrEmpty(u.AvatarUrl))
                            {
                                <img src="@u.AvatarUrl" class="user-avatar" alt="@u.FullName"
                                     style="@(u.IsLocked ? "opacity:0.5;" : "")" />
                            }
                            else
                            {
                                <span class="user-avatar-placeholder @(u.IsLocked ? "locked" : "")">@initials</span>
                            }
                        </td>
                        <td style="font-weight:600;@(u.IsLocked ? "color:var(--text-muted);" : "")">
                            @u.FullName
                        </td>
                        <td style="color:var(--text-muted);">@u.Email</td>
                        <td>
                            @if (u.Role == SaigonRide.Models.UserRole.LocalCommuter)
                            {
                                <span class="role-pill role-local">
                                    <i class="fas fa-user" style="font-size:10px;"></i>
                                    <span data-i18n="Local Commuter">Local Commuter</span>
                                </span>
                            }
                            else
                            {
                                <span class="role-pill role-tourist">
                                    <i class="fas fa-passport" style="font-size:10px;"></i>
                                    <span data-i18n="Foreign Tourist">Foreign Tourist</span>
                                </span>
                            }
                        </td>
                        <td>
                            <span class="wallet-val">₫ @u.WalletBalance.ToString("N0")</span>
                        </td>
                        <td>
                            @if (u.Role == SaigonRide.Models.UserRole.ForeignTourist)
                            {
                                if (u.IsPassportVerified)
                                {
                                    <span class="passport-pill pp-verified">
                                        <i class="fas fa-check-circle"></i> @u.PassportNumber
                                    </span>
                                }
                                else
                                {
                                    <span class="passport-pill pp-unverified">
                                        <i class="fas fa-times-circle"></i> <span data-i18n="Unverified">Unverified</span>
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="passport-pill pp-na">N/A</span>
                            }
                        </td>
                        <td>
                            @if (u.IsLocked)
                            {
                                <span class="status-badge status-locked">
                                    <i class="fas fa-lock" style="font-size:10px;"></i> <span data-i18n="Locked">Locked</span>
                                </span>
                            }
                            else
                            {
                                <span class="status-badge status-active">
                                    <i class="fas fa-check-circle" style="font-size:10px;"></i> <span data-i18n="Active">Active</span>
                                </span>
                            }
                        </td>
                        <td style="text-align:center;">
                            @if (u.IsLocked)
                            {
                                <form method="post" action="/UserManagement/UnlockUser/@u.UserId" style="display:inline;"
                                    onsubmit="return confirmAction('unlock', '@Html.Raw(u.FullName)')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="act-btn unlock" title="Unlock">
                                        <i class="fas fa-unlock"></i>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form method="post" action="/UserManagement/LockUser/@u.UserId" style="display:inline;"
                                    onsubmit="return confirmAction('lock', '@Html.Raw(u.FullName)')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="act-btn lock" title="Lock">
                                        <i class="fas fa-lock"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="pag-bar">
        <div class="pag-info" id="pagInfo">Page 1 of 1</div>
        <div class="pag-btns" id="pagBtns"></div>
    </div>
</div>

@section Scripts {
    <script>
        const PAGE_SIZE = 8;
        let currentPage = 1;
        let allRows = [];

        function initPagination() {
            allRows = [...document.querySelectorAll('#userBody tr')];
            allRows.forEach(r => r.dataset.filtered = 'true');
            goToPage(1);
        }

        function getFiltered() {
            return allRows.filter(r => r.dataset.filtered !== 'false');
        }

        function goToPage(page) {
            const rows = getFiltered();
            const totalPages = Math.max(1, Math.ceil(rows.length / PAGE_SIZE));
            currentPage = Math.min(Math.max(1, page), totalPages);
            allRows.forEach(r => r.style.display = 'none');
            const start = (currentPage - 1) * PAGE_SIZE;
            rows.slice(start, start + PAGE_SIZE).forEach(r => r.style.display = '');
            const showing = Math.min(PAGE_SIZE, rows.length - start);
            const isVi = (localStorage.getItem('sr_lang') || 'en') === 'vi';
            document.getElementById('pagInfo').textContent = isVi
                ? `Trang ${currentPage} / ${totalPages} — ${rows.length} người dùng`
                : `Page ${currentPage} of ${totalPages} — ${rows.length} users`;
            document.getElementById('showingCount').textContent = isVi
                ? `Hiển thị ${showing} / ${rows.length} người dùng`
                : `Showing ${showing} of ${rows.length} users`;
            renderPagBtns(currentPage, totalPages);
        }

        function renderPagBtns(cur, total) {
            const c = document.getElementById('pagBtns');
            c.innerHTML = '';
            const mkBtn = (html, page, active) => {
                const b = document.createElement('button');
                b.className = 'pag-btn' + (active ? ' active' : '');
                b.innerHTML = html;
                if (page && page >= 1 && page <= total) b.onclick = () => goToPage(page);
                else b.disabled = true;
                return b;
            };
            c.appendChild(mkBtn('<i class="fas fa-chevron-left" style="font-size:10px;"></i>', cur - 1));
            const pages = new Set([1, total]);
            for (let i = Math.max(1, cur - 1); i <= Math.min(total, cur + 1); i++) pages.add(i);
            let prev = 0;
            [...pages].sort((a, b) => a - b).forEach(p => {
                if (p - prev > 1) {
                    const sp = document.createElement('span');
                    sp.textContent = '…';
                    sp.style.cssText = 'padding:0 4px;color:var(--text-muted);line-height:28px;';
                    c.appendChild(sp);
                }
                c.appendChild(mkBtn(p, p, p === cur));
                prev = p;
            });
            c.appendChild(mkBtn('<i class="fas fa-chevron-right" style="font-size:10px;"></i>', cur + 1));
        }

        function applyFilter() {
            const role = document.getElementById('filterRole').value;
            const status = document.getElementById('filterStatus').value;
            const search = document.getElementById('searchInput').value.toLowerCase();
            allRows.forEach(row => {
                const match =
                    (!role || row.dataset.role === role) &&
                    (!status || row.dataset.status === status) &&
                    (!search || (row.dataset.name || '').includes(search));
                row.dataset.filtered = match ? 'true' : 'false';
            });
            goToPage(1);
        }

        function confirmAction(type, name) {
            const isVi = (localStorage.getItem('sr_lang') || 'en') === 'vi';
            if (type === 'lock') {
                return confirm(isVi ? `Khóa tài khoản ${name}?` : `Lock account ${name}?`);
            } else {
                return confirm(isVi ? `Mở khóa tài khoản ${name}?` : `Unlock account ${name}?`);
            }
        }

        document.addEventListener('DOMContentLoaded', initPagination);
    </script>
}
